---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ElleAssistant from "../components/ElleAssistant.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  datePublished?: string;
  dateModified?: string;
  type?: "website" | "article";
}

const {
  title,
  description,
  ogImage = "/og-image.png",
  datePublished,
  dateModified,
  type = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://oryele.ai');
const ogImageURL = new URL(ogImage, 'https://oryele.ai');

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Oryele",
  "url": "https://oryele.ai",
  "logo": "https://oryele.ai/logo-dark.png",
  "description": "AI-powered workflow automation and digital workers platform for professional services firms.",
  "email": "info@oryele.com",
  "sameAs": [
    "https://www.linkedin.com/company/oryele",
    "https://www.youtube.com/@Oryele"
  ],
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "email": "support@oryele.com",
      "contactType": "customer support"
    },
    {
      "@type": "ContactPoint",
      "email": "sales@oryele.com",
      "contactType": "sales"
    }
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Oryele",
  "url": "https://oryele.ai",
};

const pathParts = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "Home", item: "https://oryele.ai/" },
  ...pathParts.map((part, index) => ({
    "@type": "ListItem",
    position: index + 2,
    name: part.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()),
    item: `https://oryele.ai/${pathParts.slice(0, index + 1).join("/")}/`,
  })),
];
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#0a1428" />
    <meta name="color-scheme" content="light" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.png" type="image/png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Oryele" />
    <meta property="og:locale" content="en_US" />
    {datePublished && <meta property="article:published_time" content={datePublished} />}
    {dateModified && <meta property="article:modified_time" content={dateModified} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:site" content="@oryele" />

    <link rel="alternate" hreflang="en-US" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="/logo-light.png" as="image" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  </head>
  <body>
    <a href="#main-content" class="skip-nav">Skip to main content</a>
    <Navbar />
    <main id="main-content"><slot /></main>
    <Footer />
    <ElleAssistant />
    <script>
      const observer = new IntersectionObserver(
        (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }),
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

      if (window.location.pathname.startsWith('/resources/help-center')) {
        document.documentElement.classList.add('help-center-page');

        document.getElementById('ai-panel')?.remove();
        document.querySelector('.ai-toggle')?.remove();

        const openGlobalElle = (event) => {
          event.preventDefault();
          const launcher = document.querySelector('[data-elle] .elle-launcher');
          if (launcher instanceof HTMLElement) launcher.click();
        };
        document.querySelectorAll('a[href="#ai-assistant"], #nav-ai-link').forEach((link) => {
          link.addEventListener('click', openGlobalElle);
        });

        const submit = document.getElementById('fb-submit');
        if (submit) {
          submit.addEventListener('click', async (event) => {
            event.preventDefault();
            event.stopImmediatePropagation();

            const message = document.getElementById('fb-message');
            const name = document.getElementById('fb-name');
            const email = document.getElementById('fb-email');
            const contact = document.getElementById('fb-contact');
            const success = document.getElementById('fb-success');
            const formBody = document.getElementById('fb-form-body');
            const activeType = document.querySelector('.ftype-btn.is-active');
            const selectedRating = document.querySelector('.star.selected:last-of-type');

            if (!(message instanceof HTMLTextAreaElement) || !message.value.trim()) {
              message?.focus();
              return;
            }

            const button = submit;
            button.setAttribute('disabled', 'true');
            button.textContent = 'Sending...';

            const data = new FormData();
            data.append('_subject', `Help Center Feedback: ${activeType?.getAttribute('data-type') || 'general'}`);
            data.append('_captcha', 'false');
            data.append('Name', name instanceof HTMLInputElement && name.value.trim() ? name.value.trim() : 'Anonymous');
            data.append('Email', email instanceof HTMLInputElement && email.value.trim() ? email.value.trim() : 'Not provided');
            data.append('Type', activeType?.getAttribute('data-type') || 'general');
            data.append('Rating', `${selectedRating?.getAttribute('data-value') || 'not rated'} stars`);
            data.append('Message', message.value.trim());
            data.append('Open to contact', contact instanceof HTMLInputElement && contact.checked ? 'Yes' : 'No');
            data.append('Page', window.location.href);

            try {
              await fetch('https://formsubmit.co/info@oryele.com', {
                method: 'POST',
                mode: 'no-cors',
                body: data,
              });
              if (formBody instanceof HTMLElement) formBody.style.display = 'none';
              success?.classList.remove('fb-success--hidden');
            } catch (error) {
              button.removeAttribute('disabled');
              button.innerHTML = 'Send Feedback <span aria-hidden="true">→</span>';
              window.location.href = `mailto:support@oryele.com?subject=${encodeURIComponent('Oryele Help Center Feedback')}&body=${encodeURIComponent(message.value.trim())}`;
            }
          }, true);
        }
      }
    </script>
  </body>
</html>

<style>
  .skip-nav { position:absolute; top:-100%; left:0; padding:12px 20px; background:var(--blue); color:#fff; font-weight:700; text-decoration:none; z-index:9999; border-radius:0 0 8px 0; }
  .skip-nav:focus { top:0; }

  :global(.help-center-page .hc-hero) { padding-block: 42px 46px !important; }
  :global(.help-center-page .hc-hero .lede) { margin-bottom: 22px !important; }
  :global(.help-center-page .hc-search-wrap) { margin-bottom: 18px !important; }
  :global(.help-center-page .hc-pillars) { padding-block: 28px !important; }
  :global(.help-center-page .hc-body) { padding-top: 42px !important; }
  @media (max-width: 760px) {
    :global(.help-center-page .hc-hero) { padding-block: 34px 38px !important; }
    :global(.help-center-page .hc-pillars) { padding-block: 22px !important; }
    :global(.help-center-page .hc-body) { padding-top: 30px !important; }
  }
</style>