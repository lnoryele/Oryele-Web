---
interface Props { icon: string; size?: number }
const { icon, size = 24 } = Astro.props;
---
<svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
  {icon === "person" && <g><circle cx="12" cy="8" r="3.5"/><path d="M5 20c1-4 4.2-5.5 7-5.5S18 16 19 20"/></g>}
  {icon === "nodes" && <g><circle cx="6" cy="6" r="2.4"/><circle cx="18" cy="6" r="2.4"/><circle cx="6" cy="18" r="2.4"/><circle cx="18" cy="18" r="2.4"/><path d="M8.4 6h7.2M6 8.4v7.2M18 8.4v7.2M8.4 18h7.2"/></g>}
  {icon === "chat" && <g><rect x="3" y="5" width="15" height="11" rx="2.5"/><path d="M7 20l3.5-4M8 9h6M8 12h4"/></g>}
  {icon === "doc" && <g><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M10 12h5M10 15h5"/></g>}
  {icon === "shield" && <g><path d="M12 3l7 3v5c0 4.8-3 8-7 10-4-2-7-5.2-7-10V6l7-3z"/><path d="M9.2 12l2 2 3.6-3.8"/></g>}
  {icon === "chart" && <g><path d="M4 20h16"/><path d="M7 20v-6M12 20V9M17 20v-9"/><path d="M6 10l5-4 3 2 5-4"/></g>}
</svg>
