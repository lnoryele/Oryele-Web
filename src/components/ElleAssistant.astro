---
import './elle/elle.css';
---

<div class="elle" data-elle>
  <button class="elle-launcher" type="button" aria-label="Open Ask Elle" aria-expanded="false">
    <span class="elle-avatar elle-avatar--launcher"><img src="/elle-avatar-v5.png" alt="" /></span>
    <span class="elle-launcher-copy"><strong>Ask Elle</strong></span>
  </button>

  <section class="elle-panel" aria-label="Ask Elle" aria-hidden="true">
    <header class="elle-header">
      <div class="elle-brand">
        <span class="elle-avatar elle-avatar--header"><img src="/elle-avatar-v5.png" alt="Elle" /></span>
        <span class="elle-brand-copy">
          <strong>Ask Elle</strong>
          <small><span data-elle-context>Oryele Executive Ask Elle</span></small>
        </span>
      </div>
      <div class="elle-header-actions">
        <button type="button" data-elle-new aria-label="Start a new conversation">＋</button>
        <button type="button" data-elle-close aria-label="Close Ask Elle">×</button>
      </div>
    </header>

    <div class="elle-body">
      <div class="elle-welcome" data-elle-welcome>
        <span class="elle-avatar elle-avatar--welcome"><img src="/elle-avatar-v5.png" alt="Elle" /></span>
        <span class="elle-eyebrow">Your Oryele digital colleague</span>
        <h2>How can Elle help?</h2>
        <p data-elle-intro>Ask about Oryele, its capabilities, security, workflows, or digital workers.</p>
        <div class="elle-prompts">
          <button data-prompt="What can Oryele automate for an accounting firm?">Explore automation</button>
          <button data-prompt="Explain how the Oryele Workflow Engine works.">Workflow Engine</button>
          <button data-prompt="What are Oryele Digital Workers?">Digital Workers</button>
          <button data-prompt="How does Oryele protect customer data?">Security</button>
        </div>
      </div>
      <div class="elle-messages" data-elle-messages aria-live="polite"></div>
    </div>

    <footer class="elle-footer">
      <form class="elle-composer" data-elle-form>
        <textarea data-elle-input rows="1" maxlength="2000" placeholder="Ask Elle anything about Oryele…" aria-label="Message Elle"></textarea>
        <button type="button" data-elle-stop class="elle-stop" aria-label="Stop generating" hidden>■</button>
        <button type="submit" class="elle-send" aria-label="Send message" disabled>➤</button>
      </form>
      <p><span data-elle-status>Elle can make mistakes. Verify important information.</span><b>Hudson · Elle v4.0</b></p>
    </footer>
  </section>
</div>

<script src="./elle/elle.js"></script>
