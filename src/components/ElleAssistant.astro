elcome{padding:30px 22px;text-align:center}.elle-welcome-orb{width:54px;height:54px;margin:0 auto 14px;border-radius:18px}.elle-welcome h2{margin:0;font-size:22px}.elle-welcome p{margin:8px auto 18px;max-width:320px;color:#66758d;font-size:12px;line-height:1.5}.elle-prompts{display:grid;grid-template-columns:1fr 1fr;gap:8px}.elle-prompts button{padding:11px;border:1px solid #dfe7f3;border-radius:12px;background:#fff;color:#244f9e;font-size:11px;cursor:pointer}.elle-messages{padding:0 16px 18px}.elle-turn{padding:16px 0;border-bottom:1px solid #e5ebf3}.elle-turn-head{display:flex;align-items:center;gap:8px;font-size:11px}.elle-turn-head strong{font-size:12px}.elle-turn-head time{color:#7787a0}.elle-user-icon,.elle-mini-orb{width:24px;height:24px;border-radius:8px}.elle-user-icon{display:grid;place-items:center;background:#eef2f8;color:#17325c;font-size:8px}.elle-mini-orb{font-size:10px}.elle-user-text{margin:8px 0 0 32px;color:#16263f;font-size:12px;line-height:1.45}.elle-answer{margin:10px 0 0 32px}.elle-answer-content{color:#17263f;font-size:11.5px;line-height:1.55}.elle-answer-content p{margin:0 0 9px}.elle-answer-content p:last-child{margin-bottom:0}.elle-answer-content h2,.elle-answer-content h3,.elle-answer-content h4{display:flex;align-items:center;gap:7px;margin:13px 0 7px;color:#10213d}.elle-answer-content h2{font-size:14px}.elle-answer-content h3{font-size:13px}.elle-answer-content h4{font-size:12px}.elle-answer-content h2 span,.elle-answer-content h3 span,.elle-answer-content h4 span{color:#3565d5}.elle-answer-content ul{margin:7px 0;padding-left:18px}.elle-answer-content li{margin:4px 0}.elle-answer-content pre{overflow:auto;padding:9px;border-radius:8px;background:#0e1b2e;color:#eef4ff;font-size:10px}.elle-answer-content code{padding:1px 4px;border-radius:4px;background:#edf2f8}.elle-answer-content a{color:#2d5fc5}.elle-collapsible.is-collapsed .elle-answer-content{max-height:240px;overflow:hidden;mask-image:linear-gradient(#000 70%,transparent)}.elle-collapsible>[data-expand]{margin-top:8px;padding:0;border:0;background:none;color:#2e5fbd;font-size:10.5px;font-weight:700;cursor:pointer}.elle-citations{margin:12px 0 0 32px}.elle-citations>strong{display:block;margin-bottom:7px;font-size:10.5px}.elle-citations>div{display:flex;flex-wrap:wrap;gap:6px}.elle-citations a{padding:6px 8px;border:1px solid #d9e3f2;border-radius:8px;background:#f8faff;color:#2d5fc5;text-decoration:none;font-size:9.5px}.elle-tools{display:flex;align-items:center;flex-wrap:wrap;gap:3px;margin:12px 0 0 32px;padding-top:9px;border-top:1px solid #edf1f6}.elle-tools button{padding:5px 7px;border:0;background:none;color:#61718a;font-size:9.5px;cursor:pointer}.elle-tools button:hover{color:#285ab6;background:#f1f5fb;border-radius:6px}.elle-tools time{margin-left:auto;color:#8a98ab;font-size:9px}.elle-thinking{font-size:11px;color:#7b8ba2;font-style:italic}.elle-cursor{display:inline-block;width:2px;height:1em;margin-left:3px;vertical-align:-2px;background:#2e5fc5;animation:blink .8s step-end infinite}@keyframes blink{50%{opacity:0}}.elle-followups{margin:14px 0 0 32px;padding:11px;border:1px solid #dce6f3;border-radius:12px;background:#f8faff}.elle-followups>strong{font-size:10.5px}.elle-followups>div{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}.elle-followups button{padding:7px 9px;border:1px solid #d5e0f0;border-radius:999px;background:#fff;color:#2d5fc5;font-size:9.5px;cursor:pointer}.elle-error{margin:14px;padding:10px;border-radius:9px;background:#fff4f4;color:#9b3030;font-size:11px}.elle-footer{padding:10px 12px 8px;border-top:1px solid #e4ebf4;background:#fff}.elle-composer{display:flex;align-items:flex-end;gap:7px;padding:7px 7px 7px 11px;border:1.5px solid #5d88e6;border-radius:14px;box-shadow:0 0 0 3px rgba(65,111,207,.08)}.elle-composer textarea{flex:1;min-height:22px;max-height:120px;padding:4px 0;border:0;outline:0;resize:none;color:#17263f;font:11.5px/1.45 Inter,system-ui,sans-serif}.elle-send,.elle-stop{display:grid;place-items:center;width:34px;height:34px;border:0;border-radius:10px;background:#0e315f;color:#fff;cursor:pointer}.elle-send:disabled{background:#dce4ef}.elle-footer>p{margin:6px 0 0;text-align:center;color:#98a5b7;font-size:8.5px}@media(max-width:600px){.elle{right:8px;bottom:8px}.elle-panel{position:fixed;inset:4px;width:auto;height:auto;border-radius:16px}.elle-answer-content{font-size:11px}.elle-prompts{grid-template-columns:1fr}.elle-tools time{width:100%;margin:3px 0 0 7px}.elle-followups{margin-left:0}}
</style>
