<div class="elle" data-elle>
  <button class="elle-launcher" type="button" aria-label="Open Elle AI assistant" aria-expanded="false">
    <span class="elle-orb">E</span><span><strong>Ask Elle</strong><small>Oryele AI</small></span><i></i>
  </button>

  <section class="elle-panel" aria-label="Elle AI assistant" aria-hidden="true">
    <header class="elle-header">
      <div class="elle-brand"><span class="elle-orb">E</span><span><strong>Elle</strong><small><i></i> Online</small></span></div>
      <div><button type="button" data-elle-new aria-label="New conversation">＋</button><button type="button" data-elle-close aria-label="Close Elle">×</button></div>
    </header>

    <div class="elle-body">
      <div class="elle-welcome" data-elle-welcome>
        <span class="elle-welcome-orb">E</span>
        <h2>How can Elle help?</h2>
        <p>Ask about Oryele, its capabilities, security, workflows, or digital workers.</p>
        <div class="elle-prompts">
          <button data-prompt="What can Oryele automate for an accounting firm?">Explore automation</button>
          <button data-prompt="Explain how the Oryele Workflow Engine works.">Workflow Engine</button>
          <button data-prompt="What are Oryele Digital Workers?">Digital Workers</button>
          <button data-prompt="How does Oryele protect customer data?">Security</button>
        </div>
      </div>
      <div class="elle-messages" data-elle-messages aria-live="polite"></div>
    </div>

    <footer class="elle-footer">
      <form class="elle-composer" data-elle-form>
        <textarea data-elle-input rows="1" maxlength="2000" placeholder="Ask Elle anything about Oryele…" aria-label="Message Elle"></textarea>
        <button type="button" data-elle-stop class="elle-stop" aria-label="Stop generating" hidden>■</button>
        <button type="submit" class="elle-send" aria-label="Send" disabled>➤</button>
      </form>
      <p>Elle can make mistakes. Verify important information.</p>
    </footer>
  </section>
</div>

<script is:inline>
(function () {
  var root = document.querySelector('[data-elle]');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';

  var STORAGE_KEY = 'oryele-elle-conversation-v3';
  var panel = root.querySelector('.elle-panel');
  var launcher = root.querySelector('.elle-launcher');
  var messagesEl = root.querySelector('[data-elle-messages]');
  var welcome = root.querySelector('[data-elle-welcome]');
  var form = root.querySelector('[data-elle-form]');
  var input = root.querySelector('[data-elle-input]');
  var send = root.querySelector('.elle-send');
  var stop = root.querySelector('[data-elle-stop]');
  var pending = false;
  var controller = null;
  var messages = load();

  root.querySelector('[data-elle-close]').onclick = function () { setOpen(false); };
  root.querySelector('[data-elle-new]').onclick = reset;
  launcher.onclick = function () { setOpen(!root.classList.contains('is-open')); };
  stop.onclick = function () { if (controller) controller.abort(); };

  root.querySelectorAll('[data-prompt]').forEach(function (button) {
    button.onclick = function () { submitPrompt(button.dataset.prompt || '', false); };
  });

  input.addEventListener('input', updateComposer);
  input.addEventListener('keydown', function (event) {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      if (!send.disabled) form.requestSubmit();
    }
  });
  form.addEventListener('submit', function (event) {
    event.preventDefault();
    submitPrompt(input.value.trim(), false);
  });

  restore();
  updateComposer();

  function setOpen(open) {
    root.classList.toggle('is-open', open);
    panel.setAttribute('aria-hidden', open ? 'false' : 'true');
    launcher.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) setTimeout(function () { input.focus(); }, 120);
  }

  async function submitPrompt(text, regenerate) {
    if (pending || (!text && !regenerate)) return;
    if (!regenerate) {
      input.value = '';
      messages.push({ role: 'user', content: text, at: Date.now() });
      appendUser(text, Date.now());
    }

    pending = true;
    controller = new AbortController();
    welcome.hidden = true;
    removeFollowups();
    updateComposer();
    var card = appendAssistant('', Date.now(), true);

    try {
      var response = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        signal: controller.signal,
        body: JSON.stringify({
          stream: true,
          messages: messages.slice(-8).map(function (m) { return { role: m.role, content: m.content }; }),
          system: 'You are Elle, Oryele’s warm, precise enterprise AI assistant. Answer directly and concisely. Use clear Markdown headings such as Examples, Sources, Next Steps, or Notes when useful. Include source links in Markdown when a relevant Oryele page is known. The official support email is support@oryele.com. Never use an @oryele.ai email address.'
        })
      });
      if (!response.ok) throw new Error(await response.text());

      var answer = await streamResponse(response, function (text) { updateAssistant(card, text, true); });
      if (!answer.trim()) answer = 'I could not generate a response.';
      updateAssistant(card, answer, false);
      messages.push({ role: 'assistant', content: answer, at: Date.now() });
      save();
      appendFollowups(answer);
    } catch (error) {
      if (error && error.name === 'AbortError') {
        var partial = card.dataset.raw || '';
        updateAssistant(card, partial || 'Response stopped.', false);
        if (partial) messages.push({ role: 'assistant', content: partial, at: Date.now() });
        save();
      } else {
        card.remove();
        appendError('Elle is temporarily unavailable. Please try again in a moment.');
      }
    } finally {
      pending = false;
      controller = null;
      updateComposer();
      input.focus();
    }
  }

  async function streamResponse(response, onUpdate) {
    if (!response.body || !response.body.getReader) {
      var data = await response.json();
      return data.content && data.content[0] ? data.content[0].text : '';
    }
    var reader = response.body.getReader();
    var decoder = new TextDecoder();
    var buffer = '';
    var full = '';
    var scheduled = false;
    function paint() {
      scheduled = false;
      onUpdate(full);
    }
    while (true) {
      var result = await reader.read();
      if (result.done) break;
      buffer += decoder.decode(result.value, { stream: true });
      var lines = buffer.split('\n');
      buffer = lines.pop() || '';
      lines.forEach(function (line) {
        line = line.trim();
        if (!line.startsWith('data:')) return;
        var payload = line.slice(5).trim();
        if (!payload || payload === '[DONE]') return;
        try {
          var json = JSON.parse(payload);
          var token = json.choices && json.choices[0] && json.choices[0].delta ? json.choices[0].delta.content || '' : '';
          if (token) {
            full += token;
            if (!scheduled) { scheduled = true; requestAnimationFrame(paint); }
          }
        } catch (_) {}
      });
    }
    onUpdate(full);
    return full;
  }

  function appendUser(text, at) {
    var item = document.createElement('article');
    item.className = 'elle-turn elle-turn--user';
    item.innerHTML = '<div class="elle-turn-head"><span class="elle-user-icon">●</span><strong>You</strong><time>' + timeLabel(at) + '</time></div><div class="elle-user-text">' + escapeHtml(text).replace(/\n/g, '<br>') + '</div>';
    messagesEl.appendChild(item);
    scrollBottom();
  }

  function appendAssistant(text, at, streaming) {
    var item = document.createElement('article');
    item.className = 'elle-turn elle-turn--assistant' + (streaming ? ' is-streaming' : '');
    item.dataset.at = String(at || Date.now());
    item.dataset.raw = text || '';
    item.innerHTML = '<div class="elle-turn-head"><span class="elle-mini-orb">E</span><strong>Elle</strong><time>' + timeLabel(at) + '</time></div><div class="elle-answer"><span class="elle-thinking">Thinking</span><span class="elle-cursor"></span></div>';
    messagesEl.appendChild(item);
    scrollBottom();
    return item;
  }

  function updateAssistant(item, text, streaming) {
    item.dataset.raw = text;
    item.classList.toggle('is-streaming', streaming);
    var answer = item.querySelector('.elle-answer');
    var rendered = renderMarkdown(text);
    var long = text.length > 1100;
    answer.innerHTML = long && !streaming
      ? '<div class="elle-collapsible is-collapsed"><div class="elle-answer-content">' + rendered + '</div><button type="button" data-expand>Show more</button></div>'
      : '<div class="elle-answer-content">' + rendered + (streaming ? '<span class="elle-cursor"></span>' : '') + '</div>';

    if (!streaming) {
      addCitations(item, text);
      addTools(item, text);
      var expand = item.querySelector('[data-expand]');
      if (expand) expand.onclick = function () {
        var wrap = expand.parentElement;
        var collapsed = wrap.classList.toggle('is-collapsed');
        expand.textContent = collapsed ? 'Show more' : 'Show less';
      };
    }
    scrollBottom();
  }

  function addCitations(item, text) {
    item.querySelectorAll('.elle-citations').forEach(function (el) { el.remove(); });
    var links = [];
    var regex = /\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g;
    var match;
    while ((match = regex.exec(text)) && links.length < 5) links.push({ title: match[1], url: match[2] });
    if (!links.length) return;
    var wrap = document.createElement('div');
    wrap.className = 'elle-citations';
    wrap.innerHTML = '<strong>🔖 Sources</strong><div>' + links.map(function (link) {
      return '<a href="' + escapeAttr(link.url) + '" target="_blank" rel="noopener">' + escapeHtml(link.title) + ' ↗</a>';
    }).join('') + '</div>';
    item.appendChild(wrap);
  }

  function addTools(item, text) {
    item.querySelectorAll('.elle-tools').forEach(function (el) { el.remove(); });
    var tools = document.createElement('div');
    tools.className = 'elle-tools';
    tools.innerHTML = '<button data-copy>▣ Copy</button><button data-feedback="yes">♡ Helpful</button><button data-feedback="no">♢ Not helpful</button><button data-regenerate>↻ Regenerate</button><time>' + timeLabel(Number(item.dataset.at)) + '</time>';
    item.appendChild(tools);

    tools.querySelector('[data-copy]').onclick = async function () {
      try { await navigator.clipboard.writeText(text); this.textContent = '✓ Copied'; } catch (_) { this.textContent = 'Copy failed'; }
    };
    tools.querySelectorAll('[data-feedback]').forEach(function (button) {
      button.onclick = function () {
        tools.querySelectorAll('[data-feedback]').forEach(function (b) { b.disabled = true; });
        button.textContent = button.dataset.feedback === 'yes' ? '✓ Helpful' : '✓ Not helpful';
      };
    });
    tools.querySelector('[data-regenerate]').onclick = function () {
      if (pending || messages[messages.length - 1]?.role !== 'assistant') return;
      messages.pop();
      item.remove();
      save();
      removeFollowups();
      submitPrompt('', true);
    };
  }

  function appendFollowups(answer) {
    removeFollowups();
    var prompts = getFollowups(answer);
    var wrap = document.createElement('div');
    wrap.className = 'elle-followups';
    wrap.innerHTML = '<strong>✨ Suggested follow-up questions</strong><div></div>';
    var list = wrap.lastElementChild;
    prompts.forEach(function (prompt) {
      var button = document.createElement('button');
      button.type = 'button';
      button.textContent = prompt + '  ›';
      button.onclick = function () { submitPrompt(prompt, false); };
      list.appendChild(button);
    });
    messagesEl.appendChild(wrap);
    scrollBottom();
  }

  function getFollowups(answer) {
    var lower = answer.toLowerCase();
    if (lower.includes('workflow')) return ['Show an example workflow', 'How are approvals handled?', 'What can trigger a workflow?'];
    if (lower.includes('security') || lower.includes('data')) return ['Explain the security controls', 'How is access governed?', 'What audit evidence is available?'];
    if (lower.includes('digital worker')) return ['Give me a practical example', 'How is work monitored?', 'What controls are available?'];
    return ['Tell me more', 'Give me a practical example', 'What should I do next?'];
  }

  function renderMarkdown(value) {
    var safe = escapeHtml(value || '');
    safe = safe.replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
    safe = safe.replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>');
    safe = safe.replace(/`([^`]+)`/g, '<code>$1</code>');
    safe = safe.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    safe = safe.replace(/^### (.+)$/gm, '<h4><span>▸</span>$1</h4>');
    safe = safe.replace(/^## (.+)$/gm, '<h3><span>◆</span>$1</h3>');
    safe = safe.replace(/^# (.+)$/gm, '<h2><span>✦</span>$1</h2>');
    safe = safe.replace(/^[-*] (.+)$/gm, '<li>$1</li>');
    safe = safe.replace(/^\d+\. (.+)$/gm, '<li>$1</li>');
    safe = safe.replace(/(<li>[\s\S]*?<\/li>)(?!(?:\s*<li>))/g, '<ul>$1</ul>');
    safe = safe.replace(/\n{2,}/g, '</p><p>');
    safe = safe.replace(/\n/g, '<br>');
    return '<p>' + safe + '</p>';
  }

  function appendError(text) {
    var item = document.createElement('div');
    item.className = 'elle-error';
    item.textContent = text;
    messagesEl.appendChild(item);
  }

  function updateComposer() {
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight, 120) + 'px';
    send.disabled = pending || !input.value.trim();
    send.hidden = pending;
    stop.hidden = !pending;
  }

  function reset() {
    if (controller) controller.abort();
    messages = [];
    messagesEl.innerHTML = '';
    welcome.hidden = false;
    localStorage.removeItem(STORAGE_KEY);
    pending = false;
    updateComposer();
  }

  function load() { try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); } catch (_) { return []; } }
  function save() { try { localStorage.setItem(STORAGE_KEY, JSON.stringify(messages.slice(-20))); } catch (_) {} }
  function restore() {
    if (!messages.length) return;
    welcome.hidden = true;
    messages.forEach(function (message) {
      if (message.role === 'user') appendUser(message.content, message.at);
      else {
        var card = appendAssistant(message.content, message.at, false);
        updateAssistant(card, message.content, false);
      }
    });
    var last = messages[messages.length - 1];
    if (last && last.role === 'assistant') appendFollowups(last.content);
  }
  function removeFollowups() { messagesEl.querySelectorAll('.elle-followups').forEach(function (el) { el.remove(); }); }
  function timeLabel(at) {
    var seconds = Math.max(0, Math.floor((Date.now() - (at || Date.now())) / 1000));
    if (seconds < 60) return 'Just now';
    var minutes = Math.floor(seconds / 60);
    if (minutes < 60) return minutes + ' min ago';
    var hours = Math.floor(minutes / 60);
    return hours + ' hr ago';
  }
  function scrollBottom() { requestAnimationFrame(function () { root.querySelector('.elle-body').scrollTop = root.querySelector('.elle-body').scrollHeight; }); }
  function escapeHtml(value) { return String(value || '').replace(/[&<>"']/g, function (c) { return ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;' })[c]; }); }
  function escapeAttr(value) { return escapeHtml(value); }
}());
</script>

<style>
