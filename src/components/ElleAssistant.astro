<div class="elle" data-elle>
  <button class="elle-launcher" type="button" aria-label="Open Ask Elle by Oryele" aria-expanded="false">
    <span class="elle-avatar elle-avatar--launcher"><img src="/elle-avatar.png" alt="" /></span>
    <span class="elle-launcher-copy"><strong>Ask Elle</strong><small>by Oryele</small></span>
    <i class="elle-online-dot" aria-hidden="true"></i>
  </button>

  <section class="elle-panel" aria-label="Ask Elle by Oryele" aria-hidden="true">
    <header class="elle-header">
      <div class="elle-brand">
        <span class="elle-avatar elle-avatar--header"><img src="/elle-avatar.png" alt="Elle" /></span>
        <span class="elle-brand-copy">
          <strong>Ask Elle <em>by Oryele</em></strong>
          <small><i class="elle-online-dot" aria-hidden="true"></i> Online <span aria-hidden="true">•</span> <span data-elle-context>Oryele</span></small>
        </span>
      </div>
      <div class="elle-header-actions">
        <button type="button" data-elle-new aria-label="Start a new conversation">＋</button>
        <button type="button" data-elle-close aria-label="Close Ask Elle">×</button>
      </div>
    </header>

    <div class="elle-body">
      <div class="elle-welcome" data-elle-welcome>
        <span class="elle-avatar elle-avatar--welcome"><img src="/elle-avatar.png" alt="Elle" /></span>
        <h2>How can Elle help?</h2>
        <p data-elle-intro>Ask about Oryele, its capabilities, security, workflows, or digital workers.</p>
        <div class="elle-prompts" data-elle-prompts>
          <button data-prompt="What can Oryele automate for an accounting firm?">Explore automation</button>
          <button data-prompt="Explain how the Oryele Workflow Engine works.">Workflow Engine</button>
          <button data-prompt="What are Oryele Digital Workers?">Digital Workers</button>
          <button data-prompt="How does Oryele protect customer data?">Security</button>
        </div>
      </div>
      <div class="elle-messages" data-elle-messages aria-live="polite"></div>
    </div>

    <footer class="elle-footer">
      <form class="elle-composer" data-elle-form>
        <textarea data-elle-input rows="1" maxlength="2000" placeholder="Ask Elle anything about Oryele…" aria-label="Message Elle"></textarea>
        <button type="button" data-elle-stop class="elle-stop" aria-label="Stop generating" hidden>■</button>
        <button type="submit" class="elle-send" aria-label="Send message" disabled>➤</button>
      </form>
      <p><span data-elle-status>Elle can make mistakes. Verify important information.</span><b>Hudson · Elle v3.3</b></p>
    </footer>
  </section>
</div>

<script is:inline>
(function () {
  var root = document.querySelector('[data-elle]');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';

  var STORAGE_KEY = 'oryele-elle-conversation-v3';
  var panel = root.querySelector('.elle-panel');
  var launcher = root.querySelector('.elle-launcher');
  var messagesEl = root.querySelector('[data-elle-messages]');
  var welcome = root.querySelector('[data-elle-welcome]');
  var form = root.querySelector('[data-elle-form]');
  var input = root.querySelector('[data-elle-input]');
  var send = root.querySelector('.elle-send');
  var stop = root.querySelector('[data-elle-stop]');
  var statusEl = root.querySelector('[data-elle-status]');
  var contextEl = root.querySelector('[data-elle-context]');
  var introEl = root.querySelector('[data-elle-intro]');
  var defaultStatus = 'Elle can make mistakes. Verify important information.';
  var pending = false;
  var controller = null;
  var messages = load();
  var page = getPageContext();

  applyPageContext();
  restore();
  updateComposer();

  root.querySelector('[data-elle-close]').onclick = function () { setOpen(false); };
  root.querySelector('[data-elle-new]').onclick = reset;
  launcher.onclick = function () { setOpen(!root.classList.contains('is-open')); };
  stop.onclick = function () { if (controller) controller.abort(); };

  root.querySelectorAll('[data-prompt]').forEach(function (button) {
    button.onclick = function () { submitPrompt(button.dataset.prompt || '', false); };
  });

  input.addEventListener('input', updateComposer);
  input.addEventListener('keydown', function (event) {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      if (!send.disabled) form.requestSubmit();
    }
  });
  form.addEventListener('submit', function (event) {
    event.preventDefault();
    submitPrompt(input.value.trim(), false);
  });

  function getPageContext() {
    var body = document.body;
    var path = body.dataset.pagePath || window.location.pathname;
    var title = body.dataset.pageTitle || document.title.replace(/\s*\|\s*Oryele.*$/i, '');
    var section = 'Oryele';
    if (path.indexOf('/pricing') === 0) section = 'Pricing';
    else if (path.indexOf('/careers') === 0) section = 'Careers';
    else if (path.indexOf('/support') === 0 || path.indexOf('/resources/help-center') === 0) section = 'Help Center';
    else if (path.indexOf('/platform/') === 0) section = title || 'Platform';
    else if (path.indexOf('/solutions') === 0) section = 'Solutions';
    else if (path.indexOf('/resources') === 0) section = 'Resources';
    else if (path.indexOf('/company') === 0) section = 'Company';
    else if (path.indexOf('/contact') === 0) section = 'Contact';
    return { path: path, title: title || 'Oryele', section: section };
  }

  function applyPageContext() {
    contextEl.textContent = page.section;
    if (page.section === 'Pricing') introEl.textContent = 'Ask about plans, capabilities, implementation, or the best fit for your firm.';
    else if (page.section === 'Careers') introEl.textContent = 'Ask about Oryele’s mission, culture, roles, and what it is like to work with us.';
    else if (page.section === 'Help Center') introEl.textContent = 'Ask for product guidance, setup help, troubleshooting, or support information.';
    else if (page.section !== 'Oryele') introEl.textContent = 'Ask Elle about ' + page.section + ' or anything else about Oryele.';
  }

  function setOpen(open) {
    root.classList.toggle('is-open', open);
    panel.setAttribute('aria-hidden', open ? 'false' : 'true');
    launcher.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) setTimeout(function () { input.focus(); }, 120);
  }

  async function submitPrompt(text, regenerate) {
    if (pending || (!text && !regenerate)) return;
    if (!regenerate) {
      input.value = '';
      messages.push({ role: 'user', content: text, at: Date.now() });
      appendUser(text, Date.now());
    }

    pending = true;
    controller = new AbortController();
    welcome.hidden = true;
    removeFollowups();
    updateComposer();
    setStatus('Connecting…');
    var startedAt = performance.now();
    var card = appendAssistant('', Date.now(), true);
    var thinkingTimer = setTimeout(function () { showThinking(card); }, 700);

    try {
      var systemPrompt = 'You are Elle, Oryele’s warm, precise enterprise AI assistant. You are branded as “Ask Elle by Oryele.” ' +
        'The visitor is currently viewing the ' + page.section + ' area, page title “' + page.title + '”, at path ' + page.path + '. ' +
        'Use this page context as the primary interpretation of short or ambiguous questions, but do not claim to see private account data. ' +
        'Answer directly and concisely. Use clear Markdown headings when useful. Include relevant Oryele source links in Markdown. ' +
        'The official support email is support@oryele.com. Never use an @oryele.ai email address.';

      var response = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        signal: controller.signal,
        body: JSON.stringify({
          stream: true,
          page: page,
          messages: messages.slice(-8).map(function (m) { return { role: m.role, content: m.content }; }),
          system: systemPrompt
        })
      });
      if (!response.ok) throw new Error(await response.text());

      var firstToken = true;
      var answer = await streamResponse(response, function (text) {
        if (firstToken && text) {
          firstToken = false;
          clearTimeout(thinkingTimer);
          setStatus('Streaming…');
        }
        updateAssistant(card, text, true);
      });
      clearTimeout(thinkingTimer);
      if (!answer.trim()) answer = 'I could not generate a response.';
      updateAssistant(card, answer, false);
      messages.push({ role: 'assistant', content: answer, at: Date.now() });
      save();
      appendFollowups(answer);
      setStatus('Completed in ' + ((performance.now() - startedAt) / 1000).toFixed(1) + 's');
      setTimeout(function () { if (!pending) setStatus(defaultStatus); }, 2600);
    } catch (error) {
      clearTimeout(thinkingTimer);
      if (error && error.name === 'AbortError') {
        var partial = card.dataset.raw || '';
        updateAssistant(card, partial || 'Response stopped.', false);
        if (partial) messages.push({ role: 'assistant', content: partial, at: Date.now() });
        save();
        setStatus('Response stopped');
      } else {
        card.remove();
        appendError('I’m having trouble reaching the AI service. Please try again in a few moments.');
        setStatus('Unable to contact Elle');
      }
    } finally {
      pending = false;
      controller = null;
      updateComposer();
      input.focus();
    }
  }

  async function streamResponse(response, onUpdate) {
    if (!response.body || !response.body.getReader) {
      var data = await response.json();
      return data.content && data.content[0] ? data.content[0].text : '';
    }
    var reader = response.body.getReader();
    var decoder = new TextDecoder();
    var buffer = '';
    var full = '';
    while (true) {
      var result = await reader.read();
      if (result.done) break;
      buffer += decoder.decode(result.value, { stream: true });
      var lines = buffer.split('\n');
      buffer = lines.pop() || '';
      lines.forEach(function (line) {
        line = line.trim();
        if (!line.startsWith('data:')) return;
        var payload = line.slice(5).trim();
        if (!payload || payload === '[DONE]') return;
        try {
          var json = JSON.parse(payload);
          var token = json.choices && json.choices[0] && json.choices[0].delta ? json.choices[0].delta.content || '' : '';
          if (token) { full += token; onUpdate(full); }
        } catch (_) {}
      });
    }
    onUpdate(full);
    return full;
  }

  function appendUser(text, at) {
    var item = document.createElement('article');
    item.className = 'elle-turn elle-turn--user';
    item.innerHTML = '<div class="elle-turn-head"><span class="elle-user-icon">●</span><strong>You</strong><time>' + timeLabel(at) + '</time></div><div class="elle-user-text">' + escapeHtml(text).replace(/\n/g, '<br>') + '</div>';
    messagesEl.appendChild(item);
    scrollBottom();
  }

  function appendAssistant(text, at, streaming) {
    var item = document.createElement('article');
    item.className = 'elle-turn elle-turn--assistant' + (streaming ? ' is-streaming' : '');
    item.dataset.at = String(at || Date.now());
    item.dataset.raw = text || '';
    item.innerHTML = '<div class="elle-turn-head"><span class="elle-mini-avatar"><img src="/elle-avatar.png" alt=""></span><strong>Elle</strong><time>' + timeLabel(at) + '</time></div><div class="elle-answer"></div>';
    messagesEl.appendChild(item);
    scrollBottom();
    return item;
  }

  function showThinking(item) {
    if (!item || item.dataset.raw) return;
    item.querySelector('.elle-answer').innerHTML = '<span class="elle-thinking-dots" aria-label="Elle is thinking"><i></i><i></i><i></i></span>';
  }

  function updateAssistant(item, text, streaming) {
    item.dataset.raw = text;
    item.classList.toggle('is-streaming', streaming);
    var answer = item.querySelector('.elle-answer');
    if (streaming) {
      answer.innerHTML = '<div class="elle-answer-content">' + escapeHtml(text).replace(/\n/g, '<br>') + '<span class="elle-cursor"></span></div>';
    } else {
      var cleaned = extractLinks(text);
      answer.innerHTML = '<div class="elle-answer-content">' + renderMarkdown(cleaned.body) + '</div>';
      addCitations(item, cleaned.links);
      addTools(item, text);
    }
    scrollBottom();
  }

  function extractLinks(text) {
    var links = [];
    var seen = {};
    var body = String(text || '').replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g, function (_, title, url) {
      if (!seen[url]) { seen[url] = true; links.push({ title: title, url: url }); }
      return title;
    });
    links.sort(function (a, b) { return a.title.localeCompare(b.title); });
    return { body: body, links: links.slice(0, 6) };
  }

  function addCitations(item, links) {
    if (!links.length) return;
    var wrap = document.createElement('div');
    wrap.className = 'elle-citations';
    wrap.innerHTML = '<strong>Sources (' + links.length + ')</strong><div>' + links.map(function (link) {
      return '<a href="' + escapeAttr(link.url) + '" target="_blank" rel="noopener">' + escapeHtml(link.title) + ' ↗</a>';
    }).join('') + '</div>';
    item.appendChild(wrap);
  }

  function addTools(item, text) {
    var tools = document.createElement('div');
    tools.className = 'elle-tools';
    tools.innerHTML = '<button data-copy>Copy</button><button data-feedback="yes">Helpful</button><button data-feedback="no">Not helpful</button><button data-regenerate>Regenerate</button>';
    item.appendChild(tools);
    tools.querySelector('[data-copy]').onclick = async function () {
      try { await navigator.clipboard.writeText(text); this.textContent = 'Copied'; } catch (_) { this.textContent = 'Copy failed'; }
    };
    tools.querySelectorAll('[data-feedback]').forEach(function (button) {
      button.onclick = function () {
        tools.querySelectorAll('[data-feedback]').forEach(function (b) { b.disabled = true; });
        button.textContent = button.dataset.feedback === 'yes' ? 'Helpful ✓' : 'Not helpful ✓';
      };
    });
    tools.querySelector('[data-regenerate]').onclick = function () {
      if (pending || !messages.length || messages[messages.length - 1].role !== 'assistant') return;
      messages.pop(); item.remove(); save(); removeFollowups(); submitPrompt('', true);
    };
  }

  function appendFollowups(answer) {
    removeFollowups();
    var lower = answer.toLowerCase();
    var prompts = lower.includes('workflow') ? ['Show an example workflow', 'How are approvals handled?', 'What can trigger a workflow?'] :
      lower.includes('security') ? ['Explain the security controls', 'How is access governed?', 'What audit evidence is available?'] :
      ['Tell me more', 'Give me a practical example', 'What should I do next?'];
    var wrap = document.createElement('div');
    wrap.className = 'elle-followups';
    wrap.innerHTML = '<strong>Suggested follow-up questions</strong><div></div>';
    prompts.forEach(function (prompt) {
      var button = document.createElement('button');
      button.type = 'button'; button.textContent = prompt; button.onclick = function () { submitPrompt(prompt, false); };
      wrap.lastElementChild.appendChild(button);
    });
    messagesEl.appendChild(wrap);
    scrollBottom();
  }

  function renderMarkdown(value) {
    var safe = escapeHtml(value || '');
    safe = safe.replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>');
    safe = safe.replace(/`([^`]+)`/g, '<code>$1</code>');
    safe = safe.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    safe = safe.replace(/^### (.+)$/gm, '<h4>$1</h4>');
    safe = safe.replace(/^## (.+)$/gm, '<h3>$1</h3>');
    safe = safe.replace(/^# (.+)$/gm, '<h2>$1</h2>');
    safe = safe.replace(/^[-*] (.+)$/gm, '<li>$1</li>');
    safe = safe.replace(/\n{2,}/g, '</p><p>');
    safe = safe.replace(/\n/g, '<br>');
    return '<p>' + safe + '</p>';
  }

  function appendError(text) { var item = document.createElement('div'); item.className = 'elle-error'; item.textContent = text; messagesEl.appendChild(item); scrollBottom(); }
  function setStatus(text) { statusEl.textContent = text; }
  function updateComposer() { input.style.height = 'auto'; input.style.height = Math.min(input.scrollHeight, 120) + 'px'; send.disabled = pending || !input.value.trim(); send.hidden = pending; stop.hidden = !pending; }
  function reset() { if (controller) controller.abort(); messages = []; messagesEl.innerHTML = ''; welcome.hidden = false; localStorage.removeItem(STORAGE_KEY); pending = false; setStatus(defaultStatus); updateComposer(); }
  function load() { try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); } catch (_) { return []; } }
  function save() { try { localStorage.setItem(STORAGE_KEY, JSON.stringify(messages.slice(-20))); } catch (_) {} }
  function restore() { if (!messages.length) return; welcome.hidden = true; messages.forEach(function (m) { if (m.role === 'user') appendUser(m.content, m.at); else updateAssistant(appendAssistant(m.content, m.at, false), m.content, false); }); }
  function removeFollowups() { messagesEl.querySelectorAll('.elle-followups').forEach(function (el) { el.remove(); }); }
  function timeLabel(at) { var seconds = Math.max(0, Math.floor((Date.now() - (at || Date.now())) / 1000)); if (seconds < 60) return 'Just now'; var minutes = Math.floor(seconds / 60); return minutes < 60 ? minutes + ' min ago' : Math.floor(minutes / 60) + ' hr ago'; }
  function scrollBottom() { requestAnimationFrame(function () { var body = root.querySelector('.elle-body'); body.scrollTop = body.scrollHeight; }); }
  function escapeHtml(value) { return String(value || '').replace(/[&<>"']/g, function (c) { return ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;' })[c]; }); }
  function escapeAttr(value) { return escapeHtml(value); }
}());
</script>

<style>
.elle{position:fixed;right:24px;bottom:24px;z-index:1000;font-family:Inter,system-ui,-apple-system,sans-serif;color:#13233d}.elle-launcher{display:flex;align-items:center;gap:11px;padding:8px 14px 8px 8px;border:1px solid rgba(255,255,255,.18);border-radius:999px;background:#0b2348;color:#fff;box-shadow:0 18px 50px rgba(8,28,61,.32);cursor:pointer;transition:transform .18s ease,box-shadow .18s ease}.elle-launcher:hover{transform:translateY(-2px);box-shadow:0 22px 58px rgba(8,28,61,.38)}.elle-launcher-copy{display:flex;flex-direction:column;align-items:flex-start;min-width:74px}.elle-launcher strong{font-size:13px;line-height:1.15}.elle-launcher small{font-size:10px;color:#b9c9e2}.elle-online-dot{width:7px;height:7px;border-radius:50%;background:#45d39a;box-shadow:0 0 0 3px rgba(69,211,154,.14)}.elle-avatar{display:block;overflow:hidden;border-radius:50%;background:#dfe8f5;box-shadow:0 0 0 2px rgba(255,255,255,.75)}.elle-avatar img,.elle-mini-avatar img{width:100%;height:100%;object-fit:cover;display:block}.elle-avatar--launcher{width:43px;height:43px}.elle-avatar--header{width:42px;height:42px}.elle-avatar--welcome{width:76px;height:76px;margin:0 auto 16px;box-shadow:0 10px 30px rgba(20,52,104,.18),0 0 0 4px #fff,0 0 0 5px #dbe5f2}.elle-panel{position:absolute;right:0;bottom:0;display:grid;grid-template-rows:auto minmax(0,1fr) auto;width:min(440px,calc(100vw - 24px));height:min(710px,calc(100vh - 24px));overflow:hidden;border:1px solid #dbe4f1;border-radius:22px;background:#fff;box-shadow:0 28px 90px rgba(7,25,55,.3);opacity:0;visibility:hidden;transform:translateY(12px) scale(.98);transition:.2s}.elle.is-open .elle-panel{opacity:1;visibility:visible;transform:none}.elle.is-open .elle-launcher{visibility:hidden;opacity:0}.elle-header{display:flex;align-items:center;justify-content:space-between;padding:13px 15px;background:linear-gradient(135deg,#071d3e,#102d5a);color:#fff}.elle-brand{display:flex;align-items:center;gap:11px}.elle-brand-copy{display:flex;flex-direct