<div class="elle" data-elle>
  <button class="elle-launcher" type="button" aria-label="Open Elle AI assistant" aria-expanded="false">
    <span class="elle-orb" aria-hidden="true"><img src="/elle-avatar-v5.png" alt="" /></span>
    <span class="elle-launcher-copy"><strong>Ask Elle</strong><small>Oryele AI</small></span>
    <span class="elle-status-dot" aria-hidden="true"></span>
  </button>

  <section class="elle-panel" aria-label="Elle AI assistant" aria-hidden="true">
    <header class="elle-header">
      <div class="elle-identity">
        <span class="elle-orb elle-orb--header" aria-hidden="true"><img src="/elle-avatar-v5.png" alt="" /></span>
        <span><strong>Elle</strong><small><i></i> Oryele Intelligence</small></span>
      </div>
      <div class="elle-header-actions">
        <button class="elle-icon-btn" type="button" data-elle-new title="New conversation" aria-label="Start a new conversation">＋</button>
        <button class="elle-icon-btn" type="button" data-elle-close title="Close" aria-label="Close Elle">×</button>
      </div>
    </header>

    <div class="elle-body">
      <div class="elle-welcome" data-elle-welcome>
        <div class="elle-welcome-mark"><img src="/elle-avatar-v5.png" alt="Elle" /></div>
        <h2>How can Elle help?</h2>
        <p>Ask about Oryele, explore platform capabilities, or get guidance on your next workflow.</p>
        <div class="elle-suggestions">
          <button type="button" data-prompt="What can Oryele automate for an accounting firm?"><span>✦</span><b>Explore automation</b><small>See how Oryele supports your firm</small></button>
          <button type="button" data-prompt="Explain how the Oryele Workflow Engine works."><span>↳</span><b>Workflow Engine</b><small>Understand triggers, steps and approvals</small></button>
          <button type="button" data-prompt="What are Oryele Digital Workers?"><span>◎</span><b>Digital Workers</b><small>Discover AI-powered task execution</small></button>
          <button type="button" data-prompt="How does Oryele protect customer data?"><span>◇</span><b>Security & governance</b><small>Learn about controls and oversight</small></button>
        </div>
      </div>

      <div class="elle-messages" data-elle-messages aria-live="polite"></div>
    </div>

    <footer class="elle-composer-wrap">
      <form class="elle-composer" data-elle-form>
        <textarea data-elle-input rows="1" maxlength="2000" placeholder="Ask Elle anything about Oryele…" aria-label="Message Elle"></textarea>
        <button type="submit" class="elle-send" aria-label="Send message" disabled>↑</button>
      </form>
      <p>Elle can make mistakes. Verify important information.</p>
    </footer>
  </section>
</div>

<script is:inline>
(function () {
  var root = document.querySelector('[data-elle]');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = 'true';

  var launcher = root.querySelector('.elle-launcher');
  var panel = root.querySelector('.elle-panel');
  var closeBtn = root.querySelector('[data-elle-close]');
  var newBtn = root.querySelector('[data-elle-new]');
  var form = root.querySelector('[data-elle-form]');
  var input = root.querySelector('[data-elle-input]');
  var send = root.querySelector('.elle-send');
  var messagesEl = root.querySelector('[data-elle-messages]');
  var welcome = root.querySelector('[data-elle-welcome]');
  var messages = [];
  var pending = false;

  function setOpen(open) {
    root.classList.toggle('is-open', open);
    panel.setAttribute('aria-hidden', open ? 'false' : 'true');
    launcher.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) setTimeout(function () { input.focus(); }, 120);
  }

  launcher.addEventListener('click', function () { setOpen(!root.classList.contains('is-open')); });
  closeBtn.addEventListener('click', function () { setOpen(false); });
  newBtn.addEventListener('click', resetConversation);

  root.querySelectorAll('[data-prompt]').forEach(function (button) {
    button.addEventListener('click', function () {
      input.value = button.getAttribute('data-prompt') || '';
      updateComposer();
      form.requestSubmit();
    });
  });

  input.addEventListener('input', updateComposer);
  input.addEventListener('keydown', function (event) {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      if (!send.disabled) form.requestSubmit();
    }
  });

  form.addEventListener('submit', async function (event) {
    event.preventDefault();
    var text = input.value.trim();
    if (!text || pending) return;

    pending = true;
    input.value = '';
    updateComposer();
    welcome.hidden = true;
    appendMessage('user', text);
    messages.push({ role: 'user', content: text });
    var typing = appendTyping();

    try {
      var response = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          messages: messages.slice(-12),
          system: 'You are Elle, Oryele’s warm, precise enterprise AI orchestrator. Use clear business language, concise paragraphs, and practical next steps.'
        })
      });
      var data = await response.json();
      typing.remove();
      if (!response.ok) throw new Error(data.error || 'Unable to reach Elle');
      var answer = data.content && data.content[0] ? data.content[0].text : 'I could not generate a response.';
      messages.push({ role: 'assistant', content: answer });
      appendMessage('assistant', answer, data);
    } catch (error) {
      typing.remove();
      appendMessage('error', 'Elle is temporarily unavailable. Please try again in a moment.');
    } finally {
      pending = false;
      updateComposer();
      input.focus();
    }
  });

  function updateComposer() {
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight, 120) + 'px';
    send.disabled = pending || !input.value.trim();
  }

  function resetConversation() {
    messages = [];
    messagesEl.innerHTML = '';
    welcome.hidden = false;
    input.value = '';
    updateComposer();
    input.focus();
  }

  function appendTyping() {
    var item = document.createElement('div');
    item.className = 'elle-message elle-message--assistant';
    item.innerHTML = '<div class="elle-avatar"><img src="/elle-avatar-v5.png" alt="Elle" /></div><div class="elle-bubble elle-typing"><i></i><i></i><i></i></div>';
    messagesEl.appendChild(item);
    scrollBottom();
    return item;
  }

  function appendMessage(role, text, meta) {
    var item = document.createElement('article');
    item.className = 'elle-message elle-message--' + role;
    var safe = escapeHtml(text).replace(/\n/g, '<br>');

    if (role === 'user') {
      item.innerHTML = '<div class="elle-bubble">' + safe + '</div>';
    } else if (role === 'error') {
      item.innerHTML = '<div class="elle-avatar"><img src="/elle-avatar-v5.png" alt="Elle" /></div><div class="elle-bubble elle-bubble--error">' + safe + '</div>';
    } else {
      var confidence = typeof meta.confidence === 'number' ? Math.round(meta.confidence * 100) : null;
      var sources = Array.isArray(meta.sources) ? meta.sources : [];
      var sourceHtml = sources.length ? '<div class="elle-sources"><strong>Sources</strong>' + sources.map(function (source) {
        var title = escapeHtml(source.title || 'Oryele knowledge');
        return source.url ? '<a href="' + escapeAttr(source.url) + '" target="_blank" rel="noopener">' + title + ' ↗</a>' : '<span>' + title + '</span>';
      }).join('') + '</div>' : '';
      var confidenceHtml = confidence !== null ? '<span class="elle-confidence"><i></i>' + confidence + '% confidence</span>' : '';
      item.innerHTML = '<div class="elle-avatar"><img src="/elle-avatar-v5.png" alt="Elle" /></div><div class="elle-response"><div class="elle-bubble">' + safe + '</div>' + sourceHtml + '<div class="elle-meta">' + confidenceHtml + '<span>' + escapeHtml(formatRoute(meta.route)) + '</span><span>' + ((meta.response_time_ms || 0) / 1000).toFixed(1) + 's</span></div><div class="elle-tools"><button type="button" data-copy>Copy</button><button type="button" data-feedback="true">Helpful</button><button type="button" data-feedback="false">Not helpful</button></div></div>';
      bindMessageTools(item, text, meta.interaction_id);
    }

    messagesEl.appendChild(item);
    scrollBottom();
  }

  function bindMessageTools(item, text, interactionId) {
    var copy = item.querySelector('[data-copy]');
    if (copy) copy.addEventListener('click', async function () {
      try { await navigator.clipboard.writeText(text); copy.textContent = 'Copied'; setTimeout(function () { copy.textContent = 'Copy'; }, 1200); } catch (_) {}
    });
    item.querySelectorAll('[data-feedback]').forEach(function (button) {
      button.addEventListener('click', async function () {
        if (!interactionId) return;
        var helpful = button.getAttribute('data-feedback') === 'true';
        item.querySelectorAll('[data-feedback]').forEach(function (b) { b.disabled = true; });
        try {
          await fetch('/api/elle-feedback', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ interaction_id: interactionId, helpful: helpful }) });
          button.textContent = helpful ? 'Thanks — helpful' : 'Thanks for the feedback';
          button.classList.add('is-selected');
        } catch (_) {
          item.querySelectorAll('[data-feedback]').forEach(function (b) { b.disabled = false; });
        }
      });
    });
  }

  function formatRoute(route) {
    if (!route) return 'Elle Intelligence';
    return route.split('-').map(function (word) { return word.charAt(0).toUpperCase() + word.slice(1); }).join(' ');
  }

  function scrollBottom() { requestAnimationFrame(function () { messagesEl.parentElement.scrollTop = messagesEl.parentElement.scrollHeight; }); }
  function escapeHtml(value) { return String(value || '').replace(/[&<>"']/g, function (char) { return ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#039;' })[char]; }); }
  function escapeAttr(value) { return escapeHtml(value); }
}());
</script>

<style>
.elle{position:fixed;right:24px;bottom:var(--elle-bottom,24px);z-index:1000;transition:bottom .2s ease;font-family:Inter,system-ui,sans-serif}.elle-launcher{display:flex;align-items:center;gap:11px;min-width:154px;padding:10px 14px 10px 10px;border:1px solid rgba(255,255,255,.16);border-radius:18px;background:#0b1b34;color:#fff;box-shadow:0 18px 50px rgba(5,18,40,.28);cursor:pointer;transition:transform .18s ease,box-shadow .18s ease}.elle-launcher:hover{transform:translateY(-2px);box-shadow:0 22px 58px rgba(5,18,40,.36)}.elle-orb{display:grid;place-items:center;width:38px;height:38px;border-radius:13px;background:linear-gradient(145deg,#5f8fff,#2b55c7);font-size:17px;font-weight:800;box-shadow:inset 0 1px rgba(255,255,255,.35)}.elle-launcher-copy{display:flex;flex-direction:column;align-items:flex-start;line-height:1.15}.elle-launcher-copy strong{font-size:14px}.elle-launcher-copy small{margin-top:3px;color:#9fb2cf;font-size:10.5px}.elle-status-dot{width:7px;height:7px;margin-left:auto;border-radius:50%;background:#45d39a;box-shadow:0 0 0 4px rgba(69,211,154,.12)}
.elle-panel{position:absolute;right:0;bottom:0;display:grid;grid-template-rows:auto minmax(0,1fr) auto;width:min(430px,calc(100vw - 32px));height:min(680px,calc(100vh - 40px));overflow:hidden;border:1px solid #dce4f0;border-radius:24px;background:#fff;box-shadow:0 30px 90px rgba(5,18,40,.28);opacity:0;visibility:hidden;transform:translateY(16px) scale(.97);transform-origin:bottom right;transition:opacity .2s ease,transform .2s ease,visibility .2s}.elle.is-open .elle-panel{opacity:1;visibility:visible;transform:none}.elle.is-open .elle-launcher{opacity:0;visibility:hidden}.elle-header{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid #e8edf5;background:linear-gradient(135deg,#081b37,#102b55);color:#fff}.elle-identity{display:flex;align-items:center;gap:11px}.elle-orb--header{width:40px;height:40px;border-radius:14px}.elle-identity>span:last-child{display:flex;flex-direction:column}.elle-identity strong{font-size:15px}.elle-identity small{margin-top:4px;color:#b9c8df;font-size:11px}.elle-identity small i{display:inline-block;width:6px;height:6px;margin-right:4px;border-radius:50%;background:#43d49b}.elle-header-actions{display:flex;gap:6px}.elle-icon-btn{display:grid;place-items:center;width:34px;height:34px;border:0;border-radius:10px;background:rgba(255,255,255,.08);color:#dfe8f7;font-size:21px;cursor:pointer}.elle-icon-btn:hover{background:rgba(255,255,255,.15);color:#fff}
.elle-body{min-height:0;overflow-y:auto;background:linear-gradient(#f8faff,#fff 180px);scrollbar-width:thin}.elle-welcome{padding:32px 24px 24px;text-align:center}.elle-welcome[hidden]{display:none}.elle-welcome-mark{display:grid;place-items:center;width:58px;height:58px;margin:0 auto 16px;border-radius:20px;background:linear-gradient(145deg,#6f9cff,#294fc1);color:#fff;font-size:25px;font-weight:800;box-shadow:0 12px 30px rgba(47,88,194,.24)}.elle-welcome h2{margin:0;color:#12233e;font-size:23px;letter-spacing:-.03em}.elle-welcome>p{max-width:330px;margin:9px auto 22px;color:#62728a;font-size:13px;line-height:1.55}.elle-suggestions{display:grid;grid-template-columns:1fr 1fr;gap:10px;text-align:left}.elle-suggestions button{display:grid;grid-template-columns:24px 1fr;column-gap:8px;min-height:92px;padding:13px;border:1px solid #e1e8f2;border-radius:15px;background:#fff;color:#1a2b47;cursor:pointer;transition:border-color .15s,transform .15s,box-shadow .15s}.elle-suggestions button:hover{transform:translateY(-1px);border-color:#9eb8ed;box-shadow:0 8px 22px rgba(25,55,105,.08)}.elle-suggestions span{grid-row:1/3;color:#3565d5;font-size:17px}.elle-suggestions b{font-size:12.5px}.elle-suggestions small{grid-column:2;color:#74839a;font-size:10.5px;line-height:1.35}
.elle-messages{display:flex;flex-direction:column;gap:18px;padding:22px 18px}.elle-message{display:flex;align-items:flex-start;gap:9px;max-width:100%}.elle-message--user{justify-content:flex-end}.elle-avatar{display:grid;place-items:center;flex:0 0 30px;width:30px;height:30px;border-radius:10px;background:linear-gradient(145deg,#5f8fff,#294fc1);color:#fff;font-size:12px;font-weight:800}.elle-bubble{max-width:320px;padding:11px 13px;border:1px solid #e1e7f0;border-radius:5px 15px 15px;background:#fff;color:#243550;font-size:13px;line-height:1.58;box-shadow:0 4px 15px rgba(25,50,90,.05)}.elle-message--user .elle-bubble{border:0;border-radius:15px 15px 5px;background:#173660;color:#fff;box-shadow:none}.elle-bubble--error{border-color:#f3c9c9;background:#fff7f7;color:#9f2f2f}.elle-response{min-width:0;flex:1}.elle-response .elle-bubble{max-width:none}.elle-sources{display:flex;flex-wrap:wrap;gap:6px;margin-top:9px}.elle-sources strong{width:100%;color:#64758e;font-size:10px;text-transform:uppercase;letter-spacing:.08em}.elle-sources a,.elle-sources span{padding:5px 8px;border:1px solid #dce5f3;border-radius:8px;background:#f7f9fd;color:#315cae;text-decoration:none;font-size:10.5px}.elle-meta{display:flex;flex-wrap:wrap;gap:10px;margin-top:8px;color:#7b8aa0;font-size:9.5px}.elle-confidence{color:#27805e}.elle-confidence i{display:inline-block;width:6px;height:6px;margin-right:4px;border-radius:50%;background:#39b987}.elle-tools{display:flex;gap:5px;margin-top:7px}.elle-tools button{padding:4px 7px;border:0;border-radius:6px;background:transparent;color:#718199;font-size:10px;cursor:pointer}.elle-tools button:hover,.elle-tools button.is-selected{background:#edf3ff;color:#315eb8}.elle-tools button:disabled{cursor:default}.elle-typing{display:flex;gap:4px;width:50px;padding:14px}.elle-typing i{width:6px;height:6px;border-radius:50%;background:#7c91af;animation:elle-bounce 1s infinite}.elle-typing i:nth-child(2){animation-delay:.15s}.elle-typing i:nth-child(3){animation-delay:.3s}@keyframes elle-bounce{0%,60%,100%{transform:translateY(0);opacity:.45}30%{transform:translateY(-4px);opacity:1}}
.elle-composer-wrap{padding:12px 14px 10px;border-top:1px solid #e5ebf3;background:#fff}.elle-composer{display:flex;align-items:flex-end;gap:8px;padding:8px 8px 8px 13px;border:1.5px solid #d5dfed;border-radius:15px;background:#fff;transition:border-color .15s,box-shadow .15s}.elle-composer:focus-within{border-color:#7197e9;box-shadow:0 0 0 3px rgba(65,111,207,.1)}.elle-composer textarea{flex:1;min-height:24px;max-height:120px;padding:4px 0;border:0;outline:0;resize:none;color:#1d2e49;font:13px/1.45 Inter,system-ui,sans-serif}.elle-composer textarea::placeholder{color:#91a0b4}.elle-send{display:grid;place-items:center;flex:0 0 34px;width:34px;height:34px;border:0;border-radius:10px;background:#2759c7;color:#fff;font-size:20px;font-weight:700;cursor:pointer}.elle-send:disabled{background:#d8e0ec;cursor:default}.elle-composer-wrap>p{margin:7px 0 0;text-align:center;color:#9aa7b8;font-size:9px}
@media(max-width:600px){.elle{right:12px;bottom:var(--elle-bottom,12px)}.elle-panel{position:fixed;inset:8px;width:auto;height:auto;border-radius:20px}.elle-suggestions{grid-template-columns:1fr}.elle-launcher{min-width:142px}.elle-welcome{padding-top:24px}}
@media(prefers-reduced-motion:reduce){.elle-panel,.elle-launcher,.elle-suggestions button{transition:none}.elle-typing i{animation:none}}
.elle-orb img,.elle-avatar img,.elle-welcome-mark img{width:100%;height:100%;display:block;object-fit:cover;border-radius:inherit}</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const elle = document.querySelector('.elle');
    const footer = document.querySelector('footer');

    if (!elle || !footer) return;

    const updateEllePosition = () => {
      const footerRect = footer.getBoundingClientRect();
      const overlap = Math.max(0, window.innerHeight - footerRect.top);
      const base = window.innerWidth <= 600 ? 12 : 24;
      elle.style.setProperty('--elle-bottom', `${base + overlap}px`);
    };

    updateEllePosition();
    window.addEventListener('scroll', updateEllePosition, { passive: true });
    window.addEventListener('resize', updateEllePosition);
  });
</script>
