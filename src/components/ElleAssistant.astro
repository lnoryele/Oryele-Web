<div class="elle" data-elle>
  <button class="elle-launcher" type="button" aria-label="Open Elle AI assistant" aria-expanded="false">
    <span class="elle-orb" aria-hidden="true">E</span>
    <span class="elle-launcher-copy"><strong>Ask Elle</strong><small>Oryele AI</small></span>
    <span class="elle-status-dot" aria-hidden="true"></span>
  </button>

  <section class="elle-panel" aria-label="Elle AI assistant" aria-hidden="true">
    <header class="elle-header">
      <div class="elle-identity">
        <span class="elle-orb elle-orb--header" aria-hidden="true">E</span>
        <span><strong>Elle</strong><small><i></i> Online</small></span>
      </div>
      <div class="elle-header-actions">
        <button class="elle-icon-btn" type="button" data-elle-new title="New conversation" aria-label="Start a new conversation">＋</button>
        <button class="elle-icon-btn" type="button" data-elle-close title="Close" aria-label="Close Elle">×</button>
      </div>
    </header>

    <div class="elle-body">
      <div class="elle-welcome" data-elle-welcome>
        <div class="elle-welcome-mark">E</div>
        <h2>How can Elle help?</h2>
        <p>Ask about Oryele, explore platform capabilities, or get guidance on your next workflow.</p>
        <div class="elle-suggestions">
          <button type="button" data-prompt="What can Oryele automate for an accounting firm?"><span>✦</span><b>Explore automation</b><small>See how Oryele supports your firm</small></button>
          <button type="button" data-prompt="Explain how the Oryele Workflow Engine works."><span>↳</span><b>Workflow Engine</b><small>Understand triggers, steps and approvals</small></button>
          <button type="button" data-prompt="What are Oryele Digital Workers?"><span>◎</span><b>Digital Workers</b><small>Discover AI-powered task execution</small></button>
          <button type="button" data-prompt="How does Oryele protect customer data?"><span>◇</span><b>Security and governance</b><small>Learn about controls and oversight</small></button>
        </div>
      </div>
      <div class="elle-messages" data-elle-messages aria-live="polite"></div>
    </div>

    <footer class="elle-composer-wrap">
      <form class="elle-composer" data-elle-form>
        <textarea data-elle-input rows="1" maxlength="2000" placeholder="Ask Elle anything about Oryele…" aria-label="Message Elle"></textarea>
        <button type="button" class="elle-stop" data-elle-stop aria-label="Stop generating" hidden>■</button>
        <button type="submit" class="elle-send" aria-label="Send message" disabled>↑</button>
      </form>
      <p>Elle can make mistakes. Verify important information.</p>
    </footer>
  </section>
</div>

<script is:inline>
(function () {
  var root = document.querySelector('[data-elle]');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = 'true';

  var launcher = root.querySelector('.elle-launcher');
  var panel = root.querySelector('.elle-panel');
  var closeBtn = root.querySelector('[data-elle-close]');
  var newBtn = root.querySelector('[data-elle-new]');
  var stopBtn = root.querySelector('[data-elle-stop]');
  var form = root.querySelector('[data-elle-form]');
  var input = root.querySelector('[data-elle-input]');
  var send = root.querySelector('.elle-send');
  var messagesEl = root.querySelector('[data-elle-messages]');
  var welcome = root.querySelector('[data-elle-welcome]');
  var messages = [];
  var pending = false;
  var controller = null;

  function setOpen(open) {
    root.classList.toggle('is-open', open);
    panel.setAttribute('aria-hidden', open ? 'false' : 'true');
    launcher.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) setTimeout(function () { input.focus(); }, 120);
  }

  launcher.addEventListener('click', function () { setOpen(!root.classList.contains('is-open')); });
  closeBtn.addEventListener('click', function () { setOpen(false); });
  newBtn.addEventListener('click', resetConversation);
  stopBtn.addEventListener('click', function () { if (controller) controller.abort(); });

  root.querySelectorAll('[data-prompt]').forEach(function (button) {
    button.addEventListener('click', function () {
      input.value = button.getAttribute('data-prompt') || '';
      updateComposer();
      form.requestSubmit();
    });
  });

  input.addEventListener('input', updateComposer);
  input.addEventListener('keydown', function (event) {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      if (!send.disabled) form.requestSubmit();
    }
  });

  form.addEventListener('submit', async function (event) {
    event.preventDefault();
    var text = input.value.trim();
    if (!text || pending) return;

    pending = true;
    controller = new AbortController();
    input.value = '';
    welcome.hidden = true;
    appendMessage('user', text);
    messages.push({ role: 'user', content: text });
    var streamMessage = appendStreamingMessage();
    updateComposer();

    try {
      var response = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        signal: controller.signal,
        body: JSON.stringify({
          stream: true,
          messages: messages.slice(-8),
          system: 'You are Elle, Oryele’s warm, precise enterprise AI assistant. Answer directly using concise business language and practical next steps. Keep most answers under 180 words unless detail is essential. The official Oryele support email is support@oryele.com. Never use an @oryele.ai email address.'
        })
      });

      if (!response.ok) {
        var errorText = await response.text();
        throw new Error(errorText || 'Unable to reach Elle');
      }

      var answer = await consumeOpenAIStream(response, function (fullText) {
        updateStreamingMessage(streamMessage, fullText);
      });

      if (!answer.trim()) answer = 'I could not generate a response.';
      finalizeStreamingMessage(streamMessage, answer);
      messages.push({ role: 'assistant', content: answer });
    } catch (error) {
      if (error && error.name === 'AbortError') {
        var partial = streamMessage.dataset.raw || '';
        finalizeStreamingMessage(streamMessage, partial || 'Response stopped.');
        if (partial) messages.push({ role: 'assistant', content: partial });
      } else {
        streamMessage.remove();
        appendMessage('error', 'Elle is temporarily unavailable. Please try again in a moment.');
      }
    } finally {
      pending = false;
      controller = null;
      updateComposer();
      input.focus();
    }
  });

  async function consumeOpenAIStream(response, onUpdate) {
    if (!response.body || !response.body.getReader) {
      var fallback = await response.json();
      return fallback.content && fallback.content[0] ? fallback.content[0].text : '';
    }

    var reader = response.body.getReader();
    var decoder = new TextDecoder();
    var buffer = '';
    var full = '';

    while (true) {
      var result = await reader.read();
      if (result.done) break;
      buffer += decoder.decode(result.value, { stream: true });
      var lines = buffer.split('\n');
      buffer = lines.pop() || '';

      lines.forEach(function (line) {
        line = line.trim();
        if (!line || !line.startsWith('data:')) return;
        var payload = line.slice(5).trim();
        if (!payload || payload === '[DONE]') return;
        try {
          var json = JSON.parse(payload);
          var token = json.choices && json.choices[0] && json.choices[0].delta
            ? json.choices[0].delta.content || ''
            : '';
          if (token) {
            full += token;
            onUpdate(full);
          }
        } catch (_) {}
      });
    }
    return full;
  }

  function updateComposer() {
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight, 120) + 'px';
    send.disabled = pending || !input.value.trim();
    send.hidden = pending;
    stopBtn.hidden = !pending;
  }

  function resetConversation() {
    if (controller) controller.abort();
    messages = [];
    messagesEl.innerHTML = '';
    welcome.hidden = false;
    input.value = '';
    pending = false;
    updateComposer();
    input.focus();
  }

  function appendStreamingMessage() {
    var item = document.createElement('article');
    item.className = 'elle-message elle-message--assistant is-streaming';
    item.dataset.raw = '';
    item.innerHTML = '<div class="elle-avatar">E</div><div class="elle-response"><div class="elle-bubble"><span class="elle-thinking">Thinking</span><span class="elle-cursor"></span></div></div>';
    messagesEl.appendChild(item);
    scrollBottom();
    return item;
  }

  function updateStreamingMessage(item, text) {
    item.dataset.raw = text;
    var bubble = item.querySelector('.elle-bubble');
    if (bubble) bubble.innerHTML = renderMarkdown(text) + '<span class="elle-cursor"></span>';
    scrollBottom();
  }

  function finalizeStreamingMessage(item, text) {
    item.classList.remove('is-streaming');
    item.dataset.raw = text;
    var response = item.querySelector('.elle-response');
    response.innerHTML = '<div class="elle-bubble">' + renderMarkdown(text) + '</div><div class="elle-tools"><button type="button" data-copy>Copy</button><button type="button" data-feedback="true">Helpful</button><button type="button" data-feedback="false">Not helpful</button><span class="elle-tool-status" aria-live="polite"></span></div>';
    bindMessageTools(item, text, null);
    scrollBottom();
  }

  function appendMessage(role, text) {
    var item = document.createElement('article');
    item.className = 'elle-message elle-message--' + role;
    if (role === 'user') {
      item.innerHTML = '<div class="elle-bubble">' + escapeHtml(text).replace(/\n/g, '<br>') + '</div>';
    } else if (role === 'error') {
      item.innerHTML = '<div class="elle-avatar">!</div><div class="elle-bubble elle-bubble--error">' + escapeHtml(text) + '</div>';
    }
    messagesEl.appendChild(item);
    scrollBottom();
  }

  function renderMarkdown(value) {
    var safe = escapeHtml(value || '');
    safe = safe.replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>');
    safe = safe.replace(/`([^`]+)`/g, '<code>$1</code>');
    safe = safe.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    safe = safe.replace(/^### (.+)$/gm, '<h4>$1</h4>');
    safe = safe.replace(/^## (.+)$/gm, '<h3>$1</h3>');
    safe = safe.replace(/^# (.+)$/gm, '<h2>$1</h2>');
    safe = safe.replace(/^[-*] (.+)$/gm, '<li>$1</li>');
    safe = safe.replace(/(<li>[\s\S]*?<\/li>)(?!(?:\s*<li>))/g, '<ul>$1</ul>');
    safe = safe.replace(/\n{2,}/g, '</p><p>');
    safe = safe.replace(/\n/g, '<br>');
    return '<p>' + safe + '</p>';
  }

  function copyText(text) {
    if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(text);
    return new Promise(function (resolve, reject) {
      var area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.appendChild(area);
      area.select();
      try { document.execCommand('copy') ? resolve() : reject(new Error('Copy failed')); }
      catch (error) { reject(error); }
      area.remove();
    });
  }

  function bindMessageTools(item, text, interactionId) {
    var status = item.querySelector('.elle-tool-status');
    var copy = item.querySelector('[data-copy]');
    if (copy) copy.addEventListener('click', async function () {
      try {
        await copyText(text);
        copy.textContent = 'Copied';
        copy.classList.add('is-selected');
        if (status) status.textContent = 'Response copied';
        setTimeout(function () {
          copy.textContent = 'Copy';
          copy.classList.remove('is-selected');
          if (status) status.textContent = '';
        }, 1400);
      } catch (_) { if (status) status.textContent = 'Copy failed'; }
    });

    item.querySelectorAll('[data-feedback]').forEach(function (button) {
      button.addEventListener('click', async function () {
        var helpful = button.getAttribute('data-feedback') === 'true';
        item.querySelectorAll('[data-feedback]').forEach(function (b) {
          b.disabled = true;
          b.classList.toggle('is-selected', b === button);
        });
        button.textContent = helpful ? 'Helpful ✓' : 'Not helpful ✓';
        if (status) status.textContent = 'Thanks for your feedback';
        if (!interactionId) return;
        try {
          await fetch('/api/elle-feedback', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ interaction_id: interactionId, helpful: helpful })
          });
        } catch (_) {}
      });
    });
  }

  function scrollBottom() { requestAnimationFrame(function () { messagesEl.parentElement.scrollTop = messagesEl.parentElement.scrollHeight; }); }
  function escapeHtml(value) { return String(value || '').replace(/[&<>"']/g, function (char) { return ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#039;' })[char]; }); }
}());
</script>

<style>
.elle{position:fixed;right:24px;bottom:24px;z-index:1000;font-family:Inter,system-ui,sans-serif}.elle-launcher{display:flex;align-items:center;gap:11px;min-width:154px;padding:10px 14px 10px 10px;border:1px solid rgba(255,255,255,.16);border-radius:18px;background:#0b1b34;color:#fff;box-shadow:0 18px 50px rgba(5,18,40,.28);cursor:pointer;transition:transform .18s ease,box-shadow .18s ease}.elle-launcher:hover{transform:translateY(-2px);box-shadow:0 22px 58px rgba(5,18,40,.36)}.elle-orb{display:grid;place-items:center;width:38px;height:38px;border-radius:13px;background:linear-gradient(145deg,#5f8fff,#2b55c7);font-size:17px;font-weight:800;box-shadow:inset 0 1px rgba(255,255,255,.35)}.elle-launcher-copy{display:flex;flex-direction:column;align-items:flex-start;line-height:1.15}.elle-launcher-copy strong{font-size:14px}.elle-launcher-copy small{margin-top:3px;color:#9fb2cf;font-size:10.5px}.elle-status-dot{width:7px;height:7px;margin-left:auto;border-radius:50%;background:#45d39a;box-shadow:0 0 0 4px rgba(69,211,154,.12)}
.elle-panel{position:absolute;right:0;bottom:0;display:grid;grid-template-rows:auto minmax(0,1fr) auto;width:min(430px,calc(100vw - 32px));height:min(680px,calc(100vh - 40px));overflow:hidden;border:1px solid #dce4f0;border-radius:24px;background:#fff;box-shadow:0 30px 90px rgba(5,18,40,.28);opacity:0;visibility:hidden;transform:translateY(16px) scale(.97);transform-origin:bottom right;transition:opacity .2s ease,transform .2s ease,visibility .2s}.elle.is-open .elle-panel{opacity:1;visibility:visible;transform:none}.elle.is-open .elle-launcher{opacity:0;visibility:hidden}.elle-header{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid #e8edf5;background:linear-gradient(135deg,#081b37,#102b55);color:#fff}.elle-identity{display:flex;align-items:center;gap:11px}.elle-orb--header{width:40px;height:40px;border-radius:14px}.elle-identity>span:last-child{display:flex;flex-direction:column}.elle-identity strong{font-size:15px}.elle-identity small{margin-top:4px;color:#b9c8df;font-size:11px}.elle-identity small i{display:inline-block;width:6px;height:6px;margin-right:4px;border-radius:50%;background:#43d49b}.elle-header-actions{display:flex;gap:6px}.elle-icon-btn{display:grid;place-items:center;width:34px;height:34px;border:0;border-radius:10px;background:rgba(255,255,255,.08);color:#dfe8f7;font-size:21px;cursor:pointer}.elle-icon-btn:hover{background:rgba(255,255,255,.15);color:#fff}
.elle-body{min-height:0;overflow-y:auto;background:linear-gradient(#f8faff,#fff 180px);scrollbar-width:thin}.elle-welcome{padding:32px 24px 24px;text-align:center}.elle-welcome[hidden]{display:none}.elle-welcome-mark{display:grid;place-items:center;width:58px;height:58px;margin:0 auto 16px;border-radius:20px;background:linear-gradient(145deg,#6f9cff,#294fc1);color:#fff;font-size:25px;font-weight:800;box-shadow:0 12px 30px rgba(47,88,194,.24)}.elle-welcome h2{margin:0;color:#12233e;font-size:23px;letter-spacing:-.03em}.elle-welcome>p{max-width:330px;margin:9px auto 22px;color:#62728a;font-size:13px;line-height:1.55}.elle-suggestions{display:grid;grid-template-columns:1fr 1fr;gap:10px;text-align:left}.elle-suggestions button{display:grid;grid-template-columns:24px 1fr;column-gap:8px;min-height:92px;padding:13px;border:1px solid #e1e8f2;border-radius:15px;background:#fff;color:#1a2b47;cursor:pointer;transition:border-color .15s,transform .15s,box-shadow .15s}.elle-suggestions button:hover{transform:translateY(-1px);border-color:#9eb8ed;box-shadow:0 8px 22px rgba(25,55,105,.08)}.elle-suggestions span{grid-row:1/3;color:#3565d5;font-size:17px}.elle-suggestions b{font-size:12.5px}.elle-suggestions small{grid-column:2;color:#74839a;font-size:10.5px;line-height:1.35}
.elle-messages{display:flex;flex-direction:column;gap:16px;padding:20px 18px}.elle-message{display:flex;align-items:flex-start;gap:9px;max-width:100%}.elle-message--user{justify-content:flex-end}.elle-avatar{display:grid;place-items:center;flex:0 0 30px;width:30px;height:30px;border-radius:10px;background:linear-gradient(145deg,#5f8fff,#294fc1);color:#fff;font-size:12px;font-weight:800}.elle-bubble{max-width:320px;padding:9px 11px;border:1px solid #e1e7f0;border-radius:5px 15px 15px;background:#fff;color:#243550;font-size:11px;line-height:1.48;box-shadow:0 4px 15px rgba(25,50,90,.05)}.elle-bubble p{margin:0 0 8px}.elle-bubble p:last-child{margin-bottom:0}.elle-bubble h2,.elle-bubble h3,.elle-bubble h4{margin:8px 0 5px;color:#152b4c;line-height:1.25}.elle-bubble h2{font-size:14px}.elle-bubble h3{font-size:13px}.elle-bubble h4{font-size:12px}.elle-bubble ul{margin:6px 0;padding-left:18px}.elle-bubble li{margin:3px 0}.elle-bubble pre{overflow:auto;margin:8px 0;padding:9px;border-radius:8px;background:#0f1b2d;color:#edf4ff;font-size:10px}.elle-bubble code{padding:1px 4px;border-radius:4px;background:#eef2f8;font-size:.94em}.elle-bubble pre code{padding:0;background:transparent}.elle-message--user .elle-bubble{border:0;border-radius:15px 15px 5px;background:#173660;color:#fff;box-shadow:none}.elle-bubble--error{border-color:#f3c9c9;background:#fff7f7;color:#9f2f2f}.elle-response{min-width:0;flex:1}.elle-response .elle-bubble{max-width:none}.elle-tools{display:flex;align-items:center;flex-wrap:wrap;gap:5px;margin-top:7px}.elle-tools button{padding:5px 8px;border:1px solid transparent;border-radius:7px;background:transparent;color:#718199;font-size:10px;cursor:pointer}.elle-tools button:hover,.elle-tools button.is-selected{background:#edf3ff;color:#315eb8}.elle-tools button:disabled{cursor:default;opacity:1}.elle-tool-status{margin-left:3px;color:#60728c;font-size:9.5px}.elle-thinking{color:#7b8aa0;font-style:italic}.elle-cursor{display:inline-block;width:2px;height:1em;margin-left:2px;vertical-align:-2px;background:#315eb8;animation:elle-blink .8s steps(1) infinite}@keyframes elle-blink{50%{opacity:0}}
.elle-composer-wrap{padding:12px 14px 10px;border-top:1px solid #e5ebf3;background:#fff}.elle-composer{display:flex;align-items:flex-end;gap:8px;padding:8px 8px 8px 13px;border:1.5px solid #d5dfed;border-radius:15px;background:#fff}.elle-composer:focus-within{border-color:#7197e9;box-shadow:0 0 0 3px rgba(65,111,207,.1)}.elle-composer textarea{flex:1;min-height:24px;max-height:120px;padding:4px 0;border:0;outline:0;resize:none;color:#1d2e49;font:12px/1.45 Inter,system-ui,sans-serif}.elle-composer textarea::placeholder{color:#91a0b4}.elle-send,.elle-stop{display:grid;place-items:center;flex:0 0 34px;width:34px;height:34px;border:0;border-radius:10px;background:#2759c7;color:#fff;font-size:18px;font-weight:700;cursor:pointer}.elle-stop{background:#173660;font-size:12px}.elle-send:disabled{background:#d8e0ec;cursor:default}.elle-composer-wrap>p{margin:7px 0 0;text-align:center;color:#9aa7b8;font-size:9px}
@media(max-width:600px){.elle{right:12px;bottom:12px}.elle-panel{position:fixed;inset:8px;width:auto;height:auto;border-radius:20px}.elle-suggestions{grid-template-columns:1fr}.elle-launcher{min-width:142px}.elle-welcome{padding-top:24px}.elle-bubble{font-size:10.75px;line-height:1.46}}
@media(prefers-reduced-motion:reduce){.elle-panel,.elle-launcher,.elle-suggestions button{transition:none}.elle-cursor{animation:none}}
</style>
