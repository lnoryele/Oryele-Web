---
import Logo from "./Logo.astro";
const year = new Date().getFullYear();
const linkGroups = [
  {
    title: 'Platform',
    links: [
      ['Overview','/platform/'],
      ['Digital Workforce','/platform/digital-workforce/'],
      ['Workflow Engine','/platform/workflow-engine/'],
      ['Knowledge','/platform/knowledge/']
    ]
  },
  {
    title: 'Company',
    links: [
      ['Why Oryele','/company/'],
      ['Careers','/careers/'],
      ['Contact','/contact/'],
      ['Help Center','/support/']
    ]
  },
  {
    title: 'Resources',
    links: [
      ['Documentation','/resources/documentation/'],
      ['White Papers','/resources/white-papers/'],
      ['Trust Center','/trust/'],
      ['Sitemap','/sitemap/']
    ]
  },
  {
    title: 'Legal',
    links: [
      ['Privacy Policy','/privacy/'],
      ['Terms & Conditions','/terms/'],
      ['Cookie Policy','/cookie-policy/'],
      ['SMS Consent','/sms-consent/']
    ]
  }
];
---
<footer class="footer">
  <div class="wrap footer-newsletter">
    <div class="nl-copy">
      <p class="nl-kicker">Oryele Insights</p>
      <h2>Stay informed without the noise.</h2>
      <p>Product updates, platform insights, and practical guidance for professional services firms.</p>
    </div>

    <form class="nl-form" id="nl-form" novalidate>
      <div class="nl-input-wrap">
        <input id="nl-email" type="email" placeholder="Enter your email address" autocomplete="email" aria-label="Email address for newsletter" required />
        <button type="submit" class="nl-btn" id="nl-btn">Subscribe</button>
      </div>
      <p class="nl-consent">By subscribing, you consent to receive Oryele product updates and marketing communications. You may unsubscribe at any time. See our <a href="/privacy/">Privacy Policy</a>.</p>
      <p class="nl-msg" id="nl-msg" hidden></p>
    </form>
  </div>

  <div class="wrap footer-content">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="Oryele home"><Logo variant="light" height={34} /></a>
      <p>Enterprise execution for teams that need work to move with clarity, control, and speed.</p>
      <div class="footer-social">
        <a href="https://www.linkedin.com/company/oryele" target="_blank" rel="noopener" aria-label="Oryele on LinkedIn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8h4V23h-4V8zm7.5 0h3.8v2.05h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V23h-4v-7.9c0-1.88-.03-4.3-2.62-4.3-2.62 0-3.02 2.05-3.02 4.16V23H8V8z"/></svg>
        </a>
        <a href="https://www.youtube.com/@Oryele" target="_blank" rel="noopener" aria-label="Oryele on YouTube">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 00-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 00.5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 002.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 002.1-2.1C24 15.9 24 12 24 12s0-3.9-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg>
        </a>
      </div>
    </div>

    <nav class="footer-links" aria-label="Footer navigation">
      {linkGroups.map((group) => (
        <div class="footer-group">
          <p>{group.title}</p>
          {group.links.map(([label, href]) => <a href={href}>{label}</a>)}
        </div>
      ))}
    </nav>
  </div>

  <div class="wrap footer-bottom">
    <p>© {year} Oryele. All rights reserved.</p>
    <p>Built for governed enterprise execution.</p>
  </div>
</footer>

<script is:inline>
(function () {
  var form  = document.getElementById('nl-form');
  var input = document.getElementById('nl-email');
  var btn   = document.getElementById('nl-btn');
  var msg   = document.getElementById('nl-msg');
  if (!form) return;

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    var email = (input ? input.value : '').trim();
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showMsg('Please enter a valid email address.', 'error');
      return;
    }
    btn.disabled = true;
    btn.textContent = 'Subscribing...';
    try {
      var fd = new FormData();
      fd.append('formType', 'newsletter');
      fd.append('Email', email);
      fd.append('Source', 'Newsletter footer');
      var res = await fetch('/api/form', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: fd,
      });
      var data = await res.json();
      if (data.ok) {
        showMsg(data.message || 'You are subscribed. Welcome aboard.', 'ok');
        if (input) input.value = '';
        btn.textContent = 'Subscribed';
      } else {
        throw new Error(data.error || 'Failed');
      }
    } catch (err) {
      btn.disabled = false;
      btn.textContent = 'Subscribe';
      showMsg((err && err.message) || 'Something went wrong. Please try again or email info@oryele.com.', 'error');
    }
  });

  function showMsg(text, type) {
    if (!msg) return;
    msg.textContent = text;
    msg.className = 'nl-msg nl-msg--' + type;
    msg.hidden = false;
  }
}());
</script>

<style>
.footer{background:#071528;color:#c7d2e4;border-top:1px solid rgba(255,255,255,.1)}
.footer-newsletter{display:grid;grid-template-columns:minmax(0,1fr) minmax(420px,540px);gap:64px;align-items:center;padding-block:48px;border-bottom:1px solid rgba(255,255,255,.09)}
.nl-kicker{margin:0 0 8px;color:#6ea0ff;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
.nl-copy h2{margin:0 0 10px;color:#fff;font-size:clamp(24px,2.2vw,34px);line-height:1.15;letter-spacing:-.03em}
.nl-copy>p:last-child{margin:0;max-width:620px;color:#8fa3bd;font-size:14px;line-height:1.65}
.nl-form{width:100%}.nl-input-wrap{display:flex;overflow:hidden;border:1px solid rgba(255,255,255,.16);border-radius:10px;background:rgba(255,255,255,.05)}
.nl-input-wrap:focus-within{border-color:#5d8cff;box-shadow:0 0 0 3px rgba(55,104,220,.18)}
#nl-email{flex:1;min-width:0;padding:14px 16px;background:transparent;border:0;outline:0;color:#fff;font:inherit;font-size:14px}
#nl-email::placeholder{color:#59708d}.nl-btn{padding:14px 24px;border:0;background:#2e5dcc;color:#fff;font:inherit;font-size:14px;font-weight:800;cursor:pointer}.nl-btn:hover{background:#3d6cdd}.nl-btn:disabled{opacity:.65;cursor:not-allowed}
.nl-consent{margin:9px 0 0;color:#8394aa;font-size:11px;line-height:1.55}.nl-consent a{color:#b8c6d9}.nl-msg{margin:8px 0 0;font-size:12px}.nl-msg--ok{color:#34d399}.nl-msg--error{color:#f87171}
.footer-content{display:grid;grid-template-columns:minmax(240px,1.15fr) minmax(0,2fr);gap:72px;padding-block:48px 42px}
.footer-brand p{max-width:330px;margin:18px 0 22px;color:#8fa3bd;font-size:14px;line-height:1.65}.brand{display:inline-flex}.footer-social{display:flex;gap:12px}.footer-social a{display:grid;place-items:center;width:36px;height:36px;border:1px solid rgba(255,255,255,.12);border-radius:9px;color:#b9c7da;text-decoration:none}.footer-social a:hover{color:#fff;border-color:rgba(255,255,255,.28);background:rgba(255,255,255,.05)}
.footer-links{display:grid;grid-template-columns:repeat(4,minmax(120px,1fr));gap:32px}.footer-group{display:flex;flex-direction:column;gap:10px}.footer-group p{margin:0 0 4px;color:#fff;font-size:13px;font-weight:800}.footer-group a{color:#98aac1;text-decoration:none;font-size:13px;line-height:1.4}.footer-group a:hover{color:#fff}
.footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:20px;padding-block:18px 24px;border-top:1px solid rgba(255,255,255,.09);color:#7f91a8;font-size:12px}.footer-bottom p{margin:0}
@media(max-width:980px){.footer-newsletter{grid-template-columns:1fr;gap:28px}.footer-content{grid-template-columns:1fr;gap:36px}.footer-links{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){.footer-newsletter{padding-block:36px}.nl-input-wrap{flex-direction:column}.nl-btn{width:100%}.footer-content{padding-block:36px}.footer-links{grid-template-columns:1fr 1fr;gap:28px 18px}.footer-bottom{align-items:flex-start;flex-direction:column;gap:6px}}
</style>
