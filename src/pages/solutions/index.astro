---
import BaseLayout from "../../layouts/BaseLayout.astro";

const verticals = [
  {
    id: "accounting",
    icon: "calc",
    label: "Accounting Firms",
    whitepaper: "/assets/oryele-white-paper-accounting.pdf",
    headline: "Built for accounting firms that need to scale without adding headcount.",
    body: "Oryele gives accounting firms a single platform to manage client communications, document intake, engagement letter tracking, and compliance workflows. Digital workers handle the repetitive tasks follow-ups, reminders, document requests so your team stays focused on advisory work.",
    outcomes: [
      "Automate client onboarding and document collection",
      "Track engagement letters from send to signature",
      "Structured workflows for tax season surge capacity",
      "Audit-ready records on every client interaction",
      "TCPA-compliant SMS and email communications",
    ],
  },
  {
    id: "insurance",
    icon: "shield",
    label: "Insurance",
    whitepaper: "/assets/oryele-white-paper-insurance.pdf",
    headline: "Streamline claims, renewals, and client communications at scale.",
    body: "Insurance operations are high-volume and time-sensitive. Oryele orchestrates intake, triage, and follow-through across claims and renewals, with digital workers that keep clients informed and nothing falls between the cracks.",
    outcomes: [
      "Automate first notice of loss intake and routing",
      "Renewal reminder sequences with SMS and email",
      "Document collection with status tracking",
      "Role-based access so adjusters see only what they need",
      "Real-time dashboards on open claims and response times",
    ],
  },
  {
    id: "legal",
    icon: "gavel",
    label: "Legal",
    whitepaper: "/assets/oryele-white-paper-legal.pdf",
    headline: "Matter management and client intake that works the way law firms do.",
    body: "Legal teams operate under strict confidentiality and compliance requirements. Oryele brings structure to client intake, document management, and internal workflows without compromising security or creating new compliance risk.",
    outcomes: [
      "Structured client intake with conflict checks built in",
      "Secure document storage organized by matter",
      "Legal hold and chain of custody tracking",
      "Automated deadline reminders and calendar sync",
      "Complete audit trails for every matter interaction",
    ],
  },
  {
    id: "finance",
    icon: "dollar",
    label: "Finance",
    headline: "Operations infrastructure for financial services firms.",
    body: "From wealth management to lending, financial services firms run on tight compliance requirements and high client expectations. Oryele delivers the automation and governance infrastructure to meet both.",
    outcomes: [
      "Automated client onboarding and KYC document collection",
      "Workflow automation for loan processing and approvals",
      "Compliant communications with full audit trail",
      "Role-based access aligned to regulatory requirements",
      "Real-time visibility into portfolio and case status",
    ],
  },
  {
    id: "executive",
    icon: "bolt",
    label: "Executive Operations",
    headline: "Give your leadership team leverage without adding overhead.",
    body: "Executive operations teams coordinate across every function in the business. Oryele gives chiefs of staff, COOs, and EA teams the automation and visibility to run operations at a higher level.",
    outcomes: [
      "Digital workers for scheduling, follow-up, and coordination",
      "Cross-functional workflow management in one view",
      "Automated reporting and status updates for leadership",
      "Communications orchestration across email, SMS, and voice",
      "Full operational audit trail for accountability",
    ],
  },
];

const svgs: Record<string, string> = {
  calc: `<path d="M5 3h10a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2zm2 4h6M7 11h2m4 0h2M7 15h2m4 0h2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
  shield: `<path d="M12 3l7 3v5c0 4.8-3 8-7 10-4-2-7-5.2-7-10V6l7-3z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9.2 12l2 2 3.6-3.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
  gavel: `<path d="M8.5 4.5l7 7M6.5 6.5l7 7M7.5 5.5l-3.4 3.4M14.5 12.5l-3.4 3.4M10.5 8.5l-7.5 7.5 1.4 1.4 7.5-7.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M11 18h7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
  dollar: `<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 6.5v11M15 8.8c-.6-1-1.7-1.5-3-1.5-1.7 0-3 .9-3 2.3 0 3 6 1.7 6 4.7 0 1.4-1.3 2.3-3 2.3-1.3 0-2.4-.5-3-1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
  bolt: `<path d="M13 2L5 13h5l-1 9 8-11h-5l1-9z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
};
---
<BaseLayout
  title="Oryele Solutions | AI Automation for Accounting, Legal & Insurance"
  description="Oryele delivers purpose-built workflow automation and digital workers for accounting firms, insurance, legal, finance, and executive operations teams."
>
  <section class="sol-hero">
    <div class="wrap">
      <p class="eyebrow">Solutions</p>
      <h1>Built for Professional Services</h1>
      <p class="lede">
        Oryele is purpose-built for firms where process discipline, compliance, and client experience are non-negotiable. Choose your vertical to see how the platform applies to your operations.
      </p>
      <div class="jump-links">
        {verticals.map((v) => (
          <a href={`#${v.id}`} class="jump">{v.label}</a>
        ))}
      </div>
    </div>
  </section>

  {verticals.map((v, i) => (
    <section class={`vertical ${i % 2 === 1 ? "alt" : ""}`} id={v.id}>
      <div class="wrap vertical-inner">
        <div class="vertical-copy">
          <div class="v-label">
            <span class="v-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" set:html={svgs[v.icon]} />
            </span>
            <span class="eyebrow" style="margin:0">{v.label}</span>
          </div>
          <h2>{v.headline}</h2>
          <p class="v-body">{v.body}</p>
          <div class="v-actions">
            <a class="btn btn-blue" href="/contact/">Talk to us about {v.label} <span class="arrow">→</span></a>
            {v.whitepaper && (
              <a class="btn btn-outline-blue" href={v.whitepaper} target="_blank" rel="noopener">Download White Paper</a>
            )}
          </div>
        </div>
        <div class="vertical-outcomes">
          <p class="outcomes-label">What you get</p>
          <ul>
            {v.outcomes.map((o) => (
              <li>
                <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M4 10.5l4 4 8-9" fill="none" stroke="var(--blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {o}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  ))}

  <section class="sol-cta">
    <div class="wrap">
      <h2>Not sure where to start?</h2>
      <p>Our team will walk you through how Oryele maps to your specific operations and answer every question before you commit to anything.</p>
      <a class="btn btn-blue" href="/contact/">Request a Demo <span class="arrow">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .sol-hero {
    background: var(--paper-2);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(52px, 6vw, 88px);
  }
  h1 { font-size: clamp(34px, 4vw, 52px); font-weight: 800; margin: 0 0 20px; }
  .lede { font-size: clamp(16px, 1.5vw, 19px); color: #33415a; max-width: 620px; margin: 0 0 34px; }
  .jump-links { display: flex; flex-wrap: wrap; gap: 10px; }
  .jump {
    display: inline-flex; align-items: center;
    padding: 9px 18px;
    border: 1.5px solid var(--line);
    border-radius: 8px;
    font-size: 14px; font-weight: 600;
    text-decoration: none; color: var(--text);
    transition: border-color 140ms, background 140ms;
  }
  .jump:hover { border-color: var(--blue); background: var(--blue-soft); color: var(--blue); }

  .vertical { padding-block: clamp(60px, 7vw, 96px); border-bottom: 1px solid var(--line); }
  .vertical.alt { background: var(--paper-2); }
  .vertical-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .v-label { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; }
  .v-icon {
    display: grid; place-items: center;
    width: 40px; height: 40px;
    border-radius: 10px;
    background: var(--blue-soft);
    color: var(--blue);
    flex-shrink: 0;
  }
  h2 { font-size: clamp(24px, 3vw, 36px); font-weight: 800; margin-bottom: 18px; }
  .v-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .v-body { font-size: 16.5px; color: #33415a; line-height: 1.65; margin: 0 0 28px; }
  .vertical-outcomes {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px 30px;
    box-shadow: var(--shadow-card);
  }
  .outcomes-label {
    font-size: 12px; font-weight: 800;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--blue); margin: 0 0 16px;
  }
  .vertical-outcomes ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .vertical-outcomes li {
    display: flex; align-items: flex-start; gap: 10px;
    font-size: 15px; color: #33415a; line-height: 1.5;
  }
  .vertical-outcomes svg { flex-shrink: 0; margin-top: 3px; }

  .sol-cta {
    background: var(--navy);
    color: #fff;
    text-align: center;
    padding-block: clamp(56px, 7vw, 96px);
  }
  .sol-cta h2 { font-size: clamp(26px, 3vw, 40px); color: #fff; margin-bottom: 16px; }
  .sol-cta p { font-size: 17px; color: var(--text-inv-2); max-width: 560px; margin: 0 auto 32px; }

  @media (max-width: 860px) {
    .vertical-inner { grid-template-columns: 1fr; }
  }
</style>
