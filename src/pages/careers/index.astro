---
import BaseLayout from '../../layouts/BaseLayout.astro';

const values = [
  { title: 'Innovate Boldly', body: 'We challenge the status quo and push the boundaries of what is possible.', icon: '<path d="M12 2a10 10 0 100 20A10 10 0 0012 2zm0 18a8 8 0 110-16 8 8 0 010 16zm-1-13h2v6h-2zm0 8h2v2h-2z"/>' },
  { title: 'Win Together', body: 'We collaborate openly, support each other, and celebrate every win as a team.', icon: '<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>' },
  { title: 'Act with Integrity', body: 'We build trust through transparency, respect, and a commitment to doing what is right.', icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>' },
  { title: 'Drive Impact', body: 'We are passionate about solving real problems and delivering meaningful results for our customers and communities.', icon: '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 010 20M12 2a15.3 15.3 0 000 20"/>' },
];

const benefits = [
  { title: 'Competitive Compensation', body: 'We reward your talent and contributions.', icon: '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>' },
  { title: 'Health and Wellness', body: 'Comprehensive benefits to support you and your loved ones.', icon: '<path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>' },
  { title: 'Flexible Work', body: 'Hybrid-first culture with flexibility that works for you.', icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>' },
  { title: 'Purpose-Driven Work', body: 'Solve meaningful problems and create real impact.', icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>' },
  { title: 'Growth and Learning', body: 'Continuous learning, mentorship, and career advancement.', icon: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>' },
  { title: 'Inclusive Culture', body: 'Diversity, equity, and belonging are in our DNA.', icon: '<circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>' },
];
---
<BaseLayout title="Careers at Oryele | Build Meaningful Work" description="Join Oryele and help build the AI foundation for smarter organizations.">

  <!-- HERO with background image -->
  <section class="career-hero">
    <div class="hero-bg"></div>
    <div class="wrap hero-layout">
      <div class="hero-copy">
        <h1>Build the Future.<br/>Make It Meaningful.</h1>
        <p>At Oryele, we are building the AI foundation for smarter organizations and a better world. Join a team of innovators driven by purpose, collaboration, and impact.</p>
        <div class="hero-btns">
          <a class="btn btn-blue" href="#apply">View Open Roles &#8594;</a>
          <a class="btn btn-outline-inv" href="#vision">Our Culture &#9654;</a>
        </div>
      </div>
      <div class="hero-form" id="apply">
        <div class="form-card">
          <p class="form-title">Join Our Team</p>
          <p class="form-sub">Ready to build the future with us? Fill out the form below and attach your resume.</p>
          <form action="https://formsubmit.co/hr@oryele.com" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="_subject" value="New job application from oryele.ai" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_next" value="https://oryele.ai/careers/?applied=true" />
            <div class="ff"><label>Full Name *</label><input type="text" name="Name" placeholder="Your full name" required /></div>
            <div class="ff"><label>Email *</label><input type="email" name="Email" placeholder="you@example.com" required /></div>
            <div class="ff-row">
              <div class="ff"><label>Phone Number</label><input type="tel" name="Phone" placeholder="(123) 456-7890" /></div>
              <div class="ff"><label>Current Title</label><input type="text" name="Title" placeholder="Your current role" /></div>
            </div>
            <div class="ff">
              <label>Department of Interest *</label>
              <select name="Area" required>
                <option value="">Select a department</option>
                <option>Engineering</option>
                <option>Product</option>
                <option>Operations</option>
                <option>Sales and Partnerships</option>
                <option>Customer Success</option>
                <option>Marketing</option>
                <option>Other</option>
              </select>
            </div>
            <div class="ff"><label>Tell us about yourself *</label><textarea name="Message" rows="4" placeholder="What excites you about working at Oryele?" required></textarea></div>
            <div class="ff">
              <label>Upload Resume *</label>
              <label class="file-zone" for="resume-input">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0018 9h-1.26A8 8 0 103 16.3"/></svg>
                <span>Drag and drop your resume here<br/><strong>or click to browse</strong></span>
                <small>PDF, DOCX (Max 5MB)</small>
                <input id="resume-input" type="file" name="Resume" accept=".pdf,.doc,.docx" required />
              </label>
              <p class="file-name" id="file-name"></p>
            </div>
            <button type="submit" class="btn btn-blue submit-btn">Submit Application &#8594;</button>
          </form>
          {Astro.url.searchParams.get('applied') === 'true' && (
            <div class="success-msg">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              Application received. We will be in touch.
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- VISION -->
  <section class="vision-section" id="vision">
    <div class="wrap vision-wrap">
      <p class="eyebrow-blue">Our Vision</p>
      <h2>Intelligence. Empowered.</h2>
      <p class="vision-lede">We envision a world where every organization can harness trusted AI to make better decisions, accelerate outcomes, and create lasting value. We are not just building software, we are building the future of work.</p>
      <div class="values-grid">
        {values.map(v => (
          <div class="value-card">
            <div class="value-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" set:html={v.icon}></svg>
            </div>
            <p class="value-title">{v.title}</p>
            <p class="value-body">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY ORYELE -->
  <section class="why-section">
    <div class="wrap why-grid">
      <div class="why-copy">
        <p class="eyebrow-light">Why Oryele</p>
        <h2>More Than a Job.<br/>A Launchpad for Impact.</h2>
        <p>We invest in our people, their growth, well-being, and success. Because when you thrive, we all thrive.</p>
      </div>
      <div class="benefits-grid">
        {benefits.map(b => (
          <div class="benefit-item">
            <div class="benefit-icon">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" set:html={b.icon}></svg>
            </div>
            <div>
              <p class="benefit-title">{b.title}</p>
              <p class="benefit-body">{b.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LIFE AT ORYELE -->
  <section class="life-section">
    <div class="wrap">
      <p class="eyebrow-blue">Why Oryele</p>
      <h2>People. Purpose. Progress.</h2>
      <p class="vision-lede">We are a global team of thinkers, builders, and dreamers. Here is a glimpse of life at Oryele.</p>
      <div class="team-photo">
        <img src="/careers-team.png" alt="Life at Oryele" />
      </div>
    </div>
  </section>

  <!-- DONT SEE A ROLE -->
  <section class="no-role">
    <div class="wrap no-role-inner">
      <div class="no-role-icon">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </div>
      <div>
        <p class="no-role-title">Don't See the Right Role?</p>
        <p class="no-role-sub">We are always looking for exceptional talent. Send us your resume and let's start a conversation.</p>
      </div>
      <a class="btn btn-outline-blue" href="#apply">Send General Application &#8594;</a>
    </div>
  </section>

</BaseLayout>

<script is:inline>
(function () {
  var input = document.getElementById('resume-input');
  var name  = document.getElementById('file-name');
  if (input && name) {
    input.addEventListener('change', function () {
      if (input.files && input.files[0]) name.textContent = input.files[0].name;
    });
  }
}());
</script>

<style>
  /* HERO */
  .career-hero { position: relative; min-height: 100vh; color: #fff; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; background: url('/careers-hero.png') center center / cover no-repeat; }
  .hero-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to right, rgba(5,12,30,.85) 0%, rgba(5,12,30,.6) 50%, rgba(5,12,30,.3) 100%); }
  .hero-layout { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 420px; gap: 60px; align-items: center; padding-block: 120px 80px; }
  .hero-copy h1 { font-size: clamp(40px, 5.5vw, 72px); font-weight: 900; line-height: 1.04; margin: 0 0 22px; letter-spacing: -.025em; }
  .hero-copy p { font-size: clamp(15px, 1.4vw, 18px); color: rgba(255,255,255,.8); line-height: 1.7; margin: 0 0 32px; max-width: 480px; }
  .hero-btns { display: flex; gap: 14px; flex-wrap: wrap; }

  /* FORM CARD */
  .form-card { background: #fff; border-radius: 16px; padding: 28px; box-shadow: 0 24px 64px rgba(0,0,0,.3); }
  .form-title { font-size: 19px; font-weight: 800; margin: 0 0 5px; color: var(--navy); }
  .form-sub { font-size: 13px; color: var(--text-2); margin: 0 0 20px; line-height: 1.5; }
  form { display: grid; gap: 12px; }
  .ff { display: grid; gap: 4px; }
  .ff label { font-size: 12px; font-weight: 700; color: var(--text); }
  .ff input, .ff select, .ff textarea { font-family: inherit; font-size: 13.5px; color: var(--text); border: 1.5px solid var(--line); border-radius: 8px; padding: 9px 11px; background: var(--paper-2); outline: none; transition: border-color 140ms; width: 100%; box-sizing: border-box; }
  .ff input:focus, .ff select:focus, .ff textarea:focus { border-color: var(--blue); background: #fff; }
  .ff textarea { resize: vertical; }
  .ff-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .file-zone { display: flex; flex-direction: column; align-items: center; gap: 4px; border: 2px dashed var(--line); border-radius: 10px; padding: 16px; text-align: center; cursor: pointer; background: var(--paper-2); transition: border-color 140ms; position: relative; }
  .file-zone:hover { border-color: var(--blue); background: var(--blue-soft); }
  .file-zone svg { stroke: var(--blue); margin-bottom: 4px; }
  .file-zone span { font-size: 12.5px; color: var(--text-2); line-height: 1.5; }
  .file-zone strong { color: var(--blue); }
  .file-zone small { font-size: 11px; color: #8896ad; }
  .file-zone input[type="file"] { position: absolute; inset: 0; opacity: 0; width: 100%; height: 100%; cursor: pointer; }
  .file-name { font-size: 11.5px; color: #059669; font-weight: 600; margin: 2px 0 0; min-height: 14px; }
  .submit-btn { width: 100%; justify-content: center; padding: 12px; font-size: 14px; margin-top: 4px; }
  .success-msg { display: flex; align-items: center; gap: 8px; margin-top: 14px; padding: 12px 14px; background: #ecfdf5; border: 1px solid #6ee7b7; border-radius: 8px; font-size: 13px; font-weight: 600; color: #065f46; }
  .success-msg svg { stroke: #059669; flex-shrink: 0; }

  /* VISION */
  .vision-section { padding-block: clamp(64px, 7vw, 100px); }
  .vision-wrap { text-align: center; }
  .eyebrow-blue { font-size: 11px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: var(--blue); margin: 0 0 14px; }
  .eyebrow-light { font-size: 11px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: #60a5fa; margin: 0 0 14px; }
  .vision-section h2, .why-section h2, .life-section h2 { font-size: clamp(28px, 3.5vw, 46px); font-weight: 800; margin: 0 0 16px; letter-spacing: -.02em; }
  .vision-lede { font-size: 17px; color: #33415a; line-height: 1.7; margin: 0 0 48px; max-width: 720px; margin-left: auto; margin-right: auto; }
  .values-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; text-align: left; }
  .value-card { border: 1px solid var(--line); border-radius: 16px; padding: 24px; background: #fff; box-shadow: var(--shadow-card); }
  .value-icon { width: 40px; height: 40px; background: var(--blue-soft); border-radius: 10px; display: grid; place-items: center; margin-bottom: 14px; color: var(--blue); }
  .value-icon svg { stroke: var(--blue); }
  .value-title { font-size: 14.5px; font-weight: 700; margin: 0 0 8px; color: var(--text); }
  .value-body { font-size: 13px; color: #44526a; line-height: 1.6; margin: 0; }

  /* WHY */
  .why-section { background: var(--navy); color: #fff; padding-block: clamp(64px, 7vw, 100px); }
  .why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: start; }
  .why-copy h2 { color: #fff; }
  .why-copy p { font-size: 16px; color: #9aa9c3; line-height: 1.7; margin: 0; }
  .benefits-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .benefit-item { display: flex; gap: 14px; align-items: flex-start; }
  .benefit-icon { width: 36px; height: 36px; background: rgba(255,255,255,.08); border-radius: 9px; display: grid; place-items: center; flex-shrink: 0; }
  .benefit-icon svg { stroke: #60a5fa; }
  .benefit-title { font-size: 13.5px; font-weight: 700; margin: 0 0 3px; color: #fff; }
  .benefit-body { font-size: 12.5px; color: #9aa9c3; line-height: 1.55; margin: 0; }

  /* LIFE */
  .life-section { padding-block: clamp(64px, 7vw, 100px); }
  .life-section .vision-lede { margin-bottom: 36px; }
  .team-photo { border-radius: 16px; overflow: hidden; box-shadow: 0 20px 60px rgba(11,21,38,.12); }
  .team-photo img { width: 100%; display: block; }

  /* NO ROLE */
  .no-role { background: var(--paper-2); border-top: 1px solid var(--line); padding-block: 40px; }
  .no-role-inner { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .no-role-icon { width: 52px; height: 52px; background: var(--blue-soft); border-radius: 12px; display: grid; place-items: center; flex-shrink: 0; }
  .no-role-icon svg { stroke: var(--blue); }
  .no-role-title { font-size: 16px; font-weight: 700; margin: 0 0 4px; }
  .no-role-sub { font-size: 13.5px; color: var(--text-2); margin: 0; }
  .no-role-inner .btn { margin-left: auto; flex-shrink: 0; white-space: nowrap; }

  /* RESPONSIVE */
  @media (max-width: 1024px) { .hero-layout { grid-template-columns: 1fr; } .hero-form { max-width: 480px; } .values-grid { grid-template-columns: 1fr 1fr; } .why-grid { grid-template-columns: 1fr; gap: 40px; } }
  @media (max-width: 640px) { .values-grid, .benefits-grid, .ff-row { grid-template-columns: 1fr; } .no-role-inner .btn { margin-left: 0; } }
</style>
