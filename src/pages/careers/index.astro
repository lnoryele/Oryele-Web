---
import BaseLayout from '../../layouts/BaseLayout.astro';

const values = [
  { title: 'Innovate Boldly', body: 'We challenge the status quo and push the boundaries of what is possible.' },
  { title: 'Win Together', body: 'We collaborate openly, support each other, and celebrate every win as a team.' },
  { title: 'Act with Integrity', body: 'We build trust through transparency, respect, and a commitment to doing what is right.' },
  { title: 'Drive Impact', body: 'We are passionate about solving real problems and delivering meaningful results for our customers and communities.' },
];

const benefits = [
  { title: 'Competitive Compensation', body: 'We reward your talent and contributions.' },
  { title: 'Health and Wellness', body: 'Comprehensive benefits to support you and your loved ones.' },
  { title: 'Flexible Work', body: 'Hybrid-first culture with flexibility that works for you.' },
  { title: 'Purpose-Driven Work', body: 'Solve meaningful problems and create real impact.' },
  { title: 'Growth and Learning', body: 'Continuous learning, mentorship, and career advancement.' },
  { title: 'Inclusive Culture', body: 'Diversity, equity, and belonging are in our DNA.' },
];
---
<BaseLayout title="Careers at Oryele | Build Meaningful Work" description="Join Oryele and help build the AI foundation for smarter organizations. Submit a general application today.">

  <!-- HERO -->
  <section class="career-hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1>Build the Future.<br/>Make It Meaningful.</h1>
        <p>At Oryele, we are building the AI foundation for smarter organizations and a better world. Join a team of innovators driven by purpose, collaboration, and impact.</p>
        <div class="hero-actions">
          <a class="btn btn-outline-inv" href="#vision">Our Culture &#9654;</a>
        </div>
      </div>
    </div>
    <!-- Sticky form overlapping hero bottom -->
    <div class="wrap hero-form-anchor">
      <div class="form-card" id="apply">
        <p class="form-heading">Join Our Team</p>
        <p class="form-sub">Ready to build the future with us? Fill out the form below and attach your resume.</p>
        <form action="https://formsubmit.co/hr@oryele.com" method="POST" enctype="multipart/form-data" class="apply-form">
          <input type="hidden" name="_subject" value="New job application from oryele.ai" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_next" value="https://oryele.ai/careers/?applied=true" />
          <div class="form-field">
            <label for="c-name">Full Name *</label>
            <input id="c-name" type="text" name="Name" placeholder="Your full name" required />
          </div>
          <div class="form-field">
            <label for="c-email">Email *</label>
            <input id="c-email" type="email" name="Email" placeholder="you@example.com" required />
          </div>
          <div class="form-row-2">
            <div class="form-field">
              <label for="c-phone">Phone Number</label>
              <input id="c-phone" type="tel" name="Phone" placeholder="(123) 456-7890" />
            </div>
            <div class="form-field">
              <label for="c-title">Current Title</label>
              <input id="c-title" type="text" name="Title" placeholder="Your current role" />
            </div>
          </div>
          <div class="form-field">
            <label for="c-area">Department of Interest *</label>
            <select id="c-area" name="Area" required>
              <option value="">Select a department</option>
              <option>Engineering</option>
              <option>Product</option>
              <option>Operations</option>
              <option>Sales and Partnerships</option>
              <option>Customer Success</option>
              <option>Marketing</option>
              <option>Other</option>
            </select>
          </div>
          <div class="form-field">
            <label for="c-message">Tell us about yourself *</label>
            <textarea id="c-message" name="Message" rows="4" placeholder="What excites you about working at Oryele?" required></textarea>
          </div>
          <div class="form-field">
            <label>Upload Resume *</label>
            <label class="file-label" for="c-resume">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0018 9h-1.26A8 8 0 103 16.3"/></svg>
              <span class="file-cta">Drag and drop your resume here<br/><strong>or click to browse</strong></span>
              <span class="file-note">PDF, DOCX (Max 5MB)</span>
              <input id="c-resume" type="file" name="Resume" accept=".pdf,.doc,.docx" required />
            </label>
            <p class="file-chosen" id="file-chosen"></p>
          </div>
          <button type="submit" class="btn btn-blue submit-full">Submit Application &#8594;</button>
        </form>
        {Astro.url.searchParams.get('applied') === 'true' && (
          <div class="apply-success">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Application received. We will be in touch.
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- VISION -->
  <section class="vision-section" id="vision">
    <div class="wrap vision-wrap">
      <p class="eyebrow-dark">Our Vision</p>
      <h2>Intelligence. Empowered.</h2>
      <p class="vision-lede">We envision a world where every organization can harness trusted AI to make better decisions, accelerate outcomes, and create lasting value. We are not just building software, we are building the future of work.</p>
      <div class="values-grid">
        {values.map(v => (
          <div class="value-card">
            <p class="value-title">{v.title}</p>
            <p class="value-body">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY ORYELE -->
  <section class="why-section">
    <div class="wrap why-grid">
      <div class="why-copy">
        <p class="eyebrow-dark">Why Oryele</p>
        <h2>More Than a Job.<br/>A Launchpad for Impact.</h2>
        <p class="vision-lede">We invest in our people, their growth, well-being, and success. Because when you thrive, we all thrive.</p>
      </div>
      <div class="benefits-grid">
        {benefits.map(b => (
          <div class="benefit-item">
            <div class="benefit-dot"></div>
            <div>
              <p class="benefit-title">{b.title}</p>
              <p class="benefit-body">{b.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LIFE AT ORYELE -->
  <section class="life-section">
    <div class="wrap">
      <p class="eyebrow-dark">Why Oryele</p>
      <h2>People. Purpose. Progress.</h2>
      <p class="vision-lede">We are a global team of thinkers, builders, and dreamers. Here is a glimpse of life at Oryele.</p>
      <div class="photo-mosaic">
        <div class="photo photo-wide"><span>Team at Oryele</span></div>
        <div class="photo"><span>Collaboration</span></div>
        <div class="photo"><span>Innovation</span></div>
        <div class="photo"><span>Culture</span></div>
        <div class="photo"><span>Growth</span></div>
      </div>
    </div>
  </section>

  <!-- DONT SEE A ROLE -->
  <section class="no-role">
    <div class="wrap no-role-inner">
      <div class="no-role-icon">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </div>
      <div class="no-role-copy">
        <p class="no-role-title">Don't See the Right Role?</p>
        <p class="no-role-sub">We are always looking for exceptional talent. Send us your resume and let's start a conversation.</p>
      </div>
      <a class="btn btn-outline-blue" href="#apply">Send General Application &#8594;</a>
    </div>
  </section>

</BaseLayout>

<script is:inline>
(function () {
  var input = document.getElementById('c-resume');
  var chosen = document.getElementById('file-chosen');
  if (input && chosen) {
    input.addEventListener('change', function () {
      if (input.files && input.files[0]) {
        chosen.textContent = input.files[0].name;
      }
    });
  }
}());
</script>

<style>
  /* HERO */
  .career-hero { background: var(--navy); color: #fff; padding-block: clamp(72px, 8vw, 110px) 200px; position: relative; }
  .career-hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 70% 40%, rgba(37,99,235,.3) 0%, transparent 65%); pointer-events: none; }
  .hero-inner { position: relative; max-width: 560px; }
  .career-hero h1 { font-size: clamp(38px, 5vw, 66px); font-weight: 900; line-height: 1.05; margin: 0 0 20px; color: #fff; letter-spacing: -.02em; }
  .career-hero p { font-size: clamp(15px, 1.4vw, 18px); color: #9aa9c3; line-height: 1.7; margin: 0 0 28px; }
  .hero-actions { display: flex; gap: 12px; }

  /* FORM CARD — positioned to overlap hero bottom */
  .hero-form-anchor { position: relative; display: flex; justify-content: flex-end; margin-top: -160px; padding-bottom: 60px; z-index: 2; }
  .form-card { width: 420px; background: #fff; border: 1px solid var(--line); border-radius: 20px; box-shadow: 0 24px 64px rgba(11,21,38,.18); padding: 32px; flex-shrink: 0; }
  .form-heading { font-size: 20px; font-weight: 800; margin: 0 0 6px; color: var(--text); }
  .form-sub { font-size: 13px; color: var(--text-2); margin: 0 0 22px; line-height: 1.55; }
  .apply-form { display: grid; gap: 14px; }
  .form-field { display: grid; gap: 5px; }
  .form-field > label:first-child { font-size: 12.5px; font-weight: 700; color: var(--text); }
  .form-field input, .form-field select, .form-field textarea { font-family: inherit; font-size: 13.5px; color: var(--text); border: 1.5px solid var(--line); border-radius: 8px; padding: 10px 12px; background: var(--paper-2); outline: none; transition: border-color 140ms; width: 100%; box-sizing: border-box; }
  .form-field input:focus, .form-field select:focus, .form-field textarea:focus { border-color: var(--blue); background: #fff; }
  .form-field textarea { resize: vertical; }
  .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .file-label { display: flex; flex-direction: column; align-items: center; gap: 6px; border: 2px dashed var(--line); border-radius: 10px; padding: 20px 16px; text-align: center; cursor: pointer; background: var(--paper-2); transition: border-color 140ms; position: relative; }
  .file-label:hover { border-color: var(--blue); background: var(--blue-soft); }
  .file-label svg { stroke: var(--blue); }
  .file-cta { font-size: 13px; color: var(--text-2); line-height: 1.5; }
  .file-cta strong { color: var(--blue); }
  .file-note { font-size: 11.5px; color: #8896ad; }
  .file-label input[type="file"] { position: absolute; inset: 0; opacity: 0; width: 100%; height: 100%; cursor: pointer; }
  .file-chosen { font-size: 12px; color: #059669; font-weight: 600; margin: 3px 0 0; min-height: 16px; }
  .submit-full { width: 100%; justify-content: center; padding: 13px; font-size: 14.5px; margin-top: 4px; }
  .apply-success { display: flex; align-items: center; gap: 10px; margin-top: 16px; padding: 13px 16px; background: #ecfdf5; border: 1px solid #6ee7b7; border-radius: 9px; font-size: 13.5px; font-weight: 600; color: #065f46; }
  .apply-success svg { stroke: #059669; flex-shrink: 0; }

  /* VISION */
  .vision-section { padding-block: clamp(56px, 6vw, 88px); }
  .vision-wrap { max-width: 860px; text-align: center; margin: 0 auto; }
  .eyebrow-dark { font-size: 11px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: var(--blue); margin: 0 0 14px; }
  .vision-section h2, .why-section h2, .life-section h2 { font-size: clamp(28px, 3.5vw, 44px); font-weight: 800; margin: 0 0 16px; letter-spacing: -.02em; }
  .vision-lede { font-size: 17px; color: #33415a; line-height: 1.7; margin: 0 0 44px; }
  .values-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; text-align: left; }
  .value-card { border: 1px solid var(--line); border-radius: 14px; padding: 22px; background: #fff; box-shadow: var(--shadow-card); }
  .value-title { font-size: 14.5px; font-weight: 700; margin: 0 0 8px; color: var(--text); }
  .value-body { font-size: 13px; color: #44526a; line-height: 1.6; margin: 0; }

  /* WHY */
  .why-section { background: var(--navy); color: #fff; padding-block: clamp(56px, 6vw, 88px); }
  .why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: start; }
  .why-copy .eyebrow-dark { color: #60a5fa; }
  .why-section h2 { color: #fff; }
  .why-copy .vision-lede { color: #9aa9c3; margin: 0; }
  .benefits-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .benefit-item { display: flex; gap: 12px; align-items: flex-start; }
  .benefit-dot { width: 8px; height: 8px; background: var(--blue); border-radius: 50%; flex-shrink: 0; margin-top: 6px; }
  .benefit-title { font-size: 14px; font-weight: 700; margin: 0 0 3px; color: #fff; }
  .benefit-body { font-size: 12.5px; color: #9aa9c3; line-height: 1.55; margin: 0; }

  /* LIFE */
  .life-section { padding-block: clamp(56px, 6vw, 88px); }
  .life-section .vision-lede { margin-bottom: 32px; }
  .photo-mosaic { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .photo-wide { grid-column: 1 / -1; height: 240px; }
  .photo { height: 160px; border-radius: 14px; background: linear-gradient(135deg, #0f2554 0%, #1e3a8a 100%); display: flex; align-items: center; justify-content: center; }
  .photo span { font-size: 12px; font-weight: 600; color: rgba(255,255,255,.4); }

  /* NO ROLE */
  .no-role { background: var(--paper-2); border-top: 1px solid var(--line); padding-block: 36px; }
  .no-role-inner { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .no-role-icon { width: 52px; height: 52px; background: var(--blue-soft); border-radius: 12px; display: grid; place-items: center; flex-shrink: 0; }
  .no-role-icon svg { stroke: var(--blue); }
  .no-role-copy { flex: 1; min-width: 200px; }
  .no-role-title { font-size: 16px; font-weight: 700; margin: 0 0 4px; }
  .no-role-sub { font-size: 13.5px; color: var(--text-2); margin: 0; }
  .no-role-inner .btn { flex-shrink: 0; white-space: nowrap; }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .hero-form-anchor { justify-content: center; margin-top: 32px; }
    .form-card { width: 100%; max-width: 480px; }
    .values-grid { grid-template-columns: 1fr 1fr; }
    .why-grid { grid-template-columns: 1fr; }
    .career-hero { padding-bottom: clamp(40px, 5vw, 60px); }
  }
  @media (max-width: 600px) {
    .values-grid, .benefits-grid, .form-row-2, .photo-mosaic { grid-template-columns: 1fr; }
    .photo-wide { grid-column: auto; }
  }
</style>
