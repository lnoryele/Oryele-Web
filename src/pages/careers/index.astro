---
import BaseLayout from '../../layouts/BaseLayout.astro';

const values = [
  ['Build Boldly','We move with ambition, curiosity, and a bias for meaningful action.'],
  ['Earn Trust','We communicate clearly, protect customer confidence, and do what we say.'],
  ['Win Together','We solve hard problems as one team and share credit generously.'],
  ['Create Impact','We focus on outcomes that make work better for real organizations.'],
];

const benefits = [
  ['Purpose-led work','Build practical AI that improves how organizations operate.'],
  ['Meaningful ownership','Take responsibility for important work from idea to outcome.'],
  ['Flexible collaboration','Work with a modern, distributed team built around trust.'],
  ['Growth by design','Learn quickly through mentorship, challenge, and real responsibility.'],
  ['Competitive rewards','Compensation designed to recognize skill and contribution.'],
  ['Inclusive culture','Bring your perspective, your experience, and your whole self.'],
];

const process = [
  ['01','Apply','Share your experience, interests, and the work you are proud of.'],
  ['02','Meet','Have a focused conversation with the team about the role and Oryele.'],
  ['03','Explore','Work through a practical discussion or exercise relevant to the role.'],
  ['04','Decide','Receive a clear decision, feedback, and next steps without unnecessary delay.'],
];
---

<BaseLayout title="Careers at Oryele | Build the Future of Work" description="Join Oryele and help build trusted AI for smarter organizations.">
  <main>
    <section class="career-hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Careers at Oryele</p>
          <h1>Build the future.<br/><span>Make it meaningful.</span></h1>
          <p class="hero-lede">We are building trusted AI that helps organizations make better decisions, move faster, and create lasting value. Join a team where thoughtful work and real impact matter.</p>
          <div class="hero-actions">
            <a class="btn btn-blue" href="#apply">Apply to Oryele</a>
            <a class="text-link" href="#culture">Explore our culture <span>→</span></a>
          </div>
          <div class="hero-proof">
            <div><strong>Mission-led</strong><span>Work with purpose</span></div>
            <div><strong>High ownership</strong><span>Shape what we build</span></div>
            <div><strong>Human-centered</strong><span>AI that serves people</span></div>
          </div>
        </div>

        <aside class="form-card" id="apply" aria-labelledby="application-title">
          <div class="form-head">
            <p class="form-kicker">General application</p>
            <h2 id="application-title">Join our team</h2>
            <p>Tell us where you can make an impact. We review every application.</p>
          </div>

          <form id="career-form" action="/api/careers-application" method="POST" enctype="multipart/form-data" novalidate>
            <div class="field-row">
              <div class="field"><label for="career-name">Full name *</label><input id="career-name" name="Name" type="text" autocomplete="name" required /></div>
              <div class="field"><label for="career-email">Email *</label><input id="career-email" name="Email" type="email" autocomplete="email" required /></div>
            </div>
            <div class="field-row">
              <div class="field"><label for="career-phone">Phone</label><input id="career-phone" name="Phone" type="tel" autocomplete="tel" /></div>
              <div class="field"><label for="career-title">Current title</label><input id="career-title" name="Title" type="text" autocomplete="organization-title" /></div>
            </div>
            <div class="field"><label for="career-area">Area of interest *</label><select id="career-area" name="Area" required><option value="">Select an area</option><option>Engineering</option><option>Product</option><option>Design</option><option>Operations</option><option>Sales and Partnerships</option><option>Customer Success</option><option>Marketing</option><option>Other</option></select></div>
            <div class="field"><label for="career-message">Why Oryele? *</label><textarea id="career-message" name="Message" rows="4" placeholder="Tell us about your experience and the impact you want to create." required></textarea></div>
            <div class="field">
              <label>Resume *</label>
              <label class="upload" for="resume-input">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 16V4m0 0L8 8m4-4 4 4"/><path d="M4 15v4a1 1 0 001 1h14a1 1 0 001-1v-4"/></svg>
                <span><strong>Upload your resume</strong><small>PDF, DOC, or DOCX · maximum 5 MB</small></span>
                <input id="resume-input" name="Resume" type="file" accept=".pdf,.doc,.docx" required />
              </label>
              <p class="file-name" id="file-name"></p>
            </div>
            <div class="cf-turnstile" data-sitekey="0x4AAAAAAD_Hy_4_lGdOYfR0" data-theme="light"></div>
            <button class="btn btn-blue submit-btn" id="career-submit" type="submit">Submit application <span>→</span></button>
            <p class="privacy-note">By submitting, you agree that Oryele may use your information to evaluate employment opportunities.</p>
            <p class="career-form-status" id="career-form-status" role="status" aria-live="polite"></p>
          </form>
        </aside>
      </div>
    </section>

    <section class="intro-strip">
      <div class="wrap intro-grid">
        <p class="eyebrow blue">Why Oryele</p>
        <h2>Do the most meaningful work of your career.</h2>
        <p>Oryele brings together intelligent automation, trusted data, and human judgment. We are looking for people who care about solving complex problems well—not simply quickly.</p>
      </div>
    </section>

    <section class="culture" id="culture">
      <div class="wrap">
        <div class="section-head"><div><p class="eyebrow blue">How we work</p><h2>Principles that guide us.</h2></div><p>Our culture is built around clarity, accountability, thoughtful speed, and respect for the people who use what we create.</p></div>
        <div class="value-grid">
          {values.map(([title,body], index) => <article class="value-card"><span>0{index + 1}</span><h3>{title}</h3><p>{body}</p></article>)}
        </div>
      </div>
    </section>

    <section class="benefits-section">
      <div class="wrap benefits-layout">
        <div class="benefits-copy"><p class="eyebrow light">What you can expect</p><h2>A place to do excellent work—and grow.</h2><p>We are building an environment where talented people have the context, trust, and support to do their best work.</p></div>
        <div class="benefits-grid">
          {benefits.map(([title,body]) => <article><div class="check">✓</div><div><h3>{title}</h3><p>{body}</p></div></article>)}
        </div>
      </div>
    </section>

    <section class="process-section">
      <div class="wrap">
        <div class="section-head"><div><p class="eyebrow blue">Hiring process</p><h2>Clear, respectful, and focused.</h2></div><p>We value your time. Our process is designed to help both sides make a confident decision.</p></div>
        <div class="process-grid">{process.map(([number,title,body]) => <article><span>{number}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
      </div>
    </section>

    <section class="closing-cta">
      <div class="wrap cta-inner"><div><p class="eyebrow light">Your next chapter</p><h2>Help us build intelligence that empowers people.</h2></div><a class="btn btn-white" href="#apply">Send your application <span>→</span></a></div>
    </section>
  </main>
</BaseLayout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script is:inline>
(function () {
  var form = document.getElementById('career-form');
  var fileInput = document.getElementById('resume-input');
  var fileName = document.getElementById('file-name');
  var submit = document.getElementById('career-submit');
  var status = document.getElementById('career-form-status');
  var originalButton = 'Submit application <span>→</span>';

  if (fileInput && fileName) fileInput.addEventListener('change', function () {
    var file = fileInput.files && fileInput.files[0];
    fileName.className = 'file-name';
    if (!file) { fileName.textContent = ''; return; }
    if (!/\.(pdf|doc|docx)$/i.test(file.name)) { fileInput.value=''; fileName.textContent='Please choose a PDF, DOC, or DOCX file.'; fileName.className='file-name error'; return; }
    if (file.size > 5 * 1024 * 1024) { fileInput.value=''; fileName.textContent='Your resume must be 5 MB or smaller.'; fileName.className='file-name error'; return; }
    fileName.textContent = file.name;
  });

  if (!form || !submit || !status) return;
  form.addEventListener('submit', async function (event) {
    event.preventDefault();
    status.textContent=''; status.className='career-form-status';
    if (!form.checkValidity()) { form.reportValidity(); return; }
    submit.disabled=true; submit.textContent='Submitting…';
    try {
      var response = await fetch('/api/careers-application', { method:'POST', body:new FormData(form) });
      var data = await response.json().catch(function(){ return {}; });
      if (!response.ok || !data.ok) throw new Error(data.error || 'We could not submit your application.');
      form.reset(); if (fileName) fileName.textContent='';
      status.textContent='Application received. Thank you for your interest in Oryele.';
      status.className='career-form-status success';
      submit.textContent='Application submitted';
    } catch (error) {
      submit.disabled=false; submit.innerHTML=originalButton;
      status.textContent=error.message || 'We could not submit your application. Please email hr@oryele.com.';
      status.className='career-form-status error';
    }
  });
}());
</script>

<style>
  .career-hero{position:relative;overflow:hidden;background:#07152c;color:#fff}.hero-bg{position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,15,35,.96) 0%,rgba(5,15,35,.88) 46%,rgba(5,15,35,.55) 100%),url('/careers-hero.png') 72% center/cover no-repeat}.hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1fr) 500px;gap:72px;align-items:center;padding-block:96px 84px}.eyebrow{margin:0 0 16px;font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:#93c5fd}.eyebrow.blue{color:var(--blue)}.eyebrow.light{color:#93c5fd}.hero-copy h1{margin:0 0 24px;font-size:clamp(44px,6vw,78px);line-height:.98;letter-spacing:-.045em}.hero-copy h1 span{color:#70a9ff}.hero-lede{max-width:650px;margin:0 0 30px;color:#c6d3e6;font-size:18px;line-height:1.7}.hero-actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap}.text-link{color:#fff;font-weight:700;text-decoration:none}.text-link span{margin-left:6px}.hero-proof{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:48px;padding-top:26px;border-top:1px solid rgba(255,255,255,.14)}.hero-proof div{display:grid;gap:4px}.hero-proof strong{font-size:14px}.hero-proof span{font-size:12px;color:#9fb0c8}.form-card{background:#fff;color:var(--text);border-radius:22px;padding:30px;box-shadow:0 30px 80px rgba(0,0,0,.35)}.form-kicker{margin:0 0 6px;color:var(--blue);font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.form-head h2{margin:0 0 8px;font-size:28px}.form-head>p:last-child{margin:0 0 22px;color:var(--text-2);font-size:14px;line-height:1.55}.form-card form{display:grid;gap:14px}.field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{display:grid;gap:6px}.field label{font-size:12px;font-weight:750}.field input,.field select,.field textarea{width:100%;box-sizing:border-box;border:1px solid #dbe3ee;border-radius:9px;background:#f8fafc;padding:11px 12px;font:inherit;font-size:14px;color:var(--text);outline:none}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--blue);background:#fff;box-shadow:0 0 0 3px rgba(45,107,230,.1)}.upload{position:relative;display:flex!important;align-items:center;gap:12px;border:1.5px dashed #b9c7da;border-radius:10px;background:#f8fafc;padding:14px;cursor:pointer}.upload svg{color:var(--blue);flex:none}.upload span{display:grid;gap:2px}.upload small{font-weight:500;color:#718096}.upload input{position:absolute;inset:0;opacity:0;cursor:pointer}.file-name{min-height:16px;margin:0;font-size:12px;font-weight:700;color:#087f5b}.file-name.error,.career-form-status.error{color:#b42318}.submit-btn{width:100%;justify-content:center;padding:13px}.privacy-note{margin:0;text-align:center;font-size:11px;line-height:1.5;color:#7b8799}.career-form-status{min-height:18px;margin:0;text-align:center;font-size:12px;font-weight:700}.career-form-status.success{color:#087f5b}.intro-strip,.culture,.process-section{padding-block:88px}.intro-grid{display:grid;grid-template-columns:180px 1fr 1fr;gap:48px;align-items:start}.intro-grid h2,.section-head h2,.benefits-copy h2,.cta-inner h2{margin:0;font-size:clamp(34px,4vw,52px);line-height:1.08;letter-spacing:-.035em}.intro-grid>p:last-child,.section-head>p{margin:6px 0 0;color:#526075;line-height:1.75}.culture{background:#f6f8fb}.section-head{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:end;margin-bottom:36px}.value-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.value-card{background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:26px}.value-card>span{display:inline-block;margin-bottom:34px;color:var(--blue);font-size:12px;font-weight:800}.value-card h3,.benefits-grid h3,.process-grid h3{margin:0 0 8px;font-size:17px}.value-card p,.benefits-grid p,.process-grid p{margin:0;color:#607086;font-size:13.5px;line-height:1.65}.benefits-section{padding-block:92px;background:#07152c;color:#fff}.benefits-layout{display:grid;grid-template-columns:.9fr 1.1fr;gap:76px}.benefits-copy p:last-child{color:#a8b7cc;line-height:1.7}.benefits-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}.benefits-grid article{display:flex;gap:13px}.check{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:rgba(112,169,255,.14);color:#70a9ff;flex:none}.benefits-grid h3{color:#fff}.benefits-grid p{color:#a8b7cc}.process-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.process-grid article{border-top:2px solid #dce5f1;padding-top:20px}.process-grid span{display:block;margin-bottom:26px;color:var(--blue);font-size:12px;font-weight:800}.closing-cta{padding-block:64px;background:linear-gradient(135deg,#0a2d68,#1556b8);color:#fff}.cta-inner{display:flex;justify-content:space-between;align-items:center;gap:36px}.btn-white{background:#fff;color:#0a3476}.btn-white:hover{background:#eef5ff}.submit-btn:disabled{opacity:.7;cursor:wait}
  @media(max-width:1050px){.hero-grid{grid-template-columns:1fr;gap:42px}.form-card{max-width:620px}.intro-grid{grid-template-columns:1fr}.value-grid,.process-grid{grid-template-columns:1fr 1fr}.benefits-layout{grid-template-columns:1fr}.section-head{grid-template-columns:1fr}.hero-proof{max-width:620px}}
  @media(max-width:640px){.hero-grid{padding-block:70px 58px}.field-row,.value-grid,.benefits-grid,.process-grid{grid-template-columns:1fr}.hero-proof{grid-template-columns:1fr}.form-card{padding:22px;border-radius:16px}.intro-strip,.culture,.process-section,.benefits-section{padding-block:64px}.cta-inner{align-items:flex-start;flex-direction:column}}
</style>
