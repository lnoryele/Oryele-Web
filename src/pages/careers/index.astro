---
import BaseLayout from '../../layouts/BaseLayout.astro';
const values=[
 {title:'Innovate Boldly',body:'We challenge assumptions and turn ambitious ideas into practical outcomes.'},
 {title:'Win Together',body:'We collaborate openly, support one another, and share responsibility for results.'},
 {title:'Act with Integrity',body:'We build trust through transparency, respect, and doing what is right.'},
 {title:'Drive Impact',body:'We focus on meaningful problems and measurable value for customers and communities.'}
];
---
<BaseLayout title="Careers at Oryele | Build Meaningful Work" description="Learn about Oryele's culture and submit a general application.">
<section class="career-hero"><div class="wrap hero-inner"><div><p class="eyebrow">Careers</p><h1>Build the Future.<br/>Make It Meaningful.</h1><p>We are building the AI foundation for smarter organizations. We are not advertising open roles today, but we welcome exceptional people who believe they can help shape what comes next.</p><a class="btn btn-blue" href="#apply">Submit a General Application →</a></div><div class="hero-art"><img src="/careers/team-1.svg" alt="Oryele team collaborating"/></div></div></section>
<section class="vision"><div class="wrap"><div class="intro"><p class="eyebrow">Our culture</p><h2>Intelligence. Empowered.</h2><p>We believe trusted AI should strengthen human judgment, improve execution, and create more meaningful work. Our culture combines high standards, curiosity, accountability, and genuine collaboration.</p></div><div class="values">{values.map(v=><article><h3>{v.title}</h3><p>{v.body}</p></article>)}</div></div></section>
<section class="life"><div class="wrap life-grid"><div><p class="eyebrow">Life at Oryele</p><h2>People. Purpose. Progress.</h2><p>We bring together experienced operators, technologists, builders, and problem solvers. The work is demanding, highly collaborative, and centered on creating durable customer value.</p><div class="benefits"><span>Flexible work</span><span>Purpose-driven projects</span><span>Continuous learning</span><span>Inclusive collaboration</span></div></div><div class="mosaic"><img class="wide" src="/careers/team-2.svg" alt="Team gathering"/><img src="/careers/team-3.svg" alt="Colleagues collaborating"/><img src="/careers/team-4.svg" alt="Team discussion"/></div></div></section>
<section class="apply" id="apply"><div class="wrap apply-grid"><div><p class="eyebrow">General application</p><h2>Tell us what you could build with us.</h2><p>There are currently no advertised openings. Submit your background and a thoughtful note about the problems you want to solve, the capabilities you bring, and the impact you believe you could make at Oryele.</p><p class="note">Applications are reviewed as future needs develop. Submission does not indicate that a role is currently available.</p></div><form class="form" action="mailto:hr@oryele.com" method="POST" enctype="multipart/form-data"><div class="row"><label>Full name *<input required name="Name" placeholder="Your full name"/></label><label>Email *<input required type="email" name="Email" placeholder="you@example.com"/></label></div><div class="row"><label>Phone<input name="Phone" placeholder="(123) 456-7890"/></label><label>Current title<input name="Title" placeholder="Your current role"/></label></div><label>Area of interest *<select required name="Area"><option value="">Select an area</option><option>Engineering</option><option>Product</option><option>Operations</option><option>Sales & Partnerships</option><option>Customer Success</option><option>Marketing</option><option>Other</option></select></label><label>Tell us about yourself *<textarea required rows="6" name="Message" placeholder="What excites you about Oryele and how would you contribute?"></textarea></label><label class="upload">Resume *<input required type="file" name="Resume" accept=".pdf,.doc,.docx"/><small>PDF, DOC, or DOCX. Maximum recommended size: 5MB.</small></label><button class="btn btn-blue" type="submit">Submit Application →</button></form></div></section>
</BaseLayout>
<style>
.career-hero{background:var(--navy);color:#fff;padding-block:70px}.hero-inner{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.career-hero h1{font-size:clamp(42px,5vw,66px);line-height:1.05;margin:0 0 22px}.career-hero p:not(.eyebrow){color:#c7d3e5;font-size:18px;line-height:1.7;max-width:650px}.hero-art img{width:100%;border-radius:20px;box-shadow:0 24px 70px rgba(0,0,0,.3)}.vision,.life,.apply{padding-block:clamp(65px,7vw,100px)}.intro{max-width:760px}.intro h2,.life h2,.apply h2{font-size:clamp(30px,4vw,48px);margin:0 0 18px}.intro>p:last-child,.life-grid>div>p,.apply-grid>div>p{font-size:17px;line-height:1.7;color:#33415a}.values{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:42px}.values article{padding:24px;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow-card)}.values h3{margin:0 0 10px}.values p{margin:0;color:#44526a;line-height:1.6}.life{background:var(--paper-2);border-block:1px solid var(--line)}.life-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px;align-items:center}.benefits{display:flex;flex-wrap:wrap;gap:10px;margin-top:25px}.benefits span{background:#fff;border:1px solid var(--line);padding:10px 14px;border-radius:999px;font-weight:700;font-size:13px}.mosaic{display:grid;grid-template-columns:1fr 1fr;gap:14px}.mosaic img{width:100%;height:210px;object-fit:cover;border-radius:14px}.mosaic .wide{grid-column:1/-1;height:290px}.apply-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:70px;align-items:start}.note{font-size:13px!important;background:var(--paper-2);border-left:3px solid var(--blue);padding:14px}.form{display:grid;gap:18px;padding:30px;border:1px solid var(--line);border-radius:18px;box-shadow:0 14px 40px rgba(11,21,38,.1)}.row{display:grid;grid-template-columns:1fr 1fr;gap:15px}label{display:grid;gap:7px;font-size:13px;font-weight:700}input,select,textarea{width:100%;font:inherit;padding:13px 14px;border:1px solid var(--line);border-radius:9px}textarea{resize:vertical}.upload small{font-weight:400;color:var(--text-2)}
@media(max-width:900px){.hero-inner,.life-grid,.apply-grid{grid-template-columns:1fr}.values{grid-template-columns:1fr 1fr}}@media(max-width:600px){.values,.row,.mosaic{grid-template-columns:1fr}.mosaic .wide{grid-column:auto}}
</style>
