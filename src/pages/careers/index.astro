---
import BaseLayout from '../../layouts/BaseLayout.astro';

const values = [
  { icon: '💡', title: 'Innovate Boldly', body: 'We challenge the status quo and push the boundaries of what is possible.' },
  { icon: '🤝', title: 'Win Together', body: 'We collaborate openly, support each other, and celebrate every win as a team.' },
  { icon: '🛡️', title: 'Act with Integrity', body: 'We build trust through transparency, respect, and a commitment to doing what is right.' },
  { icon: '🌍', title: 'Drive Impact', body: 'We are passionate about solving real problems and delivering meaningful results for our customers and communities.' },
];

const benefits = [
  { icon: '💰', title: 'Competitive Compensation', body: 'We reward your talent and contributions.' },
  { icon: '❤️', title: 'Health and Wellness', body: 'Comprehensive benefits to support you and your loved ones.' },
  { icon: '🏡', title: 'Flexible Work', body: 'Hybrid-first culture with flexibility that works for you.' },
  { icon: '🎯', title: 'Purpose-Driven Work', body: 'Solve meaningful problems and create real impact.' },
  { icon: '📈', title: 'Growth and Learning', body: 'Continuous learning, mentorship, and career advancement.' },
  { icon: '🌈', title: 'Inclusive Culture', body: 'Diversity, equity, and belonging are in our DNA.' },
];
---
<BaseLayout title="Careers at Oryele | Build Meaningful Work" description="Join Oryele and help build the AI foundation for smarter organizations. Submit a general application today.">

  <!-- HERO -->
  <section class="career-hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Careers</p>
        <h1>Build the Future.<br/>Make It Meaningful.</h1>
        <p>At Oryele, we are building the AI foundation for smarter organizations and a better world. Join a team of innovators driven by purpose, collaboration, and impact.</p>
        <div class="hero-actions">
          <a class="btn btn-blue" href="#apply">View Open Roles &#8594;</a>
          <a class="btn btn-outline-inv" href="#vision">Our Culture &#9654;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- VISION + VALUES + STICKY FORM -->
  <section class="vision-section" id="vision">
    <div class="wrap vision-grid">
      <div class="vision-left">

        <!-- Vision -->
        <div class="vision-block">
          <p class="eyebrow-dark">Our Vision</p>
          <h2>Intelligence. Empowered.</h2>
          <p class="vision-lede">We envision a world where every organization can harness trusted AI to make better decisions, accelerate outcomes, and create lasting value. We are not just building software — we are building the future of work.</p>
        </div>

        <!-- Values -->
        <div class="values-grid">
          {values.map(v => (
            <div class="value-card">
              <span class="value-icon">{v.icon}</span>
              <p class="value-title">{v.title}</p>
              <p class="value-body">{v.body}</p>
            </div>
          ))}
        </div>

        <!-- Why Oryele -->
        <div class="why-block">
          <p class="eyebrow-dark">Why Oryele</p>
          <h2>More Than a Job.<br/>A Launchpad for Impact.</h2>
          <p class="vision-lede">We invest in our people, their growth, well-being, and success. Because when you thrive, we all thrive.</p>
          <div class="benefits-grid">
            {benefits.map(b => (
              <div class="benefit-item">
                <span class="benefit-icon">{b.icon}</span>
                <div>
                  <p class="benefit-title">{b.title}</p>
                  <p class="benefit-body">{b.body}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Life at Oryele -->
        <div class="life-block">
          <p class="eyebrow-dark">Why Oryele</p>
          <h2>People. Purpose. Progress.</h2>
          <p class="vision-lede">We are a global team of thinkers, builders, and dreamers. Here is a glimpse of life at Oryele.</p>
          <div class="photo-mosaic">
            <div class="photo-wide photo-placeholder">
              <span>Team at Oryele</span>
            </div>
            <div class="photo-placeholder"><span>Collaboration</span></div>
            <div class="photo-placeholder"><span>Innovation</span></div>
            <div class="photo-placeholder"><span>Culture</span></div>
            <div class="photo-placeholder"><span>Growth</span></div>
          </div>
        </div>

      </div>

      <!-- Sticky Application Form -->
      <div class="form-sticky-wrap" id="apply">
        <div class="form-card">
          <p class="form-heading">Join Our Team</p>
          <p class="form-sub">Ready to build the future with us? Fill out the form below and attach your resume.</p>
          <form action="https://formsubmit.co/hr@oryele.com" method="POST" enctype="multipart/form-data" class="apply-form">
            <input type="hidden" name="_subject" value="New job application from oryele.ai" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_next" value="https://oryele.ai/careers/?applied=true" />
            <div class="form-field">
              <label for="c-name">Full Name *</label>
              <input id="c-name" type="text" name="Name" placeholder="Your full name" required />
            </div>
            <div class="form-field">
              <label for="c-email">Email *</label>
              <input id="c-email" type="email" name="Email" placeholder="you@example.com" required />
            </div>
            <div class="form-row-2">
              <div class="form-field">
                <label for="c-phone">Phone Number</label>
                <input id="c-phone" type="tel" name="Phone" placeholder="(123) 456-7890" />
              </div>
              <div class="form-field">
                <label for="c-title">Current Title</label>
                <input id="c-title" type="text" name="Title" placeholder="Your current role" />
              </div>
            </div>
            <div class="form-field">
              <label for="c-area">Department of Interest *</label>
              <select id="c-area" name="Area" required>
                <option value="">Select a department</option>
                <option>Engineering</option>
                <option>Product</option>
                <option>Operations</option>
                <option>Sales and Partnerships</option>
                <option>Customer Success</option>
                <option>Marketing</option>
                <option>Other</option>
              </select>
            </div>
            <div class="form-field">
              <label for="c-message">Tell us about yourself *</label>
              <textarea id="c-message" name="Message" rows="5" placeholder="What excites you about working at Oryele?" required></textarea>
            </div>
            <div class="form-field">
              <label for="c-resume">Upload Resume *</label>
              <div class="file-drop" id="file-drop">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0018 9h-1.26A8 8 0 103 16.3"/></svg>
                <p>Drag and drop your resume here<br/><span class="file-link">or click to browse</span></p>
                <p class="file-note">PDF, DOCX (Max 5MB)</p>
                <input id="c-resume" type="file" name="Resume" accept=".pdf,.doc,.docx" required />
              </div>
              <p class="file-name" id="file-name"></p>
            </div>
            <button type="submit" class="btn btn-blue submit-full">Submit Application &#8594;</button>
          </form>
          {Astro.url.searchParams.get('applied') === 'true' && (
            <div class="apply-success">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              Application received. We will be in touch.
            </div>
          )}
        </div>
      </div>

    </div>
  </section>

  <!-- DONT SEE A ROLE -->
  <section class="no-role">
    <div class="wrap no-role-inner">
      <div class="no-role-icon">
        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </div>
      <div>
        <p class="no-role-title">Don't See the Right Role?</p>
        <p class="no-role-sub">We are always looking for exceptional talent. Send us your resume and let's start a conversation.</p>
      </div>
      <a class="btn btn-outline-blue" href="#apply">Send General Application &#8594;</a>
    </div>
  </section>

</BaseLayout>

<script is:inline>
(function () {
  // File drop UI
  var drop = document.getElementById('file-drop');
  var input = drop ? drop.querySelector('input[type="file"]') : null;
  var nameEl = document.getElementById('file-name');

  if (drop && input) {
    drop.addEventListener('click', function () { input.click(); });
    input.addEventListener('change', function () {
      if (input.files && input.files[0] && nameEl) {
        nameEl.textContent = input.files[0].name;
        drop.classList.add('has-file');
      }
    });
    drop.addEventListener('dragover', function (e) { e.preventDefault(); drop.classList.add('drag-over'); });
    drop.addEventListener('dragleave', function () { drop.classList.remove('drag-over'); });
    drop.addEventListener('drop', function (e) {
      e.preventDefault();
      drop.classList.remove('drag-over');
      if (e.dataTransfer.files[0]) {
        input.files = e.dataTransfer.files;
        if (nameEl) nameEl.textContent = e.dataTransfer.files[0].name;
        drop.classList.add('has-file');
      }
    });
  }
}());
</script>

<style>
  /* HERO */
  .career-hero { background: var(--navy); color: #fff; padding-block: clamp(72px, 8vw, 120px); position: relative; overflow: hidden; }
  .career-hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 70% 50%, rgba(37,99,235,.25) 0%, transparent 70%); pointer-events: none; }
  .hero-copy { max-width: 640px; position: relative; }
  .career-hero h1 { font-size: clamp(40px, 5.5vw, 72px); font-weight: 900; line-height: 1.04; margin: 0 0 22px; color: #fff; letter-spacing: -.02em; }
  .career-hero p:not(.eyebrow) { font-size: clamp(16px, 1.5vw, 19px); color: #9aa9c3; line-height: 1.7; margin: 0 0 32px; max-width: 520px; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }

  /* VISION GRID */
  .vision-section { padding-block: clamp(56px, 6vw, 96px); }
  .vision-grid { display: grid; grid-template-columns: 1fr 400px; gap: 72px; align-items: start; }
  .vision-left { display: grid; gap: 72px; }
  .eyebrow-dark { font-size: 11px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: var(--blue); margin: 0 0 14px; }
  .vision-block h2, .why-block h2, .life-block h2 { font-size: clamp(28px, 3.5vw, 44px); font-weight: 800; margin: 0 0 16px; letter-spacing: -.02em; }
  .vision-lede { font-size: 17px; color: #33415a; line-height: 1.7; margin: 0; }

  /* VALUES */
  .values-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .value-card { border: 1px solid var(--line); border-radius: 16px; padding: 24px; background: #fff; box-shadow: var(--shadow-card); }
  .value-icon { font-size: 28px; display: block; margin-bottom: 12px; }
  .value-title { font-size: 15px; font-weight: 700; margin: 0 0 8px; color: var(--text); }
  .value-body { font-size: 13.5px; color: #44526a; line-height: 1.6; margin: 0; }

  /* BENEFITS */
  .benefits-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 36px; }
  .benefit-item { display: flex; gap: 14px; align-items: flex-start; }
  .benefit-icon { font-size: 22px; flex-shrink: 0; margin-top: 2px; }
  .benefit-title { font-size: 14px; font-weight: 700; margin: 0 0 4px; color: var(--text); }
  .benefit-body { font-size: 13px; color: #44526a; line-height: 1.55; margin: 0; }

  /* PHOTO MOSAIC */
  .photo-mosaic { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 32px; }
  .photo-wide { grid-column: 1 / -1; height: 260px; }
  .photo-placeholder { height: 160px; border-radius: 14px; background: linear-gradient(135deg, #0f2554 0%, #1e3a8a 100%); display: flex; align-items: center; justify-content: center; }
  .photo-placeholder span { font-size: 13px; font-weight: 600; color: rgba(255,255,255,.5); }

  /* STICKY FORM */
  .form-sticky-wrap { position: sticky; top: 92px; }
  .form-card { background: #fff; border: 1px solid var(--line); border-radius: 20px; box-shadow: 0 20px 60px rgba(11,21,38,.12); padding: 32px; }
  .form-heading { font-size: 20px; font-weight: 800; margin: 0 0 6px; color: var(--text); }
  .form-sub { font-size: 13.5px; color: var(--text-2); margin: 0 0 24px; line-height: 1.55; }
  .apply-form { display: grid; gap: 16px; }
  .form-field { display: grid; gap: 6px; }
  .form-field label { font-size: 12.5px; font-weight: 700; color: var(--text); }
  .form-field input, .form-field select, .form-field textarea { font-family: inherit; font-size: 14px; color: var(--text); border: 1.5px solid var(--line); border-radius: 9px; padding: 11px 13px; background: var(--paper-2); outline: none; transition: border-color 140ms; width: 100%; }
  .form-field input:focus, .form-field select:focus, .form-field textarea:focus { border-color: var(--blue); background: #fff; box-shadow: 0 0 0 3px rgba(18,63,158,.1); }
  .form-field textarea { resize: vertical; }
  .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .file-drop { border: 2px dashed var(--line); border-radius: 12px; padding: 24px 16px; text-align: center; cursor: pointer; transition: border-color 140ms, background 140ms; position: relative; background: var(--paper-2); }
  .file-drop:hover, .file-drop.drag-over { border-color: var(--blue); background: var(--blue-soft); }
  .file-drop.has-file { border-color: #34d399; background: #ecfdf5; }
  .file-drop svg { stroke: var(--blue); margin: 0 auto 10px; display: block; }
  .file-drop p { font-size: 13px; color: var(--text-2); margin: 0 0 4px; line-height: 1.5; }
  .file-link { color: var(--blue); font-weight: 700; }
  .file-note { font-size: 11.5px; color: #8896ad; margin: 0; }
  .file-drop input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; }
  .file-name { font-size: 12px; color: #059669; font-weight: 600; margin: 4px 0 0; }
  .submit-full { width: 100%; justify-content: center; padding: 14px; font-size: 15px; }
  .apply-success { display: flex; align-items: center; gap: 10px; margin-top: 16px; padding: 14px 16px; background: #ecfdf5; border: 1px solid #6ee7b7; border-radius: 10px; font-size: 14px; font-weight: 600; color: #065f46; }
  .apply-success svg { stroke: #059669; flex-shrink: 0; }

  /* NO ROLE */
  .no-role { background: var(--paper-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding-block: 40px; }
  .no-role-inner { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .no-role-icon { width: 56px; height: 56px; background: var(--blue-soft); border-radius: 14px; display: grid; place-items: center; color: var(--blue); flex-shrink: 0; }
  .no-role-icon svg { stroke: var(--blue); }
  .no-role-title { font-size: 17px; font-weight: 700; margin: 0 0 4px; }
  .no-role-sub { font-size: 14px; color: var(--text-2); margin: 0; }
  .no-role-inner .btn { margin-left: auto; white-space: nowrap; flex-shrink: 0; }

  /* RESPONSIVE */
  @media (max-width: 1024px) { .vision-grid { grid-template-columns: 1fr; } .form-sticky-wrap { position: static; } }
  @media (max-width: 720px) { .values-grid, .benefits-grid, .form-row-2 { grid-template-columns: 1fr; } .photo-mosaic { grid-template-columns: 1fr; } .photo-wide { grid-column: auto; height: 200px; } .no-role-inner .btn { margin-left: 0; } }
</style>
