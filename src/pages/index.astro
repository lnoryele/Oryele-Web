---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ValueProps from "../components/ValueProps.astro";
---
<BaseLayout
  title="Oryele | Enterprise Execution Platform for Professional Services"
  description="Oryele is the Enterprise Execution Platform that unifies AI, workflows, knowledge, communications, and digital workers across accounting, legal, and insurance firms."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Oryele",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web",
    "offers": {
      "@type": "Offer",
      "availability": "https://schema.org/InStock"
    },
    "description": "AI-powered workflow automation and digital workers platform for professional services firms including accounting, legal, and insurance.",
    "url": "https://oryele.ai",
    "provider": {
      "@type": "Organization",
      "name": "Oryele LLC"
    }
  })}></script>
  <Hero />
  <ValueProps />
</BaseLayout>
