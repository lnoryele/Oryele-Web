---
import BaseLayout from '../../layouts/BaseLayout.astro';

const safeguards = [
  { title: 'Identity and access', body: 'Role-based access, account verification, password controls, and multi-factor authentication capabilities help reduce unauthorized access.' },
  { title: 'Data protection', body: 'Oryele is designed to protect data in transit and at rest using modern encryption and secure transport practices.' },
  { title: 'Infrastructure security', body: 'The platform uses managed cloud infrastructure, segmented environments, restricted administrative access, and layered edge protections.' },
  { title: 'Logging and oversight', body: 'Operational and security-relevant activity can be logged to support investigation, accountability, and platform administration.' },
  { title: 'Secure development', body: 'Changes are managed through source control, review, environment separation, dependency management, and controlled release processes.' },
  { title: 'Resilience', body: 'Backup, recovery, incident response, and service continuity procedures are being developed and tested as the platform matures.' }
];

const resources = [
  ['Privacy Policy', 'How Oryele collects, uses, and safeguards personal information.', '/privacy/'],
  ['Terms and Conditions', 'Terms governing access to and use of Oryele services.', '/terms/'],
  ['Cookie Policy', 'How cookies and similar technologies are used.', '/cookie-policy/'],
  ['SMS Consent', 'Messaging consent, opt-out controls, and related notices.', '/sms-consent/'],
  ['Help Center', 'Product, account, and service assistance.', '/resources/help-center/'],
  ['Contact Oryele', 'Request security information or speak with the team.', '/contact/']
];

const roadmap = [
  'Formal security policies and control ownership',
  'Expanded vulnerability and dependency management',
  'Documented incident response and business continuity testing',
  'Independent security assessment and penetration testing',
  'Compliance-readiness work aligned to customer requirements'
];

const trustSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Oryele Trust Center',
  description: 'Security, privacy, resilience, and legal information for the Oryele enterprise AI platform.',
  url: 'https://oryele.ai/trust/'
};
---
<BaseLayout
  title="Oryele Trust Center | Security, Privacy and Resilience"
  description="Review Oryele security practices, privacy information, infrastructure safeguards, resilience approach, and compliance roadmap."
>
  <script type="application/ld+json" set:html={JSON.stringify(trustSchema)}></script>

  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <p class="eyebrow">Oryele Trust Center</p>
          <h1>Trust is built into how we design, operate, and improve Oryele.</h1>
          <p class="lede">This center provides a clear view of Oryele's current security and privacy practices, platform safeguards, legal resources, and ongoing security roadmap.</p>
          <div class="actions">
            <a class="btn btn-primary" href="/contact/">Request security information</a>
            <a class="btn btn-secondary" href="#safeguards">Review safeguards</a>
          </div>
        </div>
        <aside class="status-card" aria-label="Trust Center status">
          <p class="status-label">Current position</p>
          <h2>Security program in active development</h2>
          <p>Oryele is strengthening its governance, documentation, testing, and operational controls as the platform grows.</p>
          <div class="notice"><strong>Accuracy matters:</strong> Oryele does not currently claim SOC 2 certification or GDPR certification.</div>
        </aside>
      </div>
    </section>

    <section class="principles">
      <div class="wrap principles-grid">
        <div><span>01</span><h2>Protect access</h2><p>Limit access according to role, responsibility, and operational need.</p></div>
        <div><span>02</span><h2>Protect data</h2><p>Use secure transport, encryption, separation, and controlled handling practices.</p></div>
        <div><span>03</span><h2>Operate responsibly</h2><p>Improve visibility, incident readiness, release discipline, and accountability.</p></div>
      </div>
    </section>

    <section class="section" id="safeguards">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow dark">Platform safeguards</p>
          <h2>Designed for responsible enterprise use</h2>
          <p>Safeguards are implemented according to platform maturity, deployment configuration, and customer requirements. Specific controls may vary by environment and service arrangement.</p>
        </div>
        <div class="card-grid">
          {safeguards.map(item => (
            <article class="card">
              <div class="icon" aria-hidden="true">✓</div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section architecture">
      <div class="wrap split">
        <div>
          <p class="eyebrow">Infrastructure and operations</p>
          <h2>Layered protection across the service</h2>
          <p>Oryele uses cloud and edge services to support availability, traffic protection, controlled application delivery, and separation between development and production activities.</p>
          <p>Administrative access should be restricted, monitored, and granted only where required. Production changes are expected to follow controlled source-code and deployment workflows.</p>
        </div>
        <div class="layer-list">
          <div><strong>Edge</strong><span>Traffic filtering, TLS, and delivery protections</span></div>
          <div><strong>Application</strong><span>Authentication, authorization, validation, and workflow controls</span></div>
          <div><strong>Data</strong><span>Restricted access, encryption, backup, and recovery practices</span></div>
          <div><strong>Operations</strong><span>Logging, release management, monitoring, and incident processes</span></div>
        </div>
      </div>
    </section>

    <section class="section roadmap">
      <div class="wrap split">
        <div>
          <p class="eyebrow dark">Security roadmap</p>
          <h2>Continuous improvement, without overstating maturity</h2>
          <p>Oryele's security program is evolving. The roadmap is intended to strengthen assurance while keeping public statements aligned with verified capabilities.</p>
        </div>
        <ul>
          {roadmap.map(item => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="section resources">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow dark">Policies and assistance</p>
          <h2>Trust resources</h2>
        </div>
        <div class="resource-grid">
          {resources.map(([title, body, href]) => (
            <a href={href}>
              <h3>{title}</h3>
              <p>{body}</p>
              <span>View resource →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="wrap cta-inner">
        <div><p class="eyebrow">Security questions</p><h2>Need information for your review?</h2><p>Contact Oryele to discuss security, privacy, architecture, or procurement requirements.</p></div>
        <a class="btn btn-light" href="/contact/">Contact Oryele</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
.hero{padding:112px 0 88px;background:radial-gradient(circle at 80% 20%,rgba(56,116,255,.25),transparent 34%),linear-gradient(135deg,#061225,#0c2d60);color:#fff}.hero-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(320px,.65fr);gap:64px;align-items:center}.eyebrow{margin:0 0 14px;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#8fb5ff}.eyebrow.dark{color:#2457b8}.hero h1{max-width:820px;margin:0;font-size:clamp(42px,5.8vw,76px);line-height:1.03;letter-spacing:-.04em}.lede{max-width:760px;margin:24px 0 0;color:#c8d5e9;font-size:18px;line-height:1.7}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:34px}.btn{display:inline-flex;align-items:center;justify-content:center;border-radius:10px;padding:13px 19px;text-decoration:none;font-weight:800}.btn-primary{background:#fff;color:#0b2b60}.btn-secondary{border:1px solid rgba(255,255,255,.32);color:#fff}.status-card{padding:30px;border:1px solid rgba(255,255,255,.16);border-radius:20px;background:rgba(255,255,255,.08);box-shadow:0 24px 60px rgba(0,0,0,.2);backdrop-filter:blur(10px)}.status-label{margin:0 0 8px;color:#8fb5ff;font-weight:800;text-transform:uppercase;letter-spacing:.1em;font-size:11px}.status-card h2{margin:0 0 12px;font-size:25px}.status-card>p:not(.status-label){color:#ced9e8;line-height:1.65}.notice{margin-top:18px;padding:14px;border-radius:10px;background:rgba(255,255,255,.08);font-size:13px;line-height:1.55;color:#e8eef8}.principles{background:#fff;border-bottom:1px solid var(--line)}.principles-grid{display:grid;grid-template-columns:repeat(3,1fr)}.principles-grid>div{padding:34px 30px;border-right:1px solid var(--line)}.principles-grid>div:last-child{border-right:0}.principles span{font-size:12px;font-weight:900;color:#2457b8}.principles h2{font-size:20px;margin:8px 0}.principles p{margin:0;color:#59677c;line-height:1.6}.section{padding:92px 0}.section-head{max-width:760px;margin-bottom:38px}.section-head h2,.split h2{font-size:clamp(32px,4vw,48px);line-height:1.08;letter-spacing:-.03em;margin:0 0 16px}.section-head>p:last-child,.split>div>p{color:#58677c;line-height:1.75}.card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{padding:26px;border:1px solid var(--line);border-radius:16px;background:#fff;box-shadow:var(--shadow-card)}.icon{display:grid;place-items:center;width:34px;height:34px;border-radius:9px;background:#eaf1ff;color:#2457b8;font-weight:900}.card h3{margin:18px 0 9px;font-size:19px}.card p{margin:0;color:#59677c;line-height:1.65}.architecture{background:#071528;color:#fff}.split{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}.architecture .split>div>p{color:#b9c9de}.layer-list{display:grid;gap:12px}.layer-list div{display:grid;grid-template-columns:110px 1fr;gap:18px;padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05)}.layer-list span{color:#becce0}.roadmap{background:#f6f8fc}.roadmap ul{list-style:none;padding:0;margin:0;display:grid;gap:12px}.roadmap li{position:relative;padding:17px 18px 17px 48px;border:1px solid #dfe6f1;border-radius:12px;background:#fff;font-weight:700}.roadmap li::before{content:'✓';position:absolute;left:18px;color:#2457b8}.resource-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.resource-grid a{padding:24px;border:1px solid var(--line);border-radius:15px;text-decoration:none;color:inherit;transition:transform .18s ease,box-shadow .18s ease}.resource-grid a:hover{transform:translateY(-3px);box-shadow:var(--shadow-card)}.resource-grid h3{margin:0 0 9px}.resource-grid p{min-height:52px;color:#59677c;line-height:1.55}.resource-grid span{font-weight:800;color:#2457b8}.cta{padding:68px 0;background:linear-gradient(120deg,#1749a4,#2867d8);color:#fff}.cta-inner{display:flex;justify-content:space-between;align-items:center;gap:36px}.cta h2{font-size:36px;margin:0 0 8px}.cta p:last-child{color:#d9e5fa}.btn-light{background:#fff;color:#1749a4;white-space:nowrap}@media(max-width:900px){.hero-grid,.split{grid-template-columns:1fr}.principles-grid,.card-grid,.resource-grid{grid-template-columns:1fr 1fr}.principles-grid>div{border-right:0;border-bottom:1px solid var(--line)}.cta-inner{align-items:flex-start;flex-direction:column}}@media(max-width:620px){.hero{padding-top:88px}.principles-grid,.card-grid,.resource-grid{grid-template-columns:1fr}.section{padding:68px 0}.layer-list div{grid-template-columns:1fr;gap:5px}.cta h2{font-size:30px}}
</style>