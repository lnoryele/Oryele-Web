---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ModuleIcon from "../../components/ModuleIcon.astro";
import { modules } from "../../data/modules";
---
<BaseLayout
  title="Oryele Platform | AI Workflow Automation for Professional Services"
  description="The Oryele platform combines Digital Workforce, Workflow Engine, Communications, Knowledge, Governance, and Analytics into one unified execution layer for professional services firms."
>
  <section class="plat-hero">
    <div class="wrap">
      <p class="eyebrow">The Platform</p>
      <h1>One Platform. Every Workflow. Zero Inefficiency.</h1>
      <p class="lede">
        Oryele is a complete operational platform for professional services firms. Six tightly integrated modules work together to replace the manual coordination work that slows your team down and replace it with intelligent automation that runs around the clock.
      </p>
      <div class="plat-actions">
        <a class="btn btn-blue" href="/contact/">Request a Demo <span class="arrow">→</span></a>
        <a class="btn btn-outline-blue" href="/solutions/">See Industry Solutions</a>
      </div>
    </div>
  </section>

  <section class="plat-overview">
    <div class="wrap">
      <p class="eyebrow">How It Works</p>
      <h2>Built for Firms That Cannot Afford to Drop the Ball</h2>
      <p class="overview-body">
        Professional services firms run on trust. Every missed follow-up, every lost document, every slow response costs client relationships and firm revenue. Oryele eliminates that risk by automating the operational layer so your team can focus entirely on the work that requires their expertise.
      </p>
      <div class="how-grid">
        <div class="how-card">
          <div class="how-num">01</div>
          <h3>Deploy Digital Workers</h3>
          <p>Assign AI-powered workers to defined roles in your firm. They handle intake, follow-up, scheduling, document collection, and client communications without manual oversight.</p>
        </div>
        <div class="how-card">
          <div class="how-num">02</div>
          <h3>Automate Your Workflows</h3>
          <p>Model your firm's processes as structured workflows. Set the rules, approvals, and handoffs. Oryele executes them the same way every time and alerts your team only when human judgment is needed.</p>
        </div>
        <div class="how-card">
          <div class="how-num">03</div>
          <h3>Centralize Communications</h3>
          <p>Send and receive email, SMS, and voice from a single platform. Every message is logged, every consent is tracked, and every client interaction is tied to a complete record.</p>
        </div>
        <div class="how-card">
          <div class="how-num">04</div>
          <h3>Secure Your Knowledge</h3>
          <p>Store all documents, engagement letters, and client records in one encrypted, organized system. Retrieve anything in seconds. Never lose a file again.</p>
        </div>
        <div class="how-card">
          <div class="how-num">05</div>
          <h3>Enforce Governance</h3>
          <p>Role based access, audit trails, and policy controls help your firm strengthen governance, improve accountability, and prepare for regulatory requirements.</p>
        </div>
        <div class="how-card">
          <div class="how-num">06</div>
          <h3>Measure Everything</h3>
          <p>Real time dashboards show you exactly how work moves through your firm. Track throughput, response times, client activity, and outcomes. No more waiting for month-end reports.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="plat-modules">
    <div class="wrap">
      <p class="eyebrow">Platform Modules</p>
      <h2>Six Modules. One Unified Platform.</h2>
      <p class="overview-body">Each module is powerful on its own. Together they create an execution layer that replaces dozens of disconnected tools with a single system your entire firm can depend on.</p>
      <div class="modules-grid">
        {modules.map((m) => (
          <a class="module-card" href={`/platform/${m.slug}/`}>
            <div class="module-card-icon">
              <ModuleIcon icon={m.icon} size={28} />
            </div>
            <div class="module-card-body">
              <h3>{m.title}</h3>
              <p>{m.summary}</p>
              <ul>
                {m.points.map((p) => (
                  <li>
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M3 8l3.5 3.5 6.5-7" stroke="var(--blue)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {p}
                  </li>
                ))}
              </ul>
              <span class="module-card-cta">Learn more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="plat-integrations">
    <div class="wrap">
      <p class="eyebrow">Integrations</p>
      <h2>Works With the Tools You Already Use</h2>
      <div class="int-grid">
        {[
          { name: "Microsoft 365", desc: "Outlook, Teams, SharePoint, and OneDrive" },
          { name: "Google Workspace", desc: "Gmail, Google Calendar, and Google Drive" },
          { name: "Salesforce", desc: "Sync client data and workflows" },
          { name: "DocuSign", desc: "Signature collection built into workflows" },
          { name: "QuickBooks", desc: "Accounting data sync for financial firms" },
          { name: "Twilio", desc: "Enterprise SMS and voice infrastructure" },
        ].map((i) => (
          <div class="int-card">
            <p class="int-name">{i.name}</p>
            <p class="int-desc">{i.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="plat-security">
    <div class="wrap plat-sec-inner">
      <div>
        <p class="eyebrow">Security and Compliance</p>
        <h2>Enterprise Grade Security. On by Default.</h2>
        <p class="overview-body">Every piece of data in Oryele is encrypted at the file level. Role based access controls limit every user and every digital worker to exactly what their job requires. Complete audit trails record every action with a timestamp and actor. Oryele is built for firms that answer to regulators, clients, and partners who demand accountability.</p>
        <a class="btn btn-blue" href="/contact/">Talk to our security team →</a>
      </div>
      <div class="sec-badges">
        {[
          { icon: "lock", label: "File Level Encryption" },
          { icon: "shield", label: "Role Based Access Control" },
          { icon: "audit", label: "Complete Audit Trails" },
          { icon: "hold", label: "Legal Hold" },
          { icon: "mfa", label: "Multi Factor Authentication" },
          { icon: "retain", label: "Configurable Data Retention" },
        ].map((b) => (
          <div class="sec-badge">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--blue)" stroke-width="1.6" aria-hidden="true">
              {b.icon === "lock" && <g><rect x="4" y="9" width="16" height="11" rx="2"/><path d="M8 9V6.5a4 4 0 018 0V9"/></g>}
              {b.icon === "shield" && <path d="M12 3l7 3v5c0 4.8-3 8-7 10-4-2-7-5.2-7-10V6l7-3z"/>}
              {b.icon === "audit" && <g><path d="M9 11l3 3 8-8"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></g>}
              {b.icon === "hold" && <g><path d="M12 2l7 4v6c0 5-3.5 9-7 10-3.5-1-7-5-7-10V6l7-4z"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="15" x2="12.01" y2="15"/></g>}
              {b.icon === "mfa" && <g><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></g>}
              {b.icon === "retain" && <g><circle cx="12" cy="12" r="9"/><path d="M12 7v5l4 2"/></g>}
            </svg>
            <span>{b.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="plat-cta">
    <div class="wrap">
      <h2>Ready to See It in Action?</h2>
      <p>We will walk you through the entire platform in a live session tailored to your firm type and the workflows that matter most to you.</p>
      <a class="btn btn-blue" href="/contact/">Request a Demo <span class="arrow">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .plat-hero {
    background: var(--navy);
    color: #fff;
    padding-block: clamp(64px, 8vw, 104px);
  }
  .plat-hero .eyebrow { color: #60a5fa; }
  h1 { font-size: clamp(34px, 4.5vw, 58px); font-weight: 800; color: #fff; margin: 0 0 22px; }
  .lede { font-size: clamp(17px, 1.6vw, 20px); color: var(--text-inv-2); max-width: 640px; margin: 0 0 36px; }
  .plat-actions { display: flex; gap: 14px; flex-wrap: wrap; }

  .plat-overview { padding-block: clamp(64px, 7vw, 96px); background: var(--paper-2); border-bottom: 1px solid var(--line); }
  h2 { font-size: clamp(26px, 3vw, 40px); font-weight: 800; margin: 0 0 20px; }
  .overview-body { font-size: 17px; color: #33415a; line-height: 1.7; max-width: 720px; margin: 0 0 48px; }
  .how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .how-card { border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; background: #fff; box-shadow: var(--shadow-card); }
  .how-num { font-size: 36px; font-weight: 900; color: var(--blue-soft); margin-bottom: 12px; line-height: 1; }
  .how-card h3 { font-size: 17px; font-weight: 800; margin: 0 0 10px; }
  .how-card p { font-size: 14.5px; color: #33415a; line-height: 1.65; margin: 0; }

  .plat-modules { padding-block: clamp(64px, 7vw, 96px); }
  .modules-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-top: 40px; }
  .module-card {
    display: flex; gap: 20px;
    border: 1px solid var(--line); border-radius: var(--radius);
    padding: 28px; background: #fff; box-shadow: var(--shadow-card);
    text-decoration: none; color: var(--text);
    transition: border-color 160ms, box-shadow 160ms;
  }
  .module-card:hover { border-color: var(--blue); box-shadow: 0 4px 20px rgba(18,63,158,0.12); }
  .module-card-icon {
    width: 52px; height: 52px; flex-shrink: 0;
    display: grid; place-items: center;
    background: var(--blue-soft); color: var(--blue);
    border-radius: 12px;
  }
  .module-card-body { flex: 1; min-width: 0; }
  .module-card h3 { font-size: 17px; font-weight: 800; margin: 0 0 8px; }
  .module-card p { font-size: 14px; color: #33415a; line-height: 1.6; margin: 0 0 14px; }
  .module-card ul { list-style: none; margin: 0 0 16px; padding: 0; display: grid; gap: 6px; }
  .module-card li { display: flex; align-items: flex-start; gap: 8px; font-size: 13px; color: #33415a; line-height: 1.5; }
  .module-card-cta { font-size: 13px; font-weight: 700; color: var(--blue); }

  .plat-integrations { padding-block: clamp(64px, 7vw, 96px); background: var(--paper-2); border-top: 1px solid var(--line); }
  .int-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 40px; }
  .int-card { border: 1px solid var(--line); border-radius: var(--radius); padding: 22px 24px; background: #fff; box-shadow: var(--shadow-card); }
  .int-name { font-size: 15px; font-weight: 800; margin: 0 0 6px; }
  .int-desc { font-size: 13.5px; color: #33415a; margin: 0; }

  .plat-security { padding-block: clamp(64px, 7vw, 96px); border-top: 1px solid var(--line); }
  .plat-sec-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .plat-security .overview-body { margin-bottom: 28px; }
  .sec-badges { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .sec-badge {
    display: flex; align-items: center; gap: 12px;
    border: 1px solid var(--line); border-radius: 10px;
    padding: 16px; background: #fff; box-shadow: var(--shadow-card);
    font-size: 14px; font-weight: 600; color: var(--text);
  }

  .plat-cta {
    background: var(--navy); color: #fff;
    text-align: center;
    padding-block: clamp(64px, 7vw, 96px);
  }
  .plat-cta h2 { font-size: clamp(28px, 3.5vw, 44px); color: #fff; margin-bottom: 16px; }
  .plat-cta p { font-size: 17px; color: var(--text-inv-2); max-width: 560px; margin: 0 auto 32px; }

  @media (max-width: 1000px) {
    .how-grid, .modules-grid, .int-grid { grid-template-columns: 1fr; }
    .plat-sec-inner { grid-template-columns: 1fr; }
    .sec-badges { grid-template-columns: 1fr; }
  }
</style>
