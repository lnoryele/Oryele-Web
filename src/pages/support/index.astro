---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Help Center | Oryele"
  description="Search guides, FAQs, AI-powered support, and documentation for the Oryele platform."
>

  <!-- HERO + SEARCH -->
  <section class="hc-hero">
    <div class="wrap">
      <p class="eyebrow">Help Center</p>
      <h1>How can we help you?</h1>
      <p class="lede">Search guides, FAQs, and documentation or ask our AI assistant anything about Oryele.</p>

      <div class="hc-search-wrap">
        <div class="hc-search-box" role="search">
          <svg class="search-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
          <input
            id="hc-search"
            type="search"
            placeholder="Search documentation, FAQs, guides..."
            autocomplete="off"
            aria-label="Search help center"
          />
          <kbd class="search-kbd" aria-hidden="true">K</kbd>
        </div>
        <div class="hc-search-chips" aria-label="Popular topics">
          <span class="chip-label">Popular:</span>
          <button class="chip" data-query="digital worker">Digital Workers</button>
          <button class="chip" data-query="document upload">Document Upload</button>
          <button class="chip" data-query="MFA password">MFA and Password</button>
          <button class="chip" data-query="SMS consent">SMS Consent</button>
          <button class="chip" data-query="billing plan">Billing and Plans</button>
        </div>
        <div id="hc-search-results" class="hc-search-results" role="listbox" aria-label="Search results"></div>
      </div>

      <div class="hc-contacts">
        <a href="mailto:support@oryele.com" class="hc-contact-btn">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 7 10-7"/></svg>
          support@oryele.com
        </a>
        <a href="mailto:info@oryele.com" class="hc-contact-btn">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 7 10-7"/></svg>
          info@oryele.com
        </a>
        <span class="hc-response-note">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          Response within 2 business hours for critical issues
        </span>
      </div>
    </div>
  </section>

  <!-- QUICK ACCESS CARDS -->
  <section class="hc-pillars">
    <div class="wrap">
      <div class="pillars-grid">
        <a class="pillar-card" href="#documentation">
          <div class="pillar-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></div>
          <div><p class="pillar-title">Product Documentation</p><p class="pillar-desc">Setup guides, step-by-step instructions, and platform reference.</p></div>
        </a>
        <a class="pillar-card" href="#faq">
          <div class="pillar-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
          <div><p class="pillar-title">Frequently Asked Questions</p><p class="pillar-desc">Quick answers on setup, billing, security, and digital workers.</p></div>
        </a>
        <a class="pillar-card" href="#ai-assistant">
          <div class="pillar-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="18" height="14" rx="3"/><path d="M8 21h8M12 17v4"/></svg></div>
          <div><p class="pillar-title">AI Assistant</p><p class="pillar-desc">Ask our AI anything about the Oryele platform and get instant answers.</p></div>
        </a>
        <a class="pillar-card" href="#feedback">
          <div class="pillar-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg></div>
          <div><p class="pillar-title">Share Feedback</p><p class="pillar-desc">Tell us what is working and what is not. Every submission is reviewed.</p></div>
        </a>
      </div>
    </div>
  </section>

  <!-- BODY -->
  <section class="hc-body">
    <div class="wrap hc-inner">

      <nav class="hc-nav" aria-label="Help Center sections">
        <p class="nav-label">Contents</p>
        <p class="nav-group-label">Documentation</p>
        <a href="#firm-setup">Firm Setup</a>
        <a href="#client-onboarding">Client Onboarding</a>
        <a href="#document-collection">Document Collection</a>
        <a href="#communications">Communications and SMS</a>
        <a href="#workflows">Workflows</a>
        <a href="#digital-workers">Digital Workers</a>
        <a href="#security">Security and Access</a>
        <a href="#billing">Billing and Account</a>
        <p class="nav-group-label">Support</p>
        <a href="#client-guide">Client Guide</a>
        <a href="#faq">FAQ</a>
        <a href="#ai-assistant" id="nav-ai-link">AI Assistant</a>
        <a href="#feedback">Feedback</a>
      </nav>

      <div class="hc-content" id="documentation">

        <!-- DOCUMENTATION -->
        <div class="hc-chapter">
          <div class="chapter-header">
            <div class="chapter-icon"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div>
            <p class="chapter-title">Product Documentation</p>
          </div>
          <p class="chapter-intro">Step-by-step instructions for every module. Use the sidebar or search above to jump to what you need.</p>
        </div>

        <div class="hc-section" id="firm-setup">
          <p class="section-title">Firm Setup</p>
          <div class="hc-article">
            <p class="article-title">Setting up your Oryele account</p>
            <p>After your account is created, log in at <strong>app.oryele.ai</strong> using the credentials emailed to you. On first login you will be prompted to set a permanent password and enable multi-factor authentication. MFA is required for all administrator accounts.</p>
            <p>Navigate to <strong>Settings then Firm Profile</strong> and complete the following:</p>
            <ol>
              <li>Enter your firm name, address, and primary contact information</li>
              <li>Upload your firm logo (PNG or SVG, minimum 400px wide)</li>
              <li>Set your firm time zone as this controls all scheduling and reminder timing</li>
              <li>Enter your primary support email as this is where client replies are routed</li>
            </ol>
          </div>
          <div class="hc-article">
            <p class="article-title">Inviting your team and setting roles</p>
            <p>Go to <strong>Settings then Team Members then Invite</strong>. Enter each team member name and work email. They will receive an invitation to set up their own login. Oryele has four built-in roles:</p>
            <ul>
              <li><strong>Administrator</strong> has full access to all settings, billing, and data</li>
              <li><strong>Manager</strong> can create and manage workflows, digital workers, and clients with no billing access</li>
              <li><strong>Staff</strong> can view and action assigned tasks and client communications</li>
              <li><strong>Read Only</strong> can view all records but cannot make changes</li>
            </ul>
          </div>
          <div class="hc-article">
            <p class="article-title">Connecting your email and calendar</p>
            <p>Go to <strong>Settings then Integrations</strong> and select your provider (Microsoft 365 or Google Workspace). You will be redirected to authorize Oryele. All outbound emails will appear to come from your firm own address. Calendar sync lets digital workers schedule appointments directly into your team calendars.</p>
          </div>
        </div>

        <div class="hc-section" id="client-onboarding">
          <p class="section-title">Client Onboarding</p>
          <div class="hc-article">
            <p class="article-title">Adding a new client</p>
            <p>Go to <strong>Clients then Add Client</strong>. Enter the client full legal name, email, phone, and any reference number your firm uses. Click Save. Oryele will create a client record and can optionally trigger an onboarding workflow automatically.</p>
          </div>
          <div class="hc-article">
            <p class="article-title">Sending an engagement letter</p>
            <p>From the client profile, click <strong>Send Engagement Letter</strong>. Select the appropriate template, review, and click Send. The client receives an email with a link to review and sign electronically. Once signed, the executed copy is stored automatically. If unsigned after 3 days, Oryele sends a reminder. After 7 days, it escalates to your designated staff member.</p>
          </div>
          <div class="hc-article">
            <p class="article-title">Tracking onboarding status</p>
            <p>Go to <strong>Clients then Onboarding</strong>. The status column shows: Invitation Sent, Engagement Letter Pending, Documents Requested, Onboarding Complete. Click any client for a full timeline of every action and communication.</p>
          </div>
        </div>

        <div class="hc-section" id="document-collection">
          <p class="section-title">Document Collection</p>
          <div class="hc-article">
            <p class="article-title">Requesting documents from a client</p>
            <p>From a client profile, click <strong>Request Documents</strong>. Select from the checklist or type a custom name. Set a due date and click Send. The client receives a secure upload link by email and optional SMS. No account is required and the link expires after 30 days.</p>
          </div>
          <div class="hc-article">
            <p class="article-title">Monitoring outstanding requests</p>
            <p>Go to <strong>Documents then Pending Requests</strong>. All outstanding requests are sorted by due date with statuses: Sent, Viewed, Partially Uploaded, Complete. Oryele auto-sends reminders at 3 days and 1 day before the due date, then flags and notifies staff if the deadline passes.</p>
          </div>
          <div class="hc-article">
            <p class="article-title">Accessing uploaded documents</p>
            <p>All uploads are stored in <strong>Clients then the Client Name then Documents</strong>, organized by tax year and document type. Every document shows who uploaded it and when. Files can be downloaded individually or as a zip package.</p>
          </div>
        </div>

        <div class="hc-section" id="communications">
          <p class="section-title">Communications and SMS</p>
          <div class="hc-article">
            <p class="article-title">Enabling SMS messaging</p>
            <p>Go to <strong>Settings then Communications then SMS</strong> and verify your business phone number. Oryele tracks consent status for every client automatically. You cannot send SMS to clients who have not opted in or who have previously opted out. Consent status is visible on each client profile.</p>
          </div>
          <div class="hc-article">
            <p class="article-title">Sending a message to a client</p>
            <p>From a client profile, click <strong>Send Message</strong>. Select Email, SMS, or both. Type your message or select a template. Every message is logged in the client communication history with a timestamp. All client replies appear in your firm connected email inbox.</p>
          </div>
          <div class="hc-article">
            <p class="article-title">Setting up automated reminders</p>
            <p>Go to <strong>Workflows then Reminders</strong>. Create sequences triggered by document due dates, appointment times, or engagement letter expiry. Set timing and channel (email, SMS, or both). Reminders run without any manual action.</p>
          </div>
        </div>

        <div class="hc-section" id="workflows">
          <p class="section-title">Workflows</p>
          <div class="hc-article">
            <p class="article-title">What is a workflow?</p>
            <p>A workflow is a sequence of steps Oryele executes automatically. For example: send engagement letter, request documents, send reminders, notify staff when complete, then send completion notice. Workflows run in the background and your team acts only when human judgment is needed.</p>
          </div>
          <div class="hc-article">
            <p class="article-title">Creating a workflow from a template</p>
            <p>Go to <strong>Workflows then Templates</strong>. Pre-built templates include tax return preparation, bookkeeping onboarding, and engagement renewal. Select a template, customize timing and messaging, and click Activate.</p>
          </div>
          <div class="hc-article">
            <p class="article-title">Monitoring active workflows</p>
            <p>Go to <strong>Workflows then Active</strong>. A progress indicator shows which step each client is on. Click any workflow for the full history of completed and pending steps.</p>
          </div>
        </div>

        <div class="hc-section" id="digital-workers">
          <p class="section-title">Digital Workers</p>
          <div class="hc-article">
            <p class="article-title">What is a digital worker?</p>
            <p>A digital worker is an AI-powered assistant that handles a defined set of tasks on behalf of your firm. It sends welcome emails, requests documents, follows up, and notifies your team when actions are complete. It works around the clock and logs every action it takes.</p>
          </div>
          <div class="hc-article">
            <p class="article-title">Activating a digital worker</p>
            <p>Go to <strong>Digital Workers then Activate</strong>. Select the worker type (Intake Worker, Document Collection Worker, Appointment Worker). Configure its name, sending email address, and escalation rules. Click Activate. You can pause or deactivate at any time.</p>
          </div>
          <div class="hc-article">
            <p class="article-title">Reviewing worker activity</p>
            <p>Go to <strong>Digital Workers then Activity Log</strong>. Every action is recorded with a timestamp, the client it acted on, and what was done. Filter by worker, client, date range, or action type. Logs are exportable to CSV.</p>
          </div>
        </div>

        <div class="hc-section" id="security">
          <p class="section-title">Security and Access</p>
          <div class="hc-article">
            <p class="article-title">Resetting a password</p>
            <p>Go to <strong>app.oryele.ai</strong> and click <strong>Forgot Password</strong>. Enter your work email. A reset link arrives within 2 minutes and expires after 30 minutes. Check your spam folder if you do not receive it, or contact your firm administrator.</p>
          </div>
          <div class="hc-article">
            <p class="article-title">Setting up multi-factor authentication</p>
            <p>MFA is required for all administrator accounts. Go to <strong>Settings then Security then MFA</strong>. Scan the QR code with Google Authenticator, Microsoft Authenticator, or Authy. Enter the 6-digit code to verify. You will be prompted for a code on each new device login.</p>
          </div>
          <div class="hc-article">
            <p class="article-title">Removing a team member</p>
            <p>Go to <strong>Settings then Team Members</strong>, find the team member, and click <strong>Deactivate</strong>. Access is revoked immediately. All prior actions remain in the audit log and records are marked inactive, not deleted.</p>
          </div>
          <div class="hc-article">
            <p class="article-title">Exporting audit logs</p>
            <p>Go to <strong>Settings then Audit Log</strong>. Filter by date, user, or action type and click <strong>Export</strong> for a CSV of every action including who did what and when. Audit logs are retained for a minimum of 7 years.</p>
          </div>
        </div>

        <div class="hc-section" id="billing">
          <p class="section-title">Billing and Account</p>
          <div class="hc-article">
            <p class="article-title">Viewing your current plan</p>
            <p>Go to <strong>Settings then Billing</strong>. Your current plan, next billing date, and payment method are shown. Invoice history is available for download.</p>
          </div>
          <div class="hc-article">
            <p class="article-title">Upgrading or changing your plan</p>
            <p>Contact <a href="mailto:sales@oryele.com">sales@oryele.com</a> to discuss options. Plan changes take effect at the start of your next billing cycle unless you request an immediate upgrade.</p>
          </div>
          <div class="hc-article">
            <p class="article-title">Getting technical support</p>
            <p>Email <a href="mailto:support@oryele.com">support@oryele.com</a> with the issue description, your firm name, and any screenshots. We respond within 2 business hours for critical issues and 1 business day for general questions.</p>
          </div>
        </div>

        <!-- CLIENT GUIDE -->
        <div class="hc-chapter" id="client-guide">
          <div class="chapter-header">
            <div class="chapter-icon"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div>
            <p class="chapter-title">Client Guide</p>
          </div>
          <p class="chapter-intro">For clients of accounting firms that use Oryele. Contact your firm directly for firm-specific questions.</p>
        </div>

        <div class="hc-section">
          <div class="hc-article">
            <p class="article-title">How to upload documents</p>
            <p>When your firm requests documents you will receive an email with a secure upload link. No account or password is required. Click the link, select files next to each requested item, and upload. Supported formats are PDF, JPG, PNG, and common Office formats. Your firm is notified automatically on upload.</p>
          </div>
          <div class="hc-article">
            <p class="article-title">How to sign an engagement letter</p>
            <p>Click the link in the email your firm sends. Read the document, click <strong>Sign</strong>, type your full name as your electronic signature, and click <strong>Submit</strong>. You will receive a copy by email immediately.</p>
          </div>
          <div class="hc-article">
            <p class="article-title">How to opt out of SMS</p>
            <p>Reply STOP to any text message from your accounting firm. You will receive one final confirmation and no further texts. To opt back in, reply START or contact your firm.</p>
          </div>
          <div class="hc-article">
            <p class="article-title">Your data is secure</p>
            <p>All documents are encrypted in transit and at rest. Only your accounting firm and authorized team members can access your files. Oryele does not sell or share your information. Questions? Email <a href="mailto:support@oryele.com">support@oryele.com</a>.</p>
          </div>
        </div>

        <!-- FAQ -->
        <div class="hc-chapter" id="faq">
          <div class="chapter-header">
            <div class="chapter-icon"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
            <p class="chapter-title">Frequently Asked Questions</p>
          </div>
          <p class="chapter-intro">Click any question to expand the answer.</p>
        </div>

        <div class="hc-section">
          <div class="faq-group">
            <p class="faq-group-label">Getting Started</p>
            <details class="faq-item"><summary>How long does it take to set up Oryele?</summary><div class="faq-body"><p>Most firms are fully operational within one business day. Firm profile setup takes about 30 minutes. Connecting email, calendar, inviting your team, and activating your first workflow typically takes another 1 to 2 hours. Your onboarding specialist will guide you through each step.</p></div></details>
            <details class="faq-item"><summary>Does Oryele work with Microsoft 365 and Google Workspace?</summary><div class="faq-body"><p>Yes. Oryele integrates natively with both. Connect your email and calendar under <strong>Settings then Integrations</strong>. All outbound messages appear to come from your firm own email address.</p></div></details>
            <details class="faq-item"><summary>Can I import my existing client list?</summary><div class="faq-body"><p>Yes. Go to <strong>Clients then Import</strong> and upload a CSV. The import wizard maps your columns to Oryele fields and previews the import before it runs. Contact <a href="mailto:support@oryele.com">support@oryele.com</a> if you need help formatting your export.</p></div></details>
          </div>

          <div class="faq-group">
            <p class="faq-group-label">Security and Compliance</p>
            <details class="faq-item"><summary>Is client data encrypted?</summary><div class="faq-body"><p>Yes. All data is encrypted in transit (TLS 1.3) and at rest (AES-256). Encryption keys are unique per file. Oryele maintains complete audit trails of every access event.</p></div></details>
            <details class="faq-item"><summary>Does Oryele support MFA?</summary><div class="faq-body"><p>Yes. MFA is required for administrator accounts and recommended for all users. Oryele supports TOTP-based apps (Google Authenticator, Microsoft Authenticator, Authy). Set it up under <strong>Settings then Security then MFA</strong>.</p></div></details>
            <details class="faq-item"><summary>How long are audit logs retained?</summary><div class="faq-body"><p>A minimum of 7 years. Logs are exportable at any time from <strong>Settings then Audit Log</strong> and record every action by every user and digital worker.</p></div></details>
            <details class="faq-item"><summary>Does Oryele support legal hold?</summary><div class="faq-body"><p>Yes. Legal hold can be placed on individual client records or a defined set. Records under legal hold are exempt from normal retention and deletion policies. Contact <a href="mailto:support@oryele.com">support@oryele.com</a> to activate.</p></div></details>
          </div>

          <div class="faq-group">
            <p class="faq-group-label">Digital Workers</p>
            <details class="faq-item"><summary>Can a digital worker send emails on my behalf?</summary><div class="faq-body"><p>Yes. Once your email is connected under <strong>Settings then Integrations</strong>, digital workers send from your firm email address. All sent messages are logged in the client communication history.</p></div></details>
            <details class="faq-item"><summary>What happens when a digital worker encounters an exception?</summary><div class="faq-body"><p>Every worker has configurable escalation rules. When an exception occurs, the worker pauses on that item and notifies the assigned team member by email or SMS. All other clients continue unaffected.</p></div></details>
            <details class="faq-item"><summary>Can I pause a digital worker at any time?</summary><div class="faq-body"><p>Yes. Go to <strong>Digital Workers</strong>, find the worker, and click <strong>Pause</strong> or <strong>Deactivate</strong>. Pausing stops the worker without losing configuration. All prior activity remains in the log.</p></div></details>
          </div>

          <div class="faq-group">
            <p class="faq-group-label">Billing and Plans</p>
            <details class="faq-item"><summary>How is Oryele priced?</summary><div class="faq-body"><p>Oryele is priced per firm based on active clients and modules included. Visit the <a href="/pricing/">Pricing page</a> or contact <a href="mailto:sales@oryele.com">sales@oryele.com</a> for a plan tailored to your firm.</p></div></details>
            <details class="faq-item"><summary>Can I cancel at any time?</summary><div class="faq-body"><p>Monthly plans can be cancelled at any time with no penalty. Annual plans are billed for the full term and offer a discount. Contact <a href="mailto:sales@oryele.com">sales@oryele.com</a> for details.</p></div></details>
            <details class="faq-item"><summary>Can I get a demo before committing?</summary><div class="faq-body"><p>Yes. Request a live demo at <a href="/contact/">oryele.com/contact</a>. Every demo is tailored to your firm type with no obligation and no hard sell.</p></div></details>
          </div>
        </div>

        <!-- AI ASSISTANT -->
        <!-- FEEDBACK -->
        <div class="hc-chapter" id="feedback">
          <div class="chapter-header">
            <div class="chapter-icon"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg></div>
            <p class="chapter-title">Share Feedback</p>
          </div>
          <p class="chapter-intro">Every submission goes directly to the Oryele product team. We read everything.</p>
        </div>

        <div class="hc-section">
          <div class="feedback-card">
            <div class="feedback-rating">
              <p class="feedback-q">How would you rate your experience with Oryele?</p>
              <div class="rating-stars" role="group" aria-label="Star rating">
                {[1,2,3,4,5].map(n => (
                  <button class="star" data-value={String(n)} aria-label={`${n} star${n > 1 ? 's' : ''}`}>
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  </button>
                ))}
              </div>
            </div>
            <div class="feedback-type-row">
              <p class="feedback-q">Type of feedback</p>
              <div class="feedback-types">
                <button class="ftype-btn is-active" data-type="general">General</button>
                <button class="ftype-btn" data-type="bug">Bug Report</button>
                <button class="ftype-btn" data-type="feature">Feature Request</button>
                <button class="ftype-btn" data-type="docs">Documentation</button>
              </div>
            </div>
            <div id="fb-form-body" class="feedback-form-rows">
              <div class="fb-row-2">
                <div class="fb-field"><label for="fb-name">Name <span class="fb-optional">(optional)</span></label><input id="fb-name" type="text" placeholder="Jane Smith" /></div>
                <div class="fb-field"><label for="fb-email">Email <span class="fb-optional">(optional)</span></label><input id="fb-email" type="email" placeholder="jane@yourfirm.com" /></div>
              </div>
              <div class="fb-field">
                <label for="fb-message">Your feedback <span class="fb-req">*</span></label>
                <textarea id="fb-message" rows="5" placeholder="Tell us what is working well, what could be better, or what you would like to see added..."></textarea>
              </div>
              <div class="fb-field">
                <label class="fb-checkbox-label"><input type="checkbox" id="fb-contact" /> I am open to being contacted about this feedback</label>
              </div>
              <div class="fb-actions">
                <button class="btn btn-blue" id="fb-submit">Send Feedback <span aria-hidden="true">&#8594;</span></button>
                <p class="fb-note">Reviewed by the Oryele product team. We do not share your information.</p>
              </div>
            </div>
            <div id="fb-success" class="fb-success fb-success--hidden">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              Thank you. Your feedback has been received and will be reviewed by the product team.
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

<!-- FLOATING AI ASSISTANT -->
<div id="ai-widget" class="ai-widget" aria-label="AI Assistant">

  <button id="ai-toggle" class="ai-toggle" aria-label="Open AI assistant" aria-expanded="false">
    <span class="ai-toggle-icon ai-toggle-icon--open">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="18" height="14" rx="3"/><path d="M8 21h8M12 17v4"/></svg>
    </span>
    <span class="ai-toggle-icon ai-toggle-icon--close">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </span>
    <span class="ai-toggle-label">AI Assistant</span>
    <span id="ai-unread" class="ai-unread" hidden>1</span>
  </button>

  <div id="ai-panel" class="ai-panel ai-panel--hidden" role="dialog" aria-label="Oryele AI Assistant">
    <div class="ai-panel-header">
      <div class="ai-panel-title">
        <div class="ai-panel-avatar"><img src="/elle-avatar.png" alt="Elle" style="width:34px;height:34px;border-radius:50%;object-fit:cover;"/></div>
        <div>
          <p class="ai-panel-name">Elle</p>
          <p class="ai-panel-status"><span class="ai-online-dot"></span>Online</p>
        </div>
      </div>
      <button class="ai-panel-close" id="ai-close" aria-label="Close AI assistant">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="ai-chat-messages" id="ai-messages" aria-live="polite">
      <div class="ai-msg ai-msg--assistant">
        <div class="ai-msg-header"><div class="ai-avatar" aria-hidden="true"><img src="/elle-avatar.png" alt="Elle" style="width:26px;height:26px;border-radius:50%;object-fit:cover;"/></div><p class="ai-sender-label">Elle · Assistant</p></div>
        <div class="ai-bubble"><p>Hi, I am Elle, your Oryele assistant. Ask me anything about the platform including setup, workflows, digital workers, billing, and security.</p></div>
      </div>
    </div>
    <div class="ai-suggestions" id="ai-suggestions">
      <button class="ai-suggest-btn" data-q="How do I activate a digital worker?">Activate a digital worker</button>
      <button class="ai-suggest-btn" data-q="How do I set up MFA?">Set up MFA</button>
      <button class="ai-suggest-btn" data-q="How do document requests work?">Document requests</button>
      <button class="ai-suggest-btn" data-q="How do I import my client list?">Import clients</button>
    </div>
    <div class="ai-input-row">
      <input id="ai-input" type="text" placeholder="Ask a question..." aria-label="Ask the AI assistant" autocomplete="off" maxlength="500" />
      <button class="ai-send-btn" id="ai-send" aria-label="Send">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </div>
    <p class="ai-disclaimer">For account-specific issues contact <a href="mailto:support@oryele.com">support@oryele.com</a>.</p>
  </div>
</div>

<script is:inline>
(function () {

  // ── Search ───────────────────────────────────────────────────────
  var searchIndex = [
    { title: 'Setting up your account', section: 'Firm Setup', anchor: '#firm-setup', keywords: 'setup account login mfa password firm profile logo' },
    { title: 'Inviting your team and setting roles', section: 'Firm Setup', anchor: '#firm-setup', keywords: 'team invite roles administrator manager staff permissions' },
    { title: 'Connecting your email and calendar', section: 'Firm Setup', anchor: '#firm-setup', keywords: 'email calendar microsoft google workspace integration outlook gmail' },
    { title: 'Adding a new client', section: 'Client Onboarding', anchor: '#client-onboarding', keywords: 'add client new onboarding create record' },
    { title: 'Sending an engagement letter', section: 'Client Onboarding', anchor: '#client-onboarding', keywords: 'engagement letter send sign esign template' },
    { title: 'Tracking onboarding status', section: 'Client Onboarding', anchor: '#client-onboarding', keywords: 'onboarding status track progress timeline' },
    { title: 'Requesting documents from a client', section: 'Document Collection', anchor: '#document-collection', keywords: 'documents request upload bank statements checklist' },
    { title: 'Monitoring outstanding requests', section: 'Document Collection', anchor: '#document-collection', keywords: 'pending documents outstanding reminders due date' },
    { title: 'Accessing uploaded documents', section: 'Document Collection', anchor: '#document-collection', keywords: 'download documents access uploaded files folder' },
    { title: 'Enabling SMS messaging', section: 'Communications', anchor: '#communications', keywords: 'SMS enable text messaging consent opt in phone' },
    { title: 'Sending a message to a client', section: 'Communications', anchor: '#communications', keywords: 'send message email SMS client communicate' },
    { title: 'Setting up automated reminders', section: 'Communications', anchor: '#communications', keywords: 'reminders automated schedule trigger sequence' },
    { title: 'What is a workflow?', section: 'Workflows', anchor: '#workflows', keywords: 'workflow automation process steps background' },
    { title: 'Creating a workflow from a template', section: 'Workflows', anchor: '#workflows', keywords: 'workflow template create tax bookkeeping activate' },
    { title: 'Monitoring active workflows', section: 'Workflows', anchor: '#workflows', keywords: 'workflow active monitor progress status running' },
    { title: 'What is a digital worker?', section: 'Digital Workers', anchor: '#digital-workers', keywords: 'digital worker AI intake document appointment' },
    { title: 'Activating a digital worker', section: 'Digital Workers', anchor: '#digital-workers', keywords: 'digital worker activate configure escalation rules' },
    { title: 'Reviewing worker activity', section: 'Digital Workers', anchor: '#digital-workers', keywords: 'digital worker activity log audit history CSV export' },
    { title: 'Resetting a password', section: 'Security', anchor: '#security', keywords: 'password reset forgot login credentials' },
    { title: 'Setting up MFA', section: 'Security', anchor: '#security', keywords: 'MFA multi factor authentication google authenticator authy' },
    { title: 'Removing a team member', section: 'Security', anchor: '#security', keywords: 'remove deactivate team member access revoke user' },
    { title: 'Exporting audit logs', section: 'Security', anchor: '#security', keywords: 'audit log export CSV download 7 years' },
    { title: 'Viewing your current plan', section: 'Billing', anchor: '#billing', keywords: 'billing plan subscription payment invoice' },
    { title: 'Upgrading or changing your plan', section: 'Billing', anchor: '#billing', keywords: 'upgrade plan change sales pricing' },
    { title: 'Getting technical support', section: 'Billing', anchor: '#billing', keywords: 'support contact help technical issue response' },
    { title: 'How to upload documents', section: 'Client Guide', anchor: '#client-guide', keywords: 'upload documents client guide secure link PDF' },
    { title: 'How to sign an engagement letter', section: 'Client Guide', anchor: '#client-guide', keywords: 'sign engagement letter electronic signature client' },
    { title: 'How to opt out of SMS', section: 'Client Guide', anchor: '#client-guide', keywords: 'SMS opt out STOP text message client' },
  ];

  var searchInput = document.getElementById('hc-search');
  var searchResults = document.getElementById('hc-search-results');

  function runSearch(q) {
    var query = (q || '').toLowerCase().trim();
    if (!query) { searchResults.innerHTML = ''; searchResults.classList.remove('is-open'); return; }
    var hits = searchIndex.filter(function (item) {
      return item.title.toLowerCase().indexOf(query) > -1
          || item.keywords.toLowerCase().indexOf(query) > -1
          || item.section.toLowerCase().indexOf(query) > -1;
    }).slice(0, 6);
    if (hits.length === 0) {
      searchResults.innerHTML = '<p class="sr-no-results">No results for "' + q + '". Press Enter to search or <a href="mailto:support@oryele.com">email support</a>.</p>';
    } else {
      searchResults.innerHTML = hits.map(function (h) {
        return '<a class="sr-item" href="' + h.anchor + '"><span class="sr-section">' + h.section + '</span><span class="sr-title">' + h.title + '</span></a>';
      }).join('');
    }
    searchResults.classList.add('is-open');
  }

  if (searchInput && searchResults) {
    searchInput.addEventListener('input', function () { runSearch(searchInput.value); });
    searchInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && searchInput.value.trim()) {
        e.preventDefault();
        window.location.href = '/support/search/?q=' + encodeURIComponent(searchInput.value.trim());
        return;
      }
      if (e.key === 'Escape') { searchResults.classList.remove('is-open'); searchInput.blur(); }
    });
    document.addEventListener('click', function (e) {
      var wrap = document.querySelector('.hc-search-wrap');
      if (wrap && !wrap.contains(e.target)) { searchResults.classList.remove('is-open'); }
    });
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); searchInput.focus(); }
    });
  }

  document.querySelectorAll('.chip').forEach(function (chip) {
    chip.addEventListener('click', function () {
      window.location.href = '/support/search/?q=' + encodeURIComponent(chip.dataset.query || '');
    });
  });

  // ── Nav highlight ────────────────────────────────────────────────
  document.querySelectorAll('.hc-nav a').forEach(function (link) {
    link.addEventListener('click', function () {
      document.querySelectorAll('.hc-nav a').forEach(function (l) { l.classList.remove('is-active'); });
      link.classList.add('is-active');
    });
  });

  // ── Star rating ──────────────────────────────────────────────────
  var stars = document.querySelectorAll('.star');
  stars.forEach(function (star) {
    star.addEventListener('mouseenter', function () {
      var val = +star.dataset.value;
      stars.forEach(function (s) { s.classList.toggle('hovered', +s.dataset.value <= val); });
    });
    star.addEventListener('mouseleave', function () { stars.forEach(function (s) { s.classList.remove('hovered'); }); });
    star.addEventListener('click', function () {
      var val = +star.dataset.value;
      stars.forEach(function (s) { s.classList.toggle('selected', +s.dataset.value <= val); });
    });
  });

  // ── Feedback type ────────────────────────────────────────────────
  document.querySelectorAll('.ftype-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.ftype-btn').forEach(function (b) { b.classList.remove('is-active'); });
      btn.classList.add('is-active');
    });
  });

  // ── Feedback submit ──────────────────────────────────────────────
  var fbSubmit  = document.getElementById('fb-submit');
  var fbSuccess = document.getElementById('fb-success');
  var fbFormBody = document.getElementById('fb-form-body');
  var fbMsgField = document.getElementById('fb-message');

  if (fbSubmit && fbSuccess && fbMsgField && fbFormBody) {
    fbSubmit.addEventListener('click', async function () {
      var msg = fbMsgField.value.trim();
      if (!msg) { fbMsgField.focus(); return; }

      var name    = document.getElementById('fb-name') ? document.getElementById('fb-name').value.trim() : '';
      var email   = document.getElementById('fb-email') ? document.getElementById('fb-email').value.trim() : '';
      var contact = document.getElementById('fb-contact') ? document.getElementById('fb-contact').checked : false;
      var ftype   = document.querySelector('.ftype-btn.is-active');
      var type    = ftype ? ftype.dataset.type : 'general';
      var ratingEl = document.querySelector('.star.selected:last-of-type');
      var rating  = ratingEl ? ratingEl.dataset.value : 'not rated';

      fbSubmit.disabled = true;
      fbSubmit.textContent = 'Sending...';

      try {
        var fd = new FormData();
        fd.append('_subject', 'Help Center Feedback: ' + type + ' from ' + (name || 'anonymous'));
        fd.append('_captcha', 'false');
        fd.append('Name', name || 'Anonymous');
        fd.append('Email', email || 'Not provided');
        fd.append('Type', type);
        fd.append('Rating', rating + ' stars');
        fd.append('Message', msg);
        fd.append('Open to contact', contact ? 'Yes' : 'No');

        var res = await fetch('https://formsubmit.co/ajax/info@oryele.com', {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: fd,
        });
        var data = await res.json();
        if (data.success === 'true' || data.success === true) {
          fbFormBody.style.display = 'none';
          fbSuccess.classList.remove('fb-success--hidden');
        } else {
          throw new Error('Failed');
        }
      } catch (err) {
        fbSubmit.disabled = false;
        fbSubmit.innerHTML = 'Send Feedback <span aria-hidden="true">&#8594;</span>';
        alert('Something went wrong. Please email support@oryele.com directly.');
      }
    });
  }

  // ── AI Assistant ─────────────────────────────────────────────────
  var SYSTEM_PROMPT =
    'You are the Oryele Help Center AI assistant. Oryele is an AI-powered workflow automation ' +
    'and digital workers platform for professional services firms, primarily accounting firms. ' +
    'You have deep knowledge of every Oryele module: Digital Workforce (AI workers, roles, permissions, escalation, activity logs), ' +
    'Workflow Engine (visual process design, conditional routing, approvals, templates), ' +
    'Communications (email, SMS, voice, calendar, consent tracking, reminders), ' +
    'Knowledge (document management, OCR, versioning, permissions), ' +
    'Governance (RBAC, audit trails, legal hold, retention, SSO, MFA), ' +
    'Analytics (dashboards, cycle time, bottleneck analysis, reporting). ' +
    'Keep answers concise and practical. Use numbered steps for processes. ' +
    'Support: support@oryele.com (2hr SLA for critical issues). Sales: sales@oryele.com.';

  var chatHistory = [];
  var aiInput     = document.getElementById('ai-input');
  var aiSend      = document.getElementById('ai-send');
  var aiMessages  = document.getElementById('ai-messages');
  var aiSugs      = document.getElementById('ai-suggestions');

  function addBubble(role, text) {
    var wrap = document.createElement('div');
    wrap.className = 'ai-msg ai-msg--' + role;
    var header = document.createElement('div');
    header.className = 'ai-msg-header';
    var avatar = document.createElement('div');
    avatar.className = 'ai-avatar';
    avatar.setAttribute('aria-hidden', 'true');
    avatar.innerHTML = role === 'assistant'
      ? '<img src="/elle-avatar.png" alt="Elle" style="width:26px;height:26px;border-radius:50%;object-fit:cover;"/>'
      : '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>';
    header.appendChild(avatar);
    if (role === 'assistant') {
      var label = document.createElement('p');
      label.className = 'ai-sender-label';
      label.textContent = 'Elle · Assistant';
      header.appendChild(label);
    }
    var bubble = document.createElement('div');
    bubble.className = 'ai-bubble';
    var p = document.createElement('div');
    p.textContent = text;
    p.style.cssText = 'margin:0;font-size:13px;line-height:1.6;border-radius:10px;padding:8px 11px;white-space:pre-wrap;display:block;font-family:inherit;';
    if (role === 'user') { p.style.background = '#e8f0fe'; p.style.color = '#1a2a4a'; p.style.border = '1px solid #c7d9fd'; p.style.borderRadius = '10px 10px 2px 10px'; } else { p.style.background = 'var(--paper-2)'; p.style.color = 'var(--text)'; p.style.border = '1px solid var(--line)'; p.style.borderRadius = '2px 10px 10px 10px'; }
    bubble.appendChild(p);
    wrap.appendChild(header);
    wrap.appendChild(bubble);
    aiMessages.appendChild(wrap);
    aiMessages.scrollTop = aiMessages.scrollHeight;
  }

  function showTyping() {
    var wrap = document.createElement('div');
    wrap.className = 'ai-msg ai-msg--assistant';
    wrap.id = 'ai-typing';
    wrap.innerHTML = '<div class="ai-avatar" aria-hidden="true"><img src="/elle-avatar.png" alt="Elle" style="width:26px;height:26px;border-radius:50%;object-fit:cover;"/></div><div class="ai-bubble"><span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span></div>';
    aiMessages.appendChild(wrap);
    aiMessages.scrollTop = aiMessages.scrollHeight;
  }

  function hideTyping() { var t = document.getElementById('ai-typing'); if (t) t.remove(); }
  function setLocked(v) { if (aiInput) aiInput.disabled = v; if (aiSend) aiSend.disabled = v; }

  async function sendAI(text) {
    text = (text || '').trim();
    if (!text) return;
    if (aiSugs) aiSugs.style.display = 'none';
    chatHistory.push({ role: 'user', content: text });
    addBubble('user', text);
    if (aiInput) aiInput.value = '';
    setLocked(true);
    showTyping();

    try {
      var res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ system: SYSTEM_PROMPT, messages: chatHistory }),
      });
      if (!res.ok) { throw new Error('HTTP ' + res.status + ' from /api/chat'); }
      var data = await res.json();
      if (data.error) { throw new Error(data.error); }
      var reply = (data.content && data.content[0] && data.content[0].text)
        ? data.content[0].text
        : 'No response received. Please email support@oryele.com.';
      hideTyping();
      chatHistory.push({ role: 'assistant', content: reply });
      addBubble('assistant', reply);
    } catch (err) {
      hideTyping();
      addBubble('assistant', 'Could not reach the AI (' + (err.message || 'unknown error') + '). Please email support@oryele.com for help.');
    }

    setLocked(false);
    if (aiInput) aiInput.focus();
  }

  if (aiSend && aiInput) {
    aiSend.addEventListener('click', function () { sendAI(aiInput.value); });
    aiInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendAI(aiInput.value); }
    });
  }

  document.querySelectorAll('.ai-suggest-btn').forEach(function (btn) {
    btn.addEventListener('click', function () { sendAI(btn.dataset.q); });
  });

  // ── Widget toggle ────────────────────────────────────────────────
  var aiWidget = document.getElementById('ai-widget');
  var aiToggle = document.getElementById('ai-toggle');
  var aiPanel  = document.getElementById('ai-panel');
  var aiClose  = document.getElementById('ai-close');
  var aiUnread = document.getElementById('ai-unread');
  var navAiLink = document.getElementById('nav-ai-link');

  function openWidget() {
    if (!aiWidget || !aiPanel || !aiToggle) return;
    aiWidget.classList.add('is-open');
    aiPanel.classList.remove('ai-panel--hidden');
    aiToggle.setAttribute('aria-expanded', 'true');
    if (aiUnread) aiUnread.hidden = true;
    if (aiInput) { setTimeout(function () { aiInput.focus(); }, 120); }
  }

  function closeWidget() {
    if (!aiWidget || !aiPanel || !aiToggle) return;
    aiWidget.classList.remove('is-open');
    aiPanel.classList.add('ai-panel--hidden');
    aiToggle.setAttribute('aria-expanded', 'false');
  }

  if (aiToggle) aiToggle.addEventListener('click', function () {
    aiWidget.classList.contains('is-open') ? closeWidget() : openWidget();
  });
  if (aiClose) aiClose.addEventListener('click', function (e) { e.stopPropagation(); closeWidget(); });

  // Auto-open on page load
  openWidget();

  // Nav sidebar link and pillar card open the widget
  if (navAiLink) {
    navAiLink.addEventListener('click', function (e) {
      e.preventDefault();
      openWidget();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
  document.querySelectorAll('.pillar-card').forEach(function (card) {
    if (card.getAttribute('href') === '#ai-assistant') {
      card.addEventListener('click', function (e) {
        e.preventDefault();
        openWidget();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  });

}());
</script>

<style>
  .hc-hero { background: linear-gradient(135deg, #0a1628 0%, #1a3a6b 100%); color: #fff; padding-block: clamp(56px, 6vw, 88px); position: relative; overflow: visible; }
  .hc-hero .eyebrow { color: #60a5fa; }
  h1 { font-size: clamp(30px, 4vw, 48px); font-weight: 800; margin: 0 0 14px; color: #fff; }
  .lede { font-size: clamp(15px, 1.4vw, 17px); color: #9aa9c3; max-width: 520px; margin: 0 0 28px; }

  .hc-search-wrap { position: relative; max-width: 580px; margin: 0 0 24px; }
  .hc-search-box { position: relative; display: flex; align-items: center; background: #fff; border-radius: 10px; border: 1.5px solid #d0d8ea; box-shadow: 0 2px 12px rgba(0,0,0,.14); }
  .hc-search-box:focus-within { border-color: #60a5fa; box-shadow: 0 0 0 3px rgba(96,165,250,.22); }
  .search-icon { position: absolute; left: 14px; color: #8896ad; pointer-events: none; }
  #hc-search { width: 100%; padding: 14px 52px 14px 44px; font-size: 15px; font-family: inherit; border: none; background: transparent; color: var(--text); border-radius: 10px; outline: none; }
  #hc-search::placeholder { color: #8896ad; }
  .search-kbd { position: absolute; right: 12px; font-size: 11px; color: #8896ad; background: #f1f4f9; border: 1px solid #d0d8ea; border-radius: 4px; padding: 2px 6px; pointer-events: none; font-family: inherit; }
  .hc-search-chips { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .chip-label { font-size: 12px; color: #9aa9c3; font-weight: 500; }
  .chip { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.18); border-radius: 20px; padding: 5px 12px; font-size: 12px; color: #c8d6ee; font-family: inherit; cursor: pointer; transition: background 140ms, color 140ms; }
  .chip:hover { background: rgba(255,255,255,.16); color: #fff; }
  .hc-search-results { display: none; position: absolute; top: calc(100% + 6px); left: 0; right: 0; background: #fff; border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 8px 28px rgba(11,21,38,.18); z-index: 200; overflow: hidden; }
  .hc-search-results.is-open { display: block; }
  .sr-item { display: flex; flex-direction: column; gap: 2px; padding: 11px 16px; text-decoration: none; color: var(--text); border-bottom: 1px solid var(--line); transition: background 100ms; }
  .sr-item:last-child { border-bottom: none; }
  .sr-item:hover { background: var(--blue-soft); }
  .sr-section { font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--blue); }
  .sr-title { font-size: 13.5px; font-weight: 500; }
  .sr-no-results { padding: 14px 16px; font-size: 14px; color: var(--text-2); margin: 0; }
