---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Search Results | Oryele Help Center"
  description="Search the Oryele Help Center documentation, FAQs, and guides."
>

  <section class="sr-hero">
    <div class="wrap">
      <a href="/support/" class="sr-back">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Help Center
      </a>
      <div class="sr-search-box">
        <svg class="sr-search-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
        <input id="sr-input" type="search" placeholder="Search documentation, FAQs, guides..." autocomplete="off" aria-label="Search help center" />
        <button id="sr-btn" class="sr-search-btn">Search</button>
      </div>
    </div>
  </section>

  <section class="sr-body">
    <div class="wrap">
      <div id="sr-meta" class="sr-meta"></div>
      <div id="sr-results" class="sr-results"></div>
      <div id="sr-empty" class="sr-empty" hidden>
        <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
        <p class="sr-empty-title">No results found</p>
        <p class="sr-empty-sub">Try different keywords or <a href="mailto:support@oryele.com">email our support team</a>.</p>
        <div class="sr-suggestions">
          <p>Popular topics:</p>
          <a href="/support/search/?q=digital+worker">Digital Workers</a>
          <a href="/support/search/?q=document+upload">Document Upload</a>
          <a href="/support/search/?q=MFA">MFA Setup</a>
          <a href="/support/search/?q=billing">Billing</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script is:inline>
(function () {

  var searchIndex = [
    { title: 'Setting up your account', section: 'Firm Setup', anchor: '/support/#firm-setup', preview: 'Log in at app.oryele.com, set your permanent password, enable MFA, and complete your firm profile including name, logo, time zone, and support email.', keywords: 'setup account login mfa password firm profile logo' },
    { title: 'Inviting your team and setting roles', section: 'Firm Setup', anchor: '/support/#firm-setup', preview: 'Invite team members via Settings then Team Members then Invite. Assign one of four roles: Administrator, Manager, Staff, or Read Only.', keywords: 'team invite roles administrator manager staff permissions' },
    { title: 'Connecting your email and calendar', section: 'Firm Setup', anchor: '/support/#firm-setup', preview: 'Connect Microsoft 365 or Google Workspace under Settings then Integrations. All outbound emails appear from your firm address.', keywords: 'email calendar microsoft google workspace integration outlook gmail' },
    { title: 'Adding a new client', section: 'Client Onboarding', anchor: '/support/#client-onboarding', preview: 'Go to Clients then Add Client. Enter the client legal name, email, phone, and reference number. Oryele creates the record and can trigger onboarding automatically.', keywords: 'add client new onboarding create record' },
    { title: 'Sending an engagement letter', section: 'Client Onboarding', anchor: '/support/#client-onboarding', preview: 'From the client profile, click Send Engagement Letter. Select a template, review, and send. The client signs electronically and the executed copy is stored automatically.', keywords: 'engagement letter send sign esign template' },
    { title: 'Tracking onboarding status', section: 'Client Onboarding', anchor: '/support/#client-onboarding', preview: 'Go to Clients then Onboarding to see statuses: Invitation Sent, Engagement Letter Pending, Documents Requested, Onboarding Complete.', keywords: 'onboarding status track progress timeline' },
    { title: 'Requesting documents from a client', section: 'Document Collection', anchor: '/support/#document-collection', preview: 'From a client profile, click Request Documents. Select from the checklist or type a custom name, set a due date, and send a secure upload link.', keywords: 'document upload documents request upload bank statements checklist W-2 1099' },
    { title: 'Monitoring outstanding requests', section: 'Document Collection', anchor: '/support/#document-collection', preview: 'Go to Documents then Pending Requests. Requests are sorted by due date with statuses: Sent, Viewed, Partially Uploaded, Complete.', keywords: 'document upload pending documents outstanding reminders due date' },
    { title: 'Accessing uploaded documents', section: 'Document Collection', anchor: '/support/#document-collection', preview: 'All uploads are in Clients then Client Name then Documents, organized by tax year and document type. Download individually or as a zip.', keywords: 'document upload download documents access uploaded files folder' },
    { title: 'Enabling SMS messaging', section: 'Communications', anchor: '/support/#communications', preview: 'Go to Settings then Communications then SMS and verify your business phone number. Oryele tracks opt-in consent status for every client automatically.', keywords: 'SMS consent SMS enable text messaging consent opt in phone' },
    { title: 'Sending a message to a client', section: 'Communications', anchor: '/support/#communications', preview: 'From a client profile, click Send Message. Choose Email, SMS, or both. Every message is logged in the client communication history.', keywords: 'send message email SMS client communicate' },
    { title: 'Setting up automated reminders', section: 'Communications', anchor: '/support/#communications', preview: 'Go to Workflows then Reminders. Create sequences triggered by document due dates, appointments, or engagement letter expiry.', keywords: 'reminders automated schedule trigger sequence' },
    { title: 'What is a workflow?', section: 'Workflows', anchor: '/support/#workflows', preview: 'A workflow is a sequence of steps Oryele executes automatically. Your team only acts when human judgment is needed.', keywords: 'workflow automation process steps background' },
    { title: 'Creating a workflow from a template', section: 'Workflows', anchor: '/support/#workflows', preview: 'Go to Workflows then Templates. Pre-built templates include tax return preparation, bookkeeping onboarding, and engagement renewal.', keywords: 'workflow template create tax bookkeeping activate' },
    { title: 'Monitoring active workflows', section: 'Workflows', anchor: '/support/#workflows', preview: 'Go to Workflows then Active. A progress indicator shows which step each client is on with full history available.', keywords: 'workflow active monitor progress status running' },
    { title: 'What is a digital worker?', section: 'Digital Workers', anchor: '/support/#digital-workers', preview: 'A digital worker is an AI-powered assistant that handles defined tasks around the clock and logs every action it takes.', keywords: 'digital worker AI intake document appointment' },
    { title: 'Activating a digital worker', section: 'Digital Workers', anchor: '/support/#digital-workers', preview: 'Go to Digital Workers then Activate. Select the worker type, configure its name and escalation rules, then click Activate.', keywords: 'digital worker activate configure escalation rules' },
    { title: 'Reviewing worker activity', section: 'Digital Workers', anchor: '/support/#digital-workers', preview: 'Go to Digital Workers then Activity Log. Every action is recorded with a timestamp. Filter by worker, client, date range, or action type.', keywords: 'digital worker activity log audit history CSV export' },
    { title: 'Resetting a password', section: 'Security', anchor: '/support/#security', preview: 'Go to app.oryele.com and click Forgot Password. A reset link arrives within 2 minutes and expires after 30 minutes.', keywords: 'password reset forgot login credentials' },
    { title: 'Setting up MFA', section: 'Security', anchor: '/support/#security', preview: 'Go to Settings then Security then MFA. Scan the QR code with Google Authenticator, Microsoft Authenticator, or Authy.', keywords: 'MFA multi factor authentication google authenticator authy QR' },
    { title: 'Removing a team member', section: 'Security', anchor: '/support/#security', preview: 'Go to Settings then Team Members, find the member, and click Deactivate. Access is revoked immediately.', keywords: 'remove deactivate team member access revoke user' },
    { title: 'Exporting audit logs', section: 'Security', anchor: '/support/#security', preview: 'Go to Settings then Audit Log. Filter and click Export for a CSV of every action. Logs retained for a minimum of 7 years.', keywords: 'audit log export CSV download 7 years' },
    { title: 'Viewing your current plan', section: 'Billing', anchor: '/support/#billing', preview: 'Go to Settings then Billing to see your current plan, next billing date, payment method, and downloadable invoice history.', keywords: 'billing plan subscription payment invoice' },
    { title: 'Upgrading or changing your plan', section: 'Billing', anchor: '/support/#billing', preview: 'Contact sales@oryele.com to discuss plan options. Changes take effect at the start of the next billing cycle.', keywords: 'upgrade plan change sales pricing' },
    { title: 'Getting technical support', section: 'Billing', anchor: '/support/#billing', preview: 'Email support@oryele.com with your issue, firm name, and screenshots. Response within 2 business hours for critical issues.', keywords: 'support contact help technical issue response' },
    { title: 'How to upload documents', section: 'Client Guide', anchor: '/support/#client-guide', preview: 'Click the secure link in your email. No account required. Select files next to each requested item and upload. Supported: PDF, JPG, PNG, Office formats.', keywords: 'upload documents client guide secure link PDF' },
    { title: 'How to sign an engagement letter', section: 'Client Guide', anchor: '/support/#client-guide', preview: 'Click the link in your email, read the document, click Sign, type your full name, and click Submit. A signed copy is emailed to you immediately.', keywords: 'sign engagement letter electronic signature client' },
    { title: 'How to opt out of SMS', section: 'Client Guide', anchor: '/support/#client-guide', preview: 'Reply STOP to any text message. You receive one final confirmation and no further texts. Reply START to opt back in.', keywords: 'SMS consent SMS opt out STOP text message client' },
    { title: 'How long does setup take?', section: 'FAQ', anchor: '/support/#faq', preview: 'Most firms are fully operational within one business day. Firm profile setup takes about 30 minutes, plus 1 to 2 hours for integrations and first workflow.', keywords: 'setup time onboarding how long quick start' },
    { title: 'Is client data encrypted?', section: 'FAQ', anchor: '/support/#faq', preview: 'Yes. All data is encrypted in transit (TLS 1.3) and at rest (AES-256) with unique per-file encryption keys.', keywords: 'encrypted security data TLS AES compliance' },
    { title: 'Does Oryele support legal hold?', section: 'FAQ', anchor: '/support/#faq', preview: 'Yes. Legal hold can be placed on individual client records or a defined set, exempting them from retention and deletion policies.', keywords: 'legal hold retention compliance records' },
    { title: 'How is Oryele priced?', section: 'FAQ', anchor: '/support/#faq', preview: 'Oryele is priced per firm based on active clients and modules. Visit the Pricing page or contact sales@oryele.com.', keywords: 'pricing cost plan how much billing' },
  ];

  function getQuery() {
    var params = new URLSearchParams(window.location.search);
    return (params.get('q') || '').trim();
  }

  function score(item, query) {
    var q = query.toLowerCase();
    var s = 0;
    if (item.title.toLowerCase().indexOf(q) > -1) s += 10;
    if (item.section.toLowerCase().indexOf(q) > -1) s += 5;
    if (item.keywords.toLowerCase().indexOf(q) > -1) s += 3;
    if (item.preview.toLowerCase().indexOf(q) > -1) s += 1;
    return s;
  }

  function highlight(text, query) {
    if (!query) return text;
    var re = new RegExp('(' + query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
    return text.replace(re, '<mark>$1</mark>');
  }

  function renderResults(query) {
    var input = document.getElementById('sr-input');
    var meta  = document.getElementById('sr-meta');
    var results = document.getElementById('sr-results');
    var empty = document.getElementById('sr-empty');

    if (input) input.value = query;

    if (!query) {
      meta.innerHTML = '';
      results.innerHTML = '';
      empty.hidden = true;
      return;
    }

    var hits = searchIndex
      .map(function (item) { return { item: item, score: score(item, query) }; })
      .filter(function (x) { return x.score > 0; })
      .sort(function (a, b) { return b.score - a.score; })
      .map(function (x) { return x.item; });

    if (hits.length === 0) {
      meta.innerHTML = '<p class="sr-query">Results for <strong>"' + query + '"</strong></p>';
      results.innerHTML = '';
      empty.hidden = false;
      return;
    }

    empty.hidden = true;
    meta.innerHTML = '<p class="sr-query"><strong>' + hits.length + '</strong> result' + (hits.length === 1 ? '' : 's') + ' for <strong>"' + query + '"</strong></p>';

    // Group by section
    var sections = {};
    hits.forEach(function (h) {
      if (!sections[h.section]) sections[h.section] = [];
      sections[h.section].push(h);
    });

    var html = '';
    Object.keys(sections).forEach(function (section) {
      html += '<div class="sr-group">';
      html += '<p class="sr-group-label">' + section + '</p>';
      sections[section].forEach(function (h) {
        html += '<a class="sr-card" href="' + h.anchor + '">';
        html += '<div class="sr-card-main">';
        html += '<p class="sr-card-title">' + highlight(h.title, query) + '</p>';
        html += '<p class="sr-card-preview">' + highlight(h.preview, query) + '</p>';
        html += '</div>';
        html += '<span class="sr-card-arrow" aria-hidden="true">&#8594;</span>';
        html += '</a>';
      });
      html += '</div>';
    });

    results.innerHTML = html;
  }

  // Initial render from URL
  var q = getQuery();
  renderResults(q);

  // Live search as you type
  var input = document.getElementById('sr-input');
  var btn   = document.getElementById('sr-btn');

  function doSearch() {
    var val = (input ? input.value : '').trim();
    if (!val) return;
    history.replaceState(null, '', '/support/search/?q=' + encodeURIComponent(val));
    renderResults(val);
  }

  if (input) {
    input.addEventListener('input', function () { renderResults(input.value.trim()); });
    input.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); doSearch(); } });
  }
  if (btn) { btn.addEventListener('click', doSearch); }

}());
</script>

<style>
  .sr-hero { background: var(--navy); padding-block: clamp(32px, 4vw, 52px); }
  .sr-back { display: inline-flex; align-items: center; gap: 7px; color: #9aa9c3; font-size: 13px; font-weight: 600; text-decoration: none; margin-bottom: 20px; transition: color 140ms; }
  .sr-back:hover { color: #fff; }
  .sr-search-box { display: flex; align-items: center; background: #fff; border-radius: 10px; border: 1.5px solid #d0d8ea; max-width: 680px; overflow: hidden; box-shadow: 0 2px 14px rgba(0,0,0,.14); }
  .sr-search-box:focus-within { border-color: #60a5fa; box-shadow: 0 0 0 3px rgba(96,165,250,.22); }
  .sr-search-icon { position: absolute; left: 14px; color: #8896ad; pointer-events: none; flex-shrink: 0; }
  .sr-search-box { position: relative; }
  #sr-input { flex: 1; padding: 15px 16px 15px 44px; font-size: 16px; font-family: inherit; border: none; background: transparent; color: var(--text); outline: none; }
  #sr-input::placeholder { color: #8896ad; }
  .sr-search-btn { padding: 0 22px; height: 52px; background: var(--blue); color: #fff; border: none; font-size: 14px; font-weight: 700; font-family: inherit; cursor: pointer; flex-shrink: 0; transition: background 140ms; white-space: nowrap; }
  .sr-search-btn:hover { background: var(--blue-dark); }

  .sr-body { padding-block: clamp(36px, 4vw, 56px); }
  .sr-meta { margin-bottom: 24px; }
  .sr-query { font-size: 15px; color: var(--text-2); margin: 0; }
  .sr-query strong { color: var(--text); }

  .sr-results { display: grid; gap: 32px; }
  .sr-group { display: grid; gap: 10px; }
  .sr-group-label { font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--blue); margin: 0 0 4px; padding-bottom: 8px; border-bottom: 2px solid var(--blue-soft); }
  .sr-card { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 20px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; color: var(--text); box-shadow: var(--shadow-card); transition: border-color 140ms, box-shadow 140ms, transform 120ms; }
  .sr-card:hover { border-color: var(--blue); box-shadow: 0 4px 18px rgba(18,63,158,.1); transform: translateX(3px); }
  .sr-card-main { flex: 1; min-width: 0; }
  .sr-card-title { font-size: 15px; font-weight: 700; color: var(--text); margin: 0 0 5px; }
  .sr-card-preview { font-size: 13.5px; color: var(--text-2); line-height: 1.6; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sr-card-arrow { font-size: 18px; color: var(--blue); flex-shrink: 0; opacity: 0; transition: opacity 140ms; }
  .sr-card:hover .sr-card-arrow { opacity: 1; }
  mark { background: #fef9c3; color: var(--text); border-radius: 2px; padding: 0 1px; }

  .sr-empty { text-align: center; padding: 64px 24px; color: var(--text-2); }
  .sr-empty svg { stroke: #c8d0de; margin: 0 auto 20px; display: block; }
  .sr-empty-title { font-size: 20px; font-weight: 700; color: var(--text); margin: 0 0 8px; }
  .sr-empty-sub { font-size: 15px; margin: 0 0 28px; }
  .sr-empty-sub a { color: var(--blue); font-weight: 600; }
  .sr-suggestions { display: flex; align-items: center; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .sr-suggestions p { font-size: 13px; font-weight: 600; margin: 0; }
  .sr-suggestions a { padding: 7px 14px; background: var(--blue-soft); border: 1px solid #c5d4f5; border-radius: 20px; font-size: 13px; font-weight: 600; color: var(--blue); text-decoration: none; transition: background 130ms; }
  .sr-suggestions a:hover { background: #dde8fb; }
</style>
