---
import BaseLayout from "../../../layouts/BaseLayout.astro";
const papers = [
  {
    title: "The Future of Accounting",
    subtitle: "How AI-Powered Workflow Automation is Transforming CPA Firms",
    href: "/assets/oryele-white-paper-accounting.pdf",
    industry: "Accounting",
  },
  {
    title: "The Future of Insurance",
    subtitle: "How AI-Powered Workflow Automation is Transforming Insurance Carriers and Agencies",
    href: "/assets/oryele-white-paper-insurance.pdf",
    industry: "Insurance",
  },
  {
    title: "The Future of Law",
    subtitle: "How AI-Powered Workflow Automation is Transforming Law Firms and Legal Departments",
    href: "/assets/oryele-white-paper-legal.pdf",
    industry: "Legal",
  },
];
---
<BaseLayout title="Oryele White Papers | AI Automation Research for Professional Services" description="Download Oryele white papers on AI-powered workflow automation for accounting, insurance, and legal firms.">
  <section class="wp-hero">
    <div class="wrap">
      <p class="eyebrow">Resources</p>
      <h1>White Papers</h1>
      <p class="lede">In-depth research on how AI-powered workflow automation is reshaping professional services. Download free.</p>
    </div>
  </section>
  <section class="wp-body">
    <div class="wrap">
      <div class="wp-grid">
        {papers.map((p) => (
          <a class="wp-card" href={p.href} target="_blank" rel="noopener">
            <span class="wp-industry">{p.industry}</span>
            <p class="wp-title">{p.title}</p>
            <p class="wp-subtitle">{p.subtitle}</p>
            <span class="wp-dl">Download PDF →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .wp-hero { background: var(--paper-2); border-bottom: 1px solid var(--line); padding-block: clamp(48px,5vw,80px); }
  h1 { font-size: clamp(30px,4vw,48px); font-weight: 800; margin: 0 0 16px; }
  .lede { font-size: 17px; color: #33415a; max-width: 520px; margin: 0; }
  .wp-body { padding-block: clamp(48px,5vw,80px); }
  .wp-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
  .wp-card { display: flex; flex-direction: column; gap: 12px; border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; background: #fff; box-shadow: var(--shadow-card); text-decoration: none; color: var(--text); transition: border-color 140ms, box-shadow 140ms; }
  .wp-card:hover { border-color: var(--blue); box-shadow: 0 4px 18px rgba(18,63,158,0.12); }
  .wp-industry { font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue); }
  .wp-title { font-size: 18px; font-weight: 800; margin: 0; color: var(--navy); }
  .wp-subtitle { font-size: 14px; color: #33415a; line-height: 1.55; margin: 0; flex: 1; }
  .wp-dl { font-size: 13px; font-weight: 700; color: var(--blue); margin-top: auto; }
  @media (max-width: 860px) { .wp-grid { grid-template-columns: 1fr; } }
</style>
