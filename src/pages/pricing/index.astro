---
import BaseLayout from "../../layouts/BaseLayout.astro";

const plans = [
  {
    tier: "FOUNDATION",
    name: "Core platform",
    price: "$399",
    period: "/mo",
    desc: "For small teams starting with governed execution.",
    features: [
      "Core platform access",
      "Essential workflows",
      "Client portal",
      "Email support",
      "25,000 OCR pages per month",
    ],
    cta: "Get Started",
    href: "/contact/",
    highlight: false,
    badge: null,
  },
  {
    tier: "PROFESSIONAL",
    name: "Growth platform",
    price: "$999",
    period: "/mo",
    desc: "For firms expanding digital workers and integrations.",
    features: [
      "Everything in Foundation",
      "Advanced workflows",
      "Digital worker expansion",
      "Priority support",
      "250,000 OCR pages per month",
    ],
    cta: "Get Started",
    href: "/contact/",
    highlight: true,
    badge: "Preferred",
  },
  {
    tier: "ENTERPRISE",
    name: "Custom",
    price: "Call sales",
    period: null,
    desc: "For organizations requiring scale, security, governance, and implementation support.",
    features: [
      "Custom users and storage",
      "Custom OCR volume",
      "SSO and private deployment options",
      "SLA and dedicated success",
      "Advanced governance",
    ],
    cta: "Talk to Sales",
    href: "/contact/",
    highlight: false,
    badge: null,
  },
];

const compare = [
  { capability: "Client Portal", foundation: "Included", professional: "Included", enterprise: "Included" },
  { capability: "Digital Workers", foundation: "Starter", professional: "Expanded", enterprise: "Custom" },
  { capability: "OCR Pages", foundation: "25,000/month", professional: "250,000/month", enterprise: "Custom" },
  { capability: "Communications", foundation: "Email", professional: "Email, SMS, Voice, Calendar", enterprise: "Custom communications" },
  { capability: "Governance", foundation: "Standard", professional: "Advanced", enterprise: "Enterprise" },
  { capability: "Support", foundation: "Email", professional: "Priority", enterprise: "SLA and dedicated success" },
];
---
<BaseLayout
  title="Pricing | Oryele AI Workflow Automation Platform"
  description="Pricing that scales with capability. Start with the core platform, then expand digital workers and workflows as your operations scale."
>
  <section class="price-hero">
    <div class="wrap">
      <p class="eyebrow">Pricing</p>
      <h1>Pricing that scales with capability.</h1>
      <p class="lede">Start with the core platform, then expand digital workers and workflows as your operations scale.</p>
    </div>
  </section>

  <section class="price-plans">
    <div class="wrap plans-grid">
      {plans.map((p) => (
        <div class={`plan-card ${p.highlight ? 'plan-highlight' : ''}`}>
          {p.badge && <div class="plan-badge">{p.badge}</div>}
          <p class="plan-tier">{p.tier}</p>
          <p class="plan-name">{p.name}</p>
          <div class="plan-price-row">
            <span class="plan-price">{p.price}</span>
            {p.period && <span class="plan-period">{p.period}</span>}
          </div>
          <p class="plan-desc">{p.desc}</p>
          <a class={`btn ${p.highlight ? 'btn-blue' : 'btn-outline-blue'} plan-cta`} href={p.href}>{p.cta} →</a>
          <div class="plan-divider"></div>
          <ul class="plan-features">
            {p.features.map((f) => (
              <li>
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
                  <path d="M3 8l3.5 3.5 6.5-7" stroke="var(--blue)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {f}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="price-compare">
    <div class="wrap">
      <p class="eyebrow">Compare Plans</p>
      <h2>Clear tiers. Expand when ready.</h2>
      <div class="compare-table-wrap">
        <table class="compare-table">
          <colgroup><col class="cap-col"/><col/><col/><col/></colgroup>
          <thead>
            <tr>
              <th class="col-capability">Capability</th>
              <th class="col-plan">Foundation</th>
              <th class="col-plan col-preferred">Professional</th>
              <th class="col-plan">Enterprise</th>
            </tr>
          </thead>
          <tbody>
            {compare.map((row) => (
              <tr>
                <td class="cell-capability">{row.capability}</td>
                <td class="cell-value">{row.foundation}</td>
                <td class="cell-value cell-preferred">{row.professional}</td>
                <td class="cell-value">{row.enterprise}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="price-cta">
    <div class="wrap">
      <h2>Ready to Get Started?</h2>
      <p>Our team will walk you through the right plan for your firm and answer every question before you commit to anything.</p>
      <div class="cta-btns">
        <a class="btn btn-blue" href="/contact/">Request a Demo <span class="arrow">→</span></a>
        <a class="btn btn-outline-inv" href="mailto:sales@oryele.com">Email Sales</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .price-hero {
    background: var(--paper-2);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(56px, 6vw, 88px);
    text-align: center;
  }
  h1 { font-size: clamp(30px, 3.8vw, 50px); font-weight: 800; margin: 0 0 16px; }
  .lede { font-size: clamp(16px, 1.5vw, 19px); color: #33415a; max-width: 560px; margin: 0 auto; }

  /* Plans */
  .price-plans { padding-block: clamp(56px, 6vw, 80px); }
  .plans-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: start;
  }
  .plan-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 32px;
    background: #fff;
    box-shadow: var(--shadow-card);
    position: relative;
  }
  .plan-highlight {
    border-color: var(--blue);
    box-shadow: 0 8px 32px rgba(18,63,158,0.16);
  }
  .plan-badge {
    position: absolute;
    top: -14px; left: 50%;
    transform: translateX(-50%);
    background: var(--blue); color: #fff;
    font-size: 11px; font-weight: 800;
    letter-spacing: 0.1em; text-transform: uppercase;
    padding: 4px 16px; border-radius: 20px;
    white-space: nowrap;
  }
  .plan-tier {
    font-size: 11px; font-weight: 800;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--blue); margin: 0 0 6px;
  }
  .plan-name { font-size: 20px; font-weight: 800; color: var(--navy); margin: 0 0 16px; }
  .plan-price-row { display: flex; align-items: baseline; gap: 4px; margin-bottom: 12px; }
  .plan-price { font-size: 36px; font-weight: 800; color: var(--navy); }
  .plan-period { font-size: 16px; color: var(--text-2); }
  .plan-desc { font-size: 14px; color: #33415a; line-height: 1.6; margin: 0 0 24px; }
  .plan-cta { width: 100%; justify-content: center; }
  .plan-divider { border: none; border-top: 1px solid var(--line); margin: 24px 0; }
  .plan-features { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .plan-features li { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; color: #33415a; line-height: 1.5; }
  .plan-features svg { flex-shrink: 0; margin-top: 2px; }

  /* Compare table */
  .price-compare { padding-block: clamp(56px, 6vw, 80px); background: var(--paper-2); border-top: 1px solid var(--line); }
  h2 { font-size: clamp(24px, 3vw, 36px); font-weight: 800; margin: 0 0 36px; }
  .compare-table-wrap { overflow-x: auto; }
  .compare-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .compare-table col { width: 26%; }
  .compare-table .cap-col { width: 22%; }
  .compare-table thead th {
    padding: 14px 20px;
    text-align: center;
    font-size: 12px; font-weight: 800;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--text-2);
    border-bottom: 2px solid var(--line);
    background: #fff;
  }
  .col-plan { text-align: center; }
  .col-capability { text-align: left !important; }
  .col-preferred { color: var(--blue) !important; }
  .compare-table tbody tr { border-bottom: 1px solid var(--line); }
  .compare-table tbody tr:last-child { border-bottom: none; }
  .compare-table tbody tr:hover { background: var(--blue-soft); }
  .cell-capability {
    padding: 16px 20px;
    font-size: 14.5px; font-weight: 600; color: var(--text);
    background: #fff;
    white-space: nowrap;
  }
  .cell-value {
    padding: 16px 20px;
    font-size: 14px; color: #33415a;
    text-align: center;
    background: #fff;
  }
  .cell-preferred {
    background: #f0f4ff;
    font-weight: 600;
    color: var(--navy) !important;
  }

  /* CTA */
  .price-cta {
    background: var(--navy); color: #fff;
    text-align: center;
    padding-block: clamp(56px, 6vw, 80px);
  }
  .price-cta h2 { font-size: clamp(26px, 3vw, 40px); color: #fff; margin-bottom: 14px; }
  .price-cta p { font-size: 17px; color: var(--text-inv-2); max-width: 500px; margin: 0 auto 28px; }
  .cta-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 860px) {
    .plans-grid { grid-template-columns: 1fr; max-width: 440px; margin: 0 auto; }
  }
</style>
