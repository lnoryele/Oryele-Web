<script>
  // ── Search ────────────────────────────────────────────────────────
  const searchIndex = [
    { title: 'Setting up your Oryele account', section: 'Firm Setup', anchor: '#firm-setup', keywords: 'setup account login mfa password firm profile logo' },
    { title: 'Inviting your team and setting roles', section: 'Firm Setup', anchor: '#firm-setup', keywords: 'team invite roles administrator manager staff permissions' },
    { title: 'Connecting your email and calendar', section: 'Firm Setup', anchor: '#firm-setup', keywords: 'email calendar microsoft 365 google workspace integration connect outlook gmail' },
    { title: 'Adding a new client', section: 'Client Onboarding', anchor: '#client-onboarding', keywords: 'add client new onboarding create record' },
    { title: 'Sending an engagement letter', section: 'Client Onboarding', anchor: '#client-onboarding', keywords: 'engagement letter send sign esign template' },
    { title: 'Tracking onboarding status', section: 'Client Onboarding', anchor: '#client-onboarding', keywords: 'onboarding status track progress timeline' },
    { title: 'Requesting documents from a client', section: 'Document Collection', anchor: '#document-collection', keywords: 'documents request upload W-2 1099 bank statements checklist' },
    { title: 'Monitoring outstanding document requests', section: 'Document Collection', anchor: '#document-collection', keywords: 'pending documents outstanding reminders due date' },
    { title: 'Accessing uploaded documents', section: 'Document Collection', anchor: '#document-collection', keywords: 'download documents access uploaded files folder' },
    { title: 'Enabling SMS messaging', section: 'Communications', anchor: '#communications', keywords: 'SMS enable text messaging consent opt-in phone' },
    { title: 'Sending a message to a client', section: 'Communications', anchor: '#communications', keywords: 'send message email SMS client communicate' },
    { title: 'Setting up automated reminders', section: 'Communications', anchor: '#communications', keywords: 'reminders automated schedule trigger sequence' },
    { title: 'What is a workflow?', section: 'Workflows', anchor: '#workflows', keywords: 'workflow what is automation process steps background' },
    { title: 'Creating a workflow from a template', section: 'Workflows', anchor: '#workflows', keywords: 'workflow template create tax bookkeeping activate' },
    { title: 'Monitoring active workflows', section: 'Workflows', anchor: '#workflows', keywords: 'workflow active monitor progress status running' },
    { title: 'What is a digital worker?', section: 'Digital Workers', anchor: '#digital-workers', keywords: 'digital worker AI what is intake document appointment' },
    { title: 'Activating a digital worker', section: 'Digital Workers', anchor: '#digital-workers', keywords: 'digital worker activate configure escalation rules' },
    { title: 'Reviewing worker activity', section: 'Digital Workers', anchor: '#digital-workers', keywords: 'digital worker activity log audit history CSV export' },
    { title: 'Resetting a password', section: 'Security', anchor: '#security', keywords: 'password reset forgot login credentials' },
    { title: 'Setting up MFA', section: 'Security', anchor: '#security', keywords: 'MFA multi-factor authentication google authenticator authy QR code' },
    { title: 'Removing a team member access', section: 'Security', anchor: '#security', keywords: 'remove deactivate team member access revoke user' },
    { title: 'Exporting audit logs', section: 'Security', anchor: '#security', keywords: 'audit log export CSV download 7 years' },
    { title: 'Viewing your current plan', section: 'Billing', anchor: '#billing', keywords: 'billing plan subscription payment invoice' },
    { title: 'Upgrading or changing your plan', section: 'Billing', anchor: '#billing', keywords: 'upgrade plan change sales pricing' },
    { title: 'Getting technical support', section: 'Billing', anchor: '#billing', keywords: 'support contact help technical issue 2 hours response' },
    { title: 'How to upload documents', section: 'Client Guide', anchor: '#client-guide', keywords: 'upload documents client guide secure link PDF' },
    { title: 'How to sign an engagement letter', section: 'Client Guide', anchor: '#client-guide', keywords: 'sign engagement letter electronic signature client' },
    { title: 'How to opt out of SMS', section: 'Client Guide', anchor: '#client-guide', keywords: 'SMS opt out STOP text message client' },
  ];

  const searchInput = document.getElementById('hc-search');
  const searchResults = document.getElementById('hc-search-results');
  const chips = document.querySelectorAll('.chip');

  function runSearch(q) {
    const query = q.toLowerCase().trim();
    if (!query) { searchResults.hidden = true; return; }
    const hits = searchIndex.filter(item =>
      item.title.toLowerCase().includes(query) ||
      item.keywords.toLowerCase().includes(query) ||
      item.section.toLowerCase().includes(query)
    ).slice(0, 6);
    if (hits.length === 0) {
      searchResults.innerHTML = '<p class="sr-no-results">No results for <strong>' + q + '</strong>. Try different keywords or <a href="mailto:support@oryele.com">email support</a>.</p>';
    } else {
      searchResults.innerHTML = hits.map(h =>
        '<a class="sr-item" href="' + h.anchor + '">' +
          '<span class="sr-section">' + h.section + '</span>' +
          '<span class="sr-title">' + h.title + '</span>' +
        '</a>'
      ).join('');
    }
    searchResults.hidden = false;
  }

  if (searchInput) {
    searchInput.addEventListener('input', e => runSearch(e.target.value));
    searchInput.addEventListener('keydown', e => { if (e.key === 'Escape') { searchResults.hidden = true; } });
    document.addEventListener('click', e => { if (!e.target.closest('.hc-search-wrap')) searchResults.hidden = true; });
    // ⌘K / Ctrl+K shortcut
    document.addEventListener('keydown', e => { if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); searchInput.focus(); } });
  }

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      searchInput.value = chip.dataset.query;
      runSearch(chip.dataset.query);
      searchInput.focus();
    });
  });

  // ── FAQ active-link highlighting ─────────────────────────────────
  document.querySelectorAll('.hc-nav a').forEach(link => {
    link.addEventListener('click', () => {
      document.querySelectorAll('.hc-nav a').forEach(l => l.classList.remove('is-active'));
      link.classList.add('is-active');
    });
  });

  // ── Star rating ──────────────────────────────────────────────────
  const stars = document.querySelectorAll('.star');
  let selectedRating = 0;
  stars.forEach(star => {
    star.addEventListener('mouseenter', () => {
      const val = +star.dataset.value;
      stars.forEach(s => s.classList.toggle('hovered', +s.dataset.value <= val));
    });
    star.addEventListener('mouseleave', () => {
      stars.forEach(s => s.classList.remove('hovered'));
    });
    star.addEventListener('click', () => {
      selectedRating = +star.dataset.value;
      stars.forEach(s => {
        const v = +s.dataset.value;
        s.classList.toggle('selected', v <= selectedRating);
      });
    });
  });

  // ── Feedback type toggle ─────────────────────────────────────────
  document.querySelectorAll('.ftype-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.ftype-btn').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
    });
  });

  // ── Feedback submit ──────────────────────────────────────────────
  const fbSubmit = document.getElementById('fb-submit');
  const fbSuccess = document.getElementById('fb-success');
  if (fbSubmit) {
    fbSubmit.addEventListener('click', () => {
      const msg = document.getElementById('fb-message').value.trim();
      if (!msg) { document.getElementById('fb-message').focus(); return; }
      fbSubmit.disabled = true;
      fbSubmit.textContent = 'Sending...';
      setTimeout(() => {
        fbSubmit.closest('.fb-actions').style.display = 'none';
        document.getElementById('fb-message').closest('.fb-field').style.display = 'none';
        fbSuccess.hidden = false;
      }, 800);
    });
  }
</script>

