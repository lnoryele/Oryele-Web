---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const topics=[
['Getting Started','Set up your workspace, invite your team, and secure your account.',['Set up your workspace','Invite team members','Sign in and enable MFA']],
['Clients & Onboarding','Create client records and manage onboarding from one place.',['Add a client','Start onboarding','Track progress']],
['Documents','Request, receive, and organize client documents.',['Request documents','Review outstanding requests','Find uploaded files']],
['Workflows','Build repeatable processes with tasks, decisions, and approvals.',['Create a workflow','Assign tasks and approvals','Monitor activity']],
['Digital Workers','Assign and supervise AI-assisted work while keeping people in control.',['What is a Digital Worker?','Assign work','Review activity and exceptions']],
['Communications','Manage messages, templates, reminders, and communication history.',['Send a client message','Create templates','Manage reminders']],
['Security & Access','Manage authentication, permissions, and account recovery.',['Roles and permissions','Reset a password','Multi-factor authentication']],
['Account & Billing','Manage organization details, plan information, and support.',['Update account details','Review plan information','Contact support']]
];
const faqs=[
['How do I get access to Oryele?','Your organization administrator creates or invites users. Use the invitation email to complete setup and sign in.'],
['Where do I see work that needs attention?','Review the dashboard, assigned tasks, approvals, and active workflows in your workspace.'],
['How do I request documents?','Open the client record, choose Request Documents, select the required items, add a due date, and send.'],
['Can I review workflow history?','Yes. Open workflow activity to review completed steps, timestamps, ownership, and exceptions.'],
['What if I cannot sign in?','Use password reset, confirm your email address, and verify your MFA method. Contact support if access still fails.']
];
---
<BaseLayout title="Help Center | Oryele" description="Guides, answers, and product support for the Oryele platform.">
<main>
<section class="hero"><div class="wrap hero-inner"><p class="eyebrow">Oryele Help Center</p><h1>Answers that help you move forward.</h1><p>Find practical guidance for setting up Oryele, managing clients, building workflows, working with Digital Workers, and administering your account.</p><div class="search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4.5-4.5"/></svg><input id="help-search" type="search" placeholder="Search guides, topics, and common questions"/><span>⌘ K</span></div><div id="search-results" class="results"></div><div class="chips"><button data-query="workflow">Workflows</button><button data-query="documents">Documents</button><button data-query="digital worker">Digital Workers</button><button data-query="password">Password</button></div></div></section>
<section class="popular"><div class="wrap"><div class="heading"><div><p class="eyebrow blue">Start here</p><h2>Popular help topics</h2></div><a href="mailto:support@oryele.com">Contact support →</a></div><div class="popular-grid">{['Set up your workspace','Invite team members','Request client documents','Create a workflow','Use Digital Workers','Reset a password'].map((item,i)=><a href="#guides"><span>0{i+1}</span><strong>{item}</strong><b>→</b></a>)}</div></div></section>
<section class="guides" id="guides"><div class="wrap layout"><aside><p>Browse by topic</p>{topics.map((t,i)=><a href={`#topic-${i}`}>{t[0]}</a>)}<div class="support"><strong>Still need help?</strong><span>Our support team is ready to assist.</span><a href="mailto:support@oryele.com">Email support</a></div></aside><div><div class="heading"><div><p class="eyebrow blue">Documentation</p><h2>Browse all guides</h2></div><p>Clear guidance organized around the work you do in Oryele.</p></div><div class="topic-grid">{topics.map((t,i)=><article id={`topic-${i}`} data-search={`${t[0]} ${t[1]} ${t[2].join(' ')}`}><div class="icon">{String(i+1).padStart(2,'0')}</div><h3>{t[0]}</h3><p>{t[1]}</p><div>{t[2].map((a)=><details><summary>{a}<span>+</span></summary><p>Open the relevant area in your Oryele workspace and follow the on-screen steps. For additional help, contact support@oryele.com.</p></details>)}</div></article>)}</div></div></div></section>
<section class="faq"><div class="wrap faq-layout"><div><p class="eyebrow blue">Common questions</p><h2>Quick answers.</h2><p>Find answers to the questions customers ask most often.</p></div><div>{faqs.map(f=><details><summary>{f[0]}<span>+</span></summary><p>{f[1]}</p></details>)}</div></div></section>
<section class="cta"><div class="wrap"><div><p class="eyebrow">Support</p><h2>Need help from a person?</h2><p>Send our team a clear description of the issue, your organization name, and any relevant screenshots.</p></div><a class="btn btn-white" href="mailto:support@oryele.com">Email support →</a></div></section>
</main>
</BaseLayout>
<script is:inline>
(function(){var input=document.getElementById('help-search'),results=document.getElementById('search-results'),cards=[].slice.call(document.querySelectorAll('[data-search]'));function run(q){q=(q||'').trim().toLowerCase();results.innerHTML='';cards.forEach(function(c){c.style.display=!q||c.dataset.search.toLowerCase().indexOf(q)>-1?'':'none'});if(q){var n=cards.filter(function(c){return c.style.display!== 'none'}).length;results.textContent=n?n+' topic'+(n===1?'':'s')+' found':'No matching topics. Email support@oryele.com for help.'}}if(input){input.addEventListener('input',function(){run(input.value)});document.addEventListener('keydown',function(e){if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();input.focus()}})}document.querySelectorAll('[data-query]').forEach(function(b){b.addEventListener('click',function(){input.value=b.dataset.query;run(input.value);input.focus()})})}());
</script>
<style>
.hero{position:relative;overflow:hidden;background:linear-gradient(135deg,#07152c,#0d3473);color:#fff;padding:92px 0 84px}.hero:after{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:38px 38px}.hero-inner{position:relative;z-index:1;max-width:920px;text-align:center}.eyebrow{margin:0 0 14px;color:#93c5fd;font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase}.eyebrow.blue{color:var(--blue)}.hero h1,.heading h2,.faq h2,.cta h2{margin:0;letter-spacing:-.035em}.hero h1{font-size:clamp(42px,6vw,70px)}.hero-inner>p:nth-of-type(2){max-width:720px;margin:20px auto 32px;color:#c6d3e6;font-size:18px;line-height:1.7}.search{display:flex;align-items:center;gap:12px;background:#fff;border-radius:14px;padding:6px 12px;box-shadow:0 20px 60px rgba(0,0,0,.3)}.search svg{width:21px;fill:none;stroke:#526075;stroke-width:1.8}.search input{flex:1;border:0;outline:0;padding:15px 4px;font:inherit;font-size:15px}.search span{color:#7a8798;font-size:12px}.chips{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-top:18px}.chips button{border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.08);color:#fff;border-radius:999px;padding:8px 12px;cursor:pointer}.results{min-height:20px;margin-top:10px;color:#d7e4f7;font-size:13px}.popular,.guides,.faq{padding:76px 0}.heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:28px}.heading h2,.faq h2,.cta h2{font-size:clamp(32px,4vw,48px)}.heading>a{color:var(--blue);font-weight:700;text-decoration:none}.heading>p{max-width:430px;color:#5d6b80;line-height:1.65}.popular-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.popular-grid a{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;border:1px solid #e0e7f0;border-radius:14px;padding:20px;text-decoration:none;color:var(--text);background:#fff}.popular-grid span{font-size:11px;font-weight:800;color:var(--blue)}.popular-grid b{color:var(--blue)}.guides{background:#f6f8fb}.layout{display:grid;grid-template-columns:220px 1fr;gap:54px}.layout aside{position:sticky;top:100px;align-self:start;display:grid;gap:4px}.layout aside>p{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.12em}.layout aside>a{padding:8px 0;color:#526075;text-decoration:none}.support{display:grid;gap:8px;margin-top:22px;padding:18px;border-radius:14px;background:#07152c;color:#fff}.support span{font-size:12px;color:#b7c5d8}.support a{color:#93c5fd;text-decoration:none;font-weight:700}.topic-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.topic-grid article{scroll-margin-top:110px;background:#fff;border:1px solid #e1e7ef;border-radius:16px;padding:24px}.icon{width:40px;height:40px;border-radius:10px;background:#eaf2ff;color:var(--blue);display:grid;place-items:center;font-size:12px;font-weight:800}.topic-grid h3{margin:16px 0 8px;font-size:20px}.topic-grid article>p{margin:0 0 18px;color:#607086;line-height:1.6}.topic-grid details,.faq details{border-top:1px solid #e7ebf0}.topic-grid summary,.faq summary{display:flex;justify-content:space-between;gap:14px;padding:13px 0;cursor:pointer;font-weight:700;list-style:none}.topic-grid details p,.faq details p{margin:0 0 14px;color:#617086;line-height:1.65;font-size:14px}.faq-layout{display:grid;grid-template-columns:.75fr 1.25fr;gap:72px}.faq-layout>div:first-child>p:last-child{color:#617086;line-height:1.7}.cta{background:linear-gradient(135deg,#0a2d68,#1556b8);color:#fff;padding:58px 0}.cta>.wrap{display:flex;justify-content:space-between;align-items:center;gap:36px}.cta p:last-child{max-width:650px;color:#cfddf2;line-height:1.65}.btn-white{background:#fff;color:#0a3476}@media(max-width:900px){.popular-grid{grid-template-columns:1fr 1fr}.layout,.faq-layout{grid-template-columns:1fr}.layout aside{position:static;grid-template-columns:1fr 1fr}.support{grid-column:1/-1}.topic-grid{grid-template-columns:1fr}}@media(max-width:620px){.popular-grid,.layout aside{grid-template-columns:1fr}.heading,.cta>.wrap{align-items:flex-start;flex-direction:column}.hero{padding:70px 0}.search span{display:none}}
</style>