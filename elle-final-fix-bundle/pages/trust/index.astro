---
import BaseLayout from '../../layouts/BaseLayout.astro';
const items=[['Security','Enterprise controls, encryption, access management, and secure platform operations.','/platform/governance/'],['Privacy','How Oryele handles and protects personal information.','/privacy/'],['SMS Consent','Consent, messaging notices, opt-out controls, and auditability.','/sms-consent/'],['Terms & Conditions','Terms governing access to and use of Oryele services.','/terms/'],['Cookie Policy','How cookies and similar technologies are used.','/cookie-policy/'],['Support','Get product, account, or service assistance.','/support/']];
---
<BaseLayout title="Oryele Trust Center" description="Security, privacy, legal, messaging, and support information for Oryele."><section class="hero"><div class="wrap"><p class="eyebrow">Oryele Trust Center</p><h1>Trust is part of the platform.</h1><p>Find Oryele security, privacy, legal, messaging, and support information in one place.</p></div></section><section class="cards"><div class="wrap grid">{items.map(i=><a href={i[2]}><h2>{i[0]}</h2><p>{i[1]}</p><span>Learn more →</span></a>)}</div></section></BaseLayout>
<style>.hero{padding-block:90px;background:linear-gradient(135deg,#071528,#12366f);color:#fff}.hero h1{font-size:clamp(44px,6vw,72px);margin:0 0 18px}.hero p:not(.eyebrow){font-size:19px;color:#cad6e8}.cards{padding-block:90px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.grid a{display:block;text-decoration:none;color:inherit;border:1px solid var(--line);border-radius:18px;padding:28px;background:#fff;box-shadow:var(--shadow-card);transition:transform .2s ease,box-shadow .2s ease}.grid a:hover{transform:translateY(-4px);box-shadow:0 22px 45px rgba(7,23,45,.13)}.grid h2{margin:0 0 10px;font-size:22px}.grid p{color:#4d5b72;line-height:1.6;min-height:78px}.grid span{color:#174db0;font-weight:700}@media(max-width:850px){.grid{grid-template-columns:1fr}}</style>
